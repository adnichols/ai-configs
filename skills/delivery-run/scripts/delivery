def pi_runtime_marker() -> bool:
    return any(
        os.environ.get(name)
        for name in ("PI_CODING_AGENT_DIR", "PI_SESSION_ID", "PI_MODEL", "PI_PROVIDER")
    )


def resolve_runtime_profile(
    ledger: dict[str, Any] | None,
    *,
    runtime: str | None = None,
    workflow_profile: str | None = None,
) -> tuple[str, str, bool]:
    """Resolve immutable runtime ownership; bool marks a legacy Pi backfill."""
    if runtime and runtime not in RUNTIME_PROFILES:
        die("runtime must be omp or pi")
    if workflow_profile and workflow_profile not in set(RUNTIME_PROFILES.values()):
        die("workflow profile must be omp-lite or pi-full")
    if runtime and workflow_profile and RUNTIME_PROFILES[runtime] != workflow_profile:
        die(f"runtime {runtime} requires workflow profile {RUNTIME_PROFILES[runtime]}")

    stored_runtime = ledger.get("runtime") if ledger else None
    stored_profile = ledger.get("workflowProfile") if ledger else None
    if stored_runtime or stored_profile:
        if not isinstance(stored_runtime, str) or not isinstance(stored_profile, str):
            die("ledger runtime/profile fields are incomplete; start a new run")
        if RUNTIME_PROFILES.get(stored_runtime) != stored_profile:
            die("ledger runtime/profile fields are invalid; start a new run")
        if runtime and runtime != stored_runtime:
            die(f"runtime is immutable ({stored_runtime}); start a new run for {runtime}")
        if workflow_profile and workflow_profile != stored_profile:
            die(f"workflow profile is immutable ({stored_profile}); start a new run")
        return stored_runtime, stored_profile, False

    if ledger is not None:
        if runtime == "omp" or workflow_profile == "omp-lite":
            die("legacy delivery ledgers are Pi runs; start a new run with --runtime omp")
        return "pi", "pi-full", True

    selected = runtime
    if selected is None:
        if os.environ.get("OMPCODE") == "1":
            selected = "omp"
        elif pi_runtime_marker():
            selected = "pi"
        else:
            die("cannot determine runtime; rerun with --runtime omp|pi")
    profile = workflow_profile or RUNTIME_PROFILES[selected]
    if profile != RUNTIME_PROFILES[selected]:
        die(f"runtime {selected} requires workflow profile {RUNTIME_PROFILES[selected]}")
    return selected, profile, False


def initialize_runtime_profile(
    ledger: dict[str, Any],
    *,
    runtime: str | None = None,
    workflow_profile: str | None = None,
) -> None:
    resolved_runtime, resolved_profile, _ = resolve_runtime_profile(
        None, runtime=runtime, workflow_profile=workflow_profile
    )
    ledger["runtime"] = resolved_runtime
    ledger["workflowProfile"] = resolved_profile


def backfill_legacy_runtime_profile(
    path: Path, ledger: dict[str, Any], root: Path, *, runtime: str | None = None,
    workflow_profile: str | None = None,
) -> None:
    resolved_runtime, resolved_profile, legacy = resolve_runtime_profile(
        ledger, runtime=runtime, workflow_profile=workflow_profile
    )
    if not legacy:
        return
    ledger["runtime"] = resolved_runtime
    ledger["workflowProfile"] = resolved_profile
    append_history(ledger, "runtime_backfill", "legacy ledger recognized as pi-full")
    refresh_git_fields(ledger, root)
    write_json(path, ledger)


def utc_now() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def die(msg: str, code: int = 2) -> None:
    print(f"delivery: {msg}", file=sys.stderr)
    raise SystemExit(code)


def load_json(path: Path) -> dict[str, Any]:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        die(f"ledger not found: {path}")
    except json.JSONDecodeError as exc:
        die(f"invalid JSON in {path}: {exc}")


def sync_operator_attention(ledger: dict[str, Any]) -> None:
    """Best-effort reconciliation of human-wait attention from resulting ledger state."""
    if os.environ.get("DELIVERY_SKIP_HERDR", "").strip().lower() in {"1", "true", "yes"}:
        return
    pane_id = resolve_herdr_targets(ledger).get("paneId")
    helper = shutil.which("herdr-operator-attention")
    if not pane_id or not helper:
        return

    stage = str(ledger.get("stage") or "INTAKE")
    command = [helper, "clear", "--pane", str(pane_id)]
    if stage == "BLOCKED":
        blockers = ledger.get("blockers") if isinstance(ledger.get("blockers"), list) else []
        latest = blockers[-1] if blockers else None
        message = latest.get("text") if isinstance(latest, dict) else None
        command = [
            helper, "set", "--pane", str(pane_id), "--kind", "blocker",
            "--message", str(message or "Delivery blocked"),
        ]
    # EXECUTION_READY automatically launches the reviewed implementation profile.
    # Operator attention is reserved for real blockers, not a routine approval pause.

    try:
        subprocess.run(
            command,
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=5,
        )
    except (OSError, subprocess.SubprocessError):
        pass


def write_json(path: Path, data: dict[str, Any], *, force_replace: bool = False) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    is_ledger = path.name == LEDGER_REL.name and path.parent.name == LEDGER_REL.parent.name
    root = path.parent.parent.resolve() if is_ledger else None
    ledger_fd: int | None = None
    if root is not None:
        lock_path = root / LEDGER_LOCK_REL
        ledger_fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
        timeout = float(os.environ.get("DELIVERY_LEDGER_LOCK_TIMEOUT_SECONDS", "10"))
        deadline = time.monotonic() + timeout
        while True:
            try:
                fcntl.flock(ledger_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    os.lseek(ledger_fd, 0, os.SEEK_SET)
                    holder = os.read(ledger_fd, 4096).decode("utf-8", "replace").strip() or "unavailable"
                    os.close(ledger_fd)
                    die(f"timed out after {timeout:g}s waiting for delivery ledger lock; holder={holder}")
                time.sleep(0.05)
        supplied_revision = int(data.get("ledgerRevision") or 0)
        metadata = {"pid": os.getpid(), "command": " ".join(sys.argv[1:]) or "delivery", "acquiredAt": utc_now(), "expectedRevision": supplied_revision}
        os.ftruncate(ledger_fd, 0); os.lseek(ledger_fd, 0, os.SEEK_SET)
        os.write(ledger_fd, (json.dumps(metadata, sort_keys=True) + "\n").encode())
        os.fsync(ledger_fd)
    try:
        if is_ledger:
            supplied_revision = int(data.get("ledgerRevision") or 0)
            current_revision = 0
            if path.exists():
                current = json.loads(path.read_text(encoding="utf-8"))
                current_revision = int(current.get("ledgerRevision") or 0)
                if not force_replace and current_revision != supplied_revision:
                    die("stale ledger mutation rejected; reload delivery state and retry " f"(current revision {current_revision}, supplied {supplied_revision})")
            data["ledgerRevision"] = current_revision + 1 if force_replace else supplied_revision + 1
        tmp = path.with_suffix(path.suffix + f".tmp.{os.getpid()}.{uuid.uuid4().hex}")
        try:
            fd = os.open(tmp, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
            with os.fdopen(fd, "wb") as handle:
                payload = (json.dumps(data, indent=2, sort_keys=False) + "\n").encode()
                handle.write(payload)
                handle.flush()
                os.fsync(handle.fileno())
            os.replace(tmp, path)
        except BaseException:
            try:
                tmp.unlink()
            except FileNotFoundError:
                pass
            raise
        directory_fd = os.open(path.parent, os.O_RDONLY)
        try: os.fsync(directory_fd)
        finally: os.close(directory_fd)
    finally:
        if ledger_fd is not None:
            fcntl.flock(ledger_fd, fcntl.LOCK_UN); os.close(ledger_fd)
    if is_ledger:
        sync_operator_attention(data)


def git_capture(cwd: Path, *args: str) -> str | None:
    import subprocess

    try:
        proc = subprocess.run(
            ["git", *args],
            cwd=str(cwd),
            check=False,
            capture_output=True,
            text=True,
        )
    except OSError:
        return None
    if proc.returncode != 0:
        return None
    return proc.stdout.strip() or None


def detect_repo_root(start: Path | None = None) -> Path:
    start = (start or Path.cwd()).resolve()
    captured = git_capture(start, "rev-parse", "--show-toplevel")
    if captured:
        return Path(captured)
    return start


def default_id(root: Path, issue: str | None, slug: str | None) -> str:
    repo = root.name
    branch = git_capture(root, "branch", "--show-current") or ""
    label = issue or slug or branch or root.name
    label = label.strip().replace(" ", "-")
    return f"{repo}/{label}"


def empty_evidence() -> dict[str, Any]:
    out: dict[str, Any] = {}
    for key in RECOMMENDED_EVIDENCE:
        out[key] = {
            "status": "pending",
            "artifact": None,
            "summary": None,
            "updatedAt": None,
        }
    out["planTech"].update(
        {
            "reviewer": None,
            "model": None,
            "reasoningLevel": None,
            "verdict": None,
            "implementationProfile": None,
            "implementationRationale": None,
            "planSha256": None,
        }
    )
    out["planSync"].update(
        {
            "operatorPlanSha256": None,
            "agenticPlanSha256": None,
        }
    )
    return out


def new_ledger(
    *,
    root: Path,
    ledger_id: str,
    issue: str | None,
    plan: str | None,
    stage: str,
    doct_url: str | None,
    pr_url: str | None,
    slug: str | None = None,
) -> dict[str, Any]:
    now = utc_now()
    branch = git_capture(root, "branch", "--show-current")
    head = git_capture(root, "rev-parse", "--short", "HEAD")
    return {
        "schemaVersion": SCHEMA_VERSION,
        "id": ledger_id,
        "issue": issue,
        "slug": slug,
        "plan": plan,
        "agenticPlan": None,
        "doctUrl": doct_url,
        "prUrl": pr_url,
        "worktree": str(root),
        "branch": branch,
        "head": head,
        "stage": stage,
        "createdAt": now,
        "updatedAt": now,
        "notes": [],
        "history": [
            {
                "at": now,
                "type": "init",
                "stage": stage,
                "detail": "ledger created",
            }
        ],
        "evidence": empty_evidence(),
        "receipts": [],
        "implementationApproval": {
            "status": "pending",
            "source": None,
            "planSha256": None,
            "profile": None,
            "model": None,
            "reasoningLevel": None,
            "selectionSource": None,
            "overrideReason": None,
            "summary": None,
            "approvedAt": None,
            "invalidatedAt": None,
            "reason": None,
        },
        "implementationProfile": {
            "status": "pending",
            "profile": None,
            "provider": None,
            "model": None,
            "modelRef": None,
            "reasoningLevel": None,
            "selectionSource": None,
            "overrideReason": None,
            "planSha256": None,
            "agentName": None,
            "paneId": None,
            "sourcePaneId": None,
            "launchedAt": None,
            "promptedAt": None,
            "launchAttemptId": None,
            "reason": None,
        },
        "workspaceOwner": {
            "role": None,
            "tabId": None,
            "paneId": None,
            "agentName": None,
            "workspaceId": None,
            "claimedAt": None,
        },
        "tabsToRetire": [],
        "customerImpact": {
            "promised": [],
            "observed": [],
            "gaps": [],
            "summary": None,
        },
        "completionEval": {
            "status": "pending",
            "gaps": [],
            "summary": None,
        },
        "blockers": [],
        "advisories": [],
        "labels": {
            "herdr": None,
        },
        "doctrine": "guidance-not-gates",
    }


def find_ledger_path(start: Path | None = None, explicit: str | None = None) -> Path:
    if explicit:
        path = Path(explicit).expanduser().resolve()
        if path.is_dir():
            path = path / LEDGER_REL
        return path
    root = detect_repo_root(start)
    return root / LEDGER_REL


PREWALK_ARMED_DIRNAME = "prewalk-armed"


def prewalk_armed_dir() -> Path:
    override = (os.environ.get("PREWALK_ARMED_DIR") or "").strip()
    if override:
        return Path(override).expanduser()
    return Path.home() / ".pi" / PREWALK_ARMED_DIRNAME


def prewalk_armed_marker_path(cwd: Path) -> Path:
    digest = hashlib.sha256(str(cwd.resolve()).encode("utf-8")).hexdigest()
    return prewalk_armed_dir() / digest


def live_prewalk_arm(cwd: Path) -> dict[str, Any] | None:
    path = prewalk_armed_marker_path(cwd)
    if not path.is_file():
        return None
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    if not isinstance(data, dict):
        return None
    pid = data.get("pid")
    if isinstance(pid, int) and pid > 0:
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            try:
                path.unlink()
            except OSError:
                pass
            return None
        except PermissionError:
            pass
    return data


def refuse_if_prewalk_armed(cwd: Path) -> None:
    if live_prewalk_arm(cwd):
        die(
            "prewalk is armed in this worktree; /prewalk off before arming delivery. "
            "Delivery and prewalk are mutually exclusive."
        )


def append_history(ledger: dict[str, Any], event_type: str, detail: str, **extra: Any) -> None:
    entry = {"at": utc_now(), "type": event_type, "stage": ledger.get("stage"), "detail": detail}
    entry.update(extra)
    history = ledger.setdefault("history", [])
    history.append(entry)
    # Keep history bounded but useful.
    if len(history) > 200:
        del history[:-200]
    ledger["updatedAt"] = utc_now()


def refresh_git_fields(ledger: dict[str, Any], root: Path) -> None:
    branch = git_capture(root, "branch", "--show-current")
    head = git_capture(root, "rev-parse", "--short", "HEAD")
    if branch:
        ledger["branch"] = branch
    if head:
        ledger["head"] = head
    ledger["worktree"] = str(root)


def resolve_worktree_file(raw: str | None, root: Path) -> Path | None:
    """Return a readable file path inside the worktree, or None when unavailable."""
    if not isinstance(raw, str) or not raw.strip():
        return None
    candidate = Path(raw).expanduser()
    if not candidate.is_absolute():
        candidate = root / candidate
    try:
        candidate = candidate.resolve()
        candidate.relative_to(root.resolve())
    except ValueError:
        return None
    if not candidate.is_file():
        return None
    return candidate


def resolve_plan_path(ledger: dict[str, Any], root: Path) -> Path | None:
    """Return the recorded operator plan path when it is a readable file inside the worktree."""
    raw_plan = ledger.get("plan")
    if not isinstance(raw_plan, str):
        return None
    return resolve_worktree_file(raw_plan, root)


def derive_agentic_companion_relpath(operator_plan: str) -> str:
    """Return the derived agentic companion path beside an operator plan.

    Convention: thoughts/plans/<slug>.html → thoughts/plans/<slug>.agentic.html
    (Markdoc: <slug>.markdoc → <slug>.agentic.markdoc). Already-agentic paths
    are returned unchanged.
    """
    path = Path(operator_plan)
    suffixes = path.suffixes
    if len(suffixes) >= 2 and suffixes[-2].lower() == ".agentic":
        return str(path)
    if not path.suffix:
        return str(path.with_name(f"{path.name}.agentic.html"))
    return str(path.with_name(f"{path.stem}.agentic{path.suffix}"))


def expected_agentic_plan_relpath(ledger: dict[str, Any]) -> str | None:
    """Return the recorded or derived agentic companion relative/path string."""
    raw = ledger.get("agenticPlan")
    if isinstance(raw, str) and raw.strip():
        return raw.strip()
    operator = ledger.get("plan")
    if isinstance(operator, str) and operator.strip():
        return derive_agentic_companion_relpath(operator.strip())
    return None


def resolve_agentic_plan_path(ledger: dict[str, Any], root: Path) -> Path | None:
    """Return the agentic companion when it is a readable file inside the worktree."""
    return resolve_worktree_file(expected_agentic_plan_relpath(ledger), root)


def plan_sha256(ledger: dict[str, Any], root: Path) -> str | None:
    """Return the recorded operator plan's current content hash, or None when unavailable."""
    candidate = resolve_plan_path(ledger, root)
    if candidate is None:
        return None
    return hashlib.sha256(candidate.read_bytes()).hexdigest()


def agentic_plan_sha256(ledger: dict[str, Any], root: Path) -> str | None:
    """Return the agentic companion's current content hash, or None when unavailable."""
    candidate = resolve_agentic_plan_path(ledger, root)
    if candidate is None:
        return None
    return hashlib.sha256(candidate.read_bytes()).hexdigest()


def operator_and_agentic_plan_sha256_pair(
    ledger: dict[str, Any], root: Path
) -> tuple[str | None, str | None]:
    """Return (operatorPlanSha256, agenticPlanSha256) for dual-plan fingerprinting."""
    return plan_sha256(ledger, root), agentic_plan_sha256(ledger, root)


def agentic_companion_problem(ledger: dict[str, Any], root: Path) -> str | None:
    """Return a problem string when an operator plan is set but its companion is missing."""
    operator = resolve_plan_path(ledger, root)
    if operator is None:
        return None
    expected = expected_agentic_plan_relpath(ledger)
    if expected is None:
        return None
    if resolve_agentic_plan_path(ledger, root) is not None:
        return None
    return (
        f"agentic companion missing at {expected} "
        "(derive beside the operator plan as <slug>.agentic<html|markdoc>, "
        "or set with delivery set --agentic-plan <path>)"
    )


_UNTITLED_PLAN_TITLES = {
    "",
    "untitled",
    "untitled plan",
    "untitled document",
    "plan",
    "new plan",
}


def _first_markdown_heading(text: str) -> str | None:
    """Return the first ATX H1 only (a line starting with exactly one #)."""
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith("#") and not stripped.startswith("##"):
            heading = stripped[1:].strip()
            if heading:
                return heading
    return None


def _frontmatter_title(text: str) -> str | None:
    if not text.startswith("---"):
        return None
    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        return None
    for line in lines[1:]:
        stripped = line.strip()
        if stripped == "---":
            break
        if stripped.startswith("#") or ":" not in stripped:
            continue
        key, value = stripped.split(":", 1)
        if key.strip() != "title":
            continue
        title = value.strip().strip("'\"")
        return title or None
    return None


def _normalize_plan_title(title: str | None) -> str | None:
    if title is None:
        return None
    cleaned = re.sub(r"\s+", " ", title).strip()
    return cleaned or None


def _html_document_title(text: str) -> str | None:
    match = re.search(r"<title[^>]*>(.*?)</title>", text, flags=re.IGNORECASE | re.DOTALL)
    if not match:
        return None
    return _normalize_plan_title(match.group(1))


def _html_h1_title(text: str) -> str | None:
    match = re.search(r"<h1[^>]*>(.*?)</h1>", text, flags=re.IGNORECASE | re.DOTALL)
    if not match:
        return None
    inner = re.sub(r"<[^>]+>", "", match.group(1))
    return _normalize_plan_title(inner)


def _html_title(text: str) -> str | None:
    """Aligned HTML title when <title> and first <h1> agree; else prefer <title>."""
    doc_title = _html_document_title(text)
    h1_title = _html_h1_title(text)
    if doc_title and h1_title and titles_match(doc_title, h1_title):
        return doc_title
    return doc_title or h1_title


def is_untitled_plan_title(title: str | None) -> bool:
    cleaned = _normalize_plan_title(title)
    if cleaned is None:
        return True
    return cleaned.casefold() in _UNTITLED_PLAN_TITLES


def titles_match(left: str | None, right: str | None) -> bool:
    """Exact identity after whitespace normalization (case-sensitive).

    Doct document title, register --title, and in-content titles must be the
    same human string. Collapse runs of whitespace so incidental wrapping does
    not create false drift, but do not treat case variants as equal.
    """
    a = _normalize_plan_title(left)
    b = _normalize_plan_title(right)
    if a is None or b is None:
        return False
    return a == b


def analyze_plan_title(path: Path, text: str | None = None) -> dict[str, Any]:
    """Inspect plan source titles that must stay aligned with Doct document metadata.

    Canonical human title sources by format:
    - Markdoc: YAML frontmatter ``title:`` (chrome); optional first ``#`` heading must match
    - HTML: both ``<title>`` and top-level ``<h1>`` must exist and match each other
    - Markdown: frontmatter title or first heading

    The same canonical string must be passed as ``doct-agent plans register --title``
    so the Doct document/tree title matches in-content plan chrome.
    """
    source = text if text is not None else path.read_text(encoding="utf-8", errors="replace")
    suffix = path.suffix.lower()
    frontmatter = _frontmatter_title(source)
    heading = _first_markdown_heading(source)
    html_title = _html_document_title(source)
    html_h1 = _html_h1_title(source)
    parts = {
        "frontmatter": frontmatter,
        "heading": heading,
        "htmlTitle": html_title,
        "htmlH1": html_h1,
    }

    if suffix == ".markdoc":
        canonical = frontmatter
        problem = None
        if is_untitled_plan_title(canonical):
            problem = (
                f"Markdoc plan {path.as_posix()} is missing a non-empty YAML frontmatter "
                "title: field. Doct renders browser-review chrome as 'Untitled Plan' without it; "
                "add `title: <Plan Title>` under the opening --- frontmatter and pass the same "
                "value as `doct-agent plans register --title '<Plan Title>'` so the Doct document "
                "title matches the plan contents."
            )
        elif heading and not titles_match(canonical, heading):
            problem = (
                f"Markdoc plan {path.as_posix()} frontmatter title {canonical!r} does not match "
                f"first heading {heading!r}. Align frontmatter title, leading # heading, and "
                f"`doct-agent plans register --title` to the same string so Doct document title "
                "and plan contents stay identical."
            )
            canonical = None
        return {"canonical": canonical, "parts": parts, "problem": problem}

    if suffix in {".html", ".htm"}:
        problem = None
        if is_untitled_plan_title(html_title) and is_untitled_plan_title(html_h1):
            problem = (
                f"HTML plan {path.as_posix()} is missing a usable <title> and <h1>. Set both to "
                "the same human title and pass that exact string as "
                "`doct-agent plans register --title '<Plan Title>'` so the Doct document title "
                "matches the plan contents."
            )
            canonical = None
        elif is_untitled_plan_title(html_title):
            problem = (
                f"HTML plan {path.as_posix()} is missing a usable <title> tag. Set <title> to "
                f"match the visible <h1> ({html_h1!r}) and pass the same string as "
                "`doct-agent plans register --title`."
            )
            canonical = None
        elif is_untitled_plan_title(html_h1):
            problem = (
                f"HTML plan {path.as_posix()} is missing a usable top-level <h1>. Set <h1> to "
                f"match <title> ({html_title!r}) and pass the same string as "
                "`doct-agent plans register --title`."
            )
            canonical = None
        elif not titles_match(html_title, html_h1):
            problem = (
                f"HTML plan {path.as_posix()} has mismatched titles: <title>={html_title!r} vs "
                f"<h1>={html_h1!r}. Doct document title comes from register --title while plan "
                "chrome shows the in-content heading — set <title>, <h1>, and "
                "`doct-agent plans register --title` to one identical string."
            )
            canonical = None
        else:
            canonical = html_title
        return {"canonical": canonical, "parts": parts, "problem": problem}

    if suffix in {".md", ".markdown"}:
        canonical = frontmatter or heading
        problem = None
        if is_untitled_plan_title(canonical):
            problem = (
                f"plan {path.as_posix()} has no usable title. Set frontmatter title or a leading "
                "# heading and pass the same string as register --title."
            )
            canonical = None
        elif frontmatter and heading and not titles_match(frontmatter, heading):
            problem = (
                f"plan {path.as_posix()} frontmatter title {frontmatter!r} does not match first "
                f"heading {heading!r}. Align both with register --title."
            )
            canonical = None
        return {"canonical": canonical, "parts": parts, "problem": problem}

    canonical = frontmatter or heading or html_title or html_h1
    problem = None
    if is_untitled_plan_title(canonical):
        problem = (
            f"plan {path.as_posix()} has no usable title (found {canonical!r}). Set a real "
            "content title and pass the same value as `doct-agent plans register --title`."
        )
        canonical = None
    return {"canonical": canonical, "parts": parts, "problem": problem}


def extract_plan_title(path: Path, text: str | None = None) -> str | None:
    """Canonical plan title when source titles are present and aligned."""
    value = analyze_plan_title(path, text).get("canonical")
    return value if isinstance(value, str) else None


def plan_title_problem(ledger: dict[str, Any], root: Path) -> str | None:
    """Explain when the recorded plan would publish untitled or with mismatched titles."""
    candidate = resolve_plan_path(ledger, root)
    if candidate is None:
        return None
    try:
        text = candidate.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return f"recorded plan is unreadable: {candidate}"
    analysis = analyze_plan_title(candidate, text)
    problem = analysis.get("problem")
    if isinstance(problem, str) and problem.strip():
        return problem
    title = analysis.get("canonical")
    if is_untitled_plan_title(title if isinstance(title, str) else None):
        return (
            f"plan {candidate.as_posix()} has no usable title "
            f"(found {title!r}). Align content title(s) and always pass "
            "`doct-agent plans register --title '<Plan Title>'` so the Doct document title "
            "matches the plan contents."
        )
    # Optional: compare an explicitly recorded Doct document title (never auto-copied
    # from local content — that would make drift checks tautological).
    labels = ledger.get("labels") if isinstance(ledger.get("labels"), dict) else {}
    doct_title = ledger.get("doctTitle") or labels.get("doctTitle")
    source = ledger.get("doctTitleSource") or labels.get("doctTitleSource")
    if (
        isinstance(doct_title, str)
        and doct_title.strip()
        and source == "doct"
        and isinstance(title, str)
        and not titles_match(doct_title, title)
    ):
        return (
            f"Doct document title {doct_title!r} does not match plan content title "
            f"{title!r} in {candidate.as_posix()}. Keep one canonical string: edit source "
            "title(s), pass the same value as `doct-agent plans register --title`, then repair "
            "metadata with `doct-agent documents update-metadata --id <id> --title '<Plan Title>'` "
            "(and rename if the tree label must move). `plans update` syncs source body only and "
            "does not accept --title."
        )
    return None


def dual_plan_mode(ledger: dict[str, Any]) -> bool:
    """True when this ledger opted into operator+agentic dual-plan sync."""
    raw = ledger.get("agenticPlan")
    return isinstance(raw, str) and bool(raw.strip())


def plan_sync_problem(ledger: dict[str, Any], root: Path) -> str | None:
    """Explain why dual-plan sync blocks EXECUTION_READY when agenticPlan is set.

    Legacy single-plan ledgers (no agenticPlan) are unaffected.
    """
    if not dual_plan_mode(ledger):
        return None
    companion = agentic_companion_problem(ledger, root)
    if companion:
        return companion
    evidence = ledger.get("evidence") or {}
    sync = evidence.get("planSync") or {}
    if sync.get("status") != "pass":
        return (
            "dual-plan mode requires planSync=pass binding current operator and agentic "
            "fingerprints (delivery record planSync --status pass --summary '...')"
        )
    operator_hash, agentic_hash = operator_and_agentic_plan_sha256_pair(ledger, root)
    if operator_hash is None:
        return "the recorded operator plan is missing, outside this worktree, or unreadable"
    if agentic_hash is None:
        return "the recorded agentic companion is missing, outside this worktree, or unreadable"
    if sync.get("operatorPlanSha256") != operator_hash:
        return "the operator plan changed after the recorded planSync pass"
    if sync.get("agenticPlanSha256") != agentic_hash:
        return "the agentic companion changed after the recorded planSync pass"
    return None


def reset_plan_sync(ledger: dict[str, Any], reason: str) -> None:
    sync = ledger.setdefault("evidence", {}).setdefault(
        "planSync",
        {
            "status": "pending",
            "artifact": None,
            "summary": None,
            "updatedAt": None,
            "operatorPlanSha256": None,
            "agenticPlanSha256": None,
        },
    )
    sync.update(
        {
            "status": "pending",
            "operatorPlanSha256": None,
            "agenticPlanSha256": None,
            "updatedAt": utc_now(),
            "summary": reason,
        }
    )


def plan_readiness_request_problem(ledger: dict[str, Any], root: Path) -> str | None:
    """Explain why readiness review cannot begin for the current plan revision."""
    evidence = ledger.get("evidence") or {}
    request = evidence.get("planReadinessRequest") or {}
    if request.get("status") != "pass":
        return (
            "no explicit execution-ready review request is recorded "
            "(record planReadinessRequest=pass only after the operator asks or uses Doct's action)"
        )
    current_hash = plan_sha256(ledger, root)
    if current_hash is None:
        return "the recorded plan is missing, outside this worktree, or unreadable"
    if request.get("planSha256") != current_hash:
        return "the plan changed after the recorded execution-ready review request"
    return None


def reset_plan_readiness_request(ledger: dict[str, Any], reason: str) -> None:
    request = ledger.setdefault("evidence", {}).setdefault(
        "planReadinessRequest",
        {"status": "pending", "artifact": None, "summary": None, "updatedAt": None},
    )
    request.update({"status": "pending", "planSha256": None, "updatedAt": utc_now()})
    request["summary"] = reason


def canonical_implementation_profile(profile_name: str) -> str:
    return IMPLEMENTATION_PROFILE_ALIASES.get(profile_name, profile_name)


def is_known_implementation_profile(profile_name: object) -> bool:
    return isinstance(profile_name, str) and canonical_implementation_profile(profile_name) in IMPLEMENTATION_PROFILES


def implementation_profile_spec(profile_name: str) -> dict[str, str]:
    profile_name = canonical_implementation_profile(profile_name)
    spec = IMPLEMENTATION_PROFILES.get(profile_name)
    if spec is None:
        die(
            f"unknown implementation profile {profile_name!r}; choose from: "
            + ", ".join(sorted(IMPLEMENTATION_PROFILES))
        )
    provider = str(spec["provider"])
    model = str(spec["model"])
    return {
        "profile": profile_name,
        "provider": provider,
        "model": model,
        "modelRef": f"{provider}/{model}",
        "reasoningLevel": str(spec["reasoningLevel"]),
        "label": str(spec["label"]),
    }


def selected_implementation_profile(ledger: dict[str, Any]) -> dict[str, str]:
    review = (ledger.get("evidence") or {}).get("planTech") or {}
    profile_name = review.get("implementationProfile")
    if not is_known_implementation_profile(profile_name):
        # New or incomplete readiness records default to Luna xhigh. Existing explicit
        # Sol-medium records remain readable through the legacy profile above.
        profile_name = LEGACY_IMPLEMENTATION_PROFILE
    return implementation_profile_spec(str(profile_name))


def runtime_profile(model_ref: str, reasoning_level: str, *, profile: str = "manual") -> dict[str, str]:
    if "/" not in model_ref:
        die("implementation model must use provider/model form")
    provider, model = model_ref.split("/", 1)
    if not provider.strip() or not model.strip():
        die("implementation model must use provider/model form")
    if is_known_implementation_profile(profile):
        profile = canonical_implementation_profile(profile)
    return {
        "profile": profile,
        "provider": provider.strip(),
        "model": model.strip(),
        "modelRef": f"{provider.strip()}/{model.strip()}",
        "reasoningLevel": reasoning_level.strip(),
        "label": f"{model_ref} at {reasoning_level} reasoning",
    }


def hydrate_protocol_active(ledger: dict[str, Any]) -> bool:
    proto = ledger.get("hydrateProtocol") or {}
    return dual_plan_mode(ledger) and proto.get("status") == "active"


def ensure_hydrate_protocol(ledger: dict[str, Any], *, executor: dict[str, str]) -> None:
    """Authorize the Luna hydrate → executor pair for dual-plan ledgers."""
    if not dual_plan_mode(ledger):
        return
    hydrate = implementation_profile_spec(HYDRATE_PROFILE_NAME)
    proto = ledger.setdefault("hydrateProtocol", {})
    phase = str(proto.get("phase") or "authorized")
    if phase not in HYDRATE_EARLY_PHASES | HYDRATE_EXECUTOR_PHASES:
        phase = "authorized"
    proto.update(
        {
            "status": "active",
            "phase": phase,
            "version": HYDRATE_PROTOCOL_VERSION,
            "hydrateProfile": hydrate["profile"],
            "hydrateProvider": hydrate["provider"],
            "hydrateModel": hydrate["model"],
            "hydrateModelRef": hydrate["modelRef"],
            "hydrateReasoningLevel": hydrate["reasoningLevel"],
            "executorProfile": executor["profile"],
            "executorProvider": executor["provider"],
            "executorModel": executor["model"],
            "executorModelRef": executor["modelRef"],
            "executorReasoningLevel": executor["reasoningLevel"],
        }
    )


def set_hydrate_protocol_phase(ledger: dict[str, Any], phase: str, *, detail: str | None = None) -> None:
    proto = ledger.setdefault("hydrateProtocol", {})
    if proto.get("status") != "active":
        die("hydrate protocol is not active on this ledger")
    if phase not in HYDRATE_EARLY_PHASES | HYDRATE_EXECUTOR_PHASES:
        die(f"unknown hydrate protocol phase {phase!r}")
    proto["phase"] = phase
    proto["updatedAt"] = utc_now()
    if detail:
        proto["detail"] = detail
    append_history(ledger, "hydrate_protocol", f"phase={phase}" + (f" ({detail})" if detail else ""))


def approved_implementation_profile(ledger: dict[str, Any]) -> dict[str, str]:
    """Return the live-required runtime: hydrate early, executor after transition."""
    proto = ledger.get("hydrateProtocol") or {}
    if hydrate_protocol_active(ledger):
        phase = str(proto.get("phase") or "authorized")
        if phase in HYDRATE_EXECUTOR_PHASES:
            return runtime_profile(
                str(proto["executorModelRef"]),
                str(proto["executorReasoningLevel"]),
                profile=str(proto.get("executorProfile") or "manual"),
            )
        return implementation_profile_spec(HYDRATE_PROFILE_NAME)
    approval = ledger.get("implementationApproval") or {}
    model_ref = approval.get("model")
    reasoning = approval.get("reasoningLevel")
    planner_selected = selected_implementation_profile(ledger)
    if approval.get("status") == "approved" and isinstance(model_ref, str) and isinstance(reasoning, str):
        profile_name = approval.get("profile")
        if not isinstance(profile_name, str) or not profile_name:
            profile_name = (
                planner_selected["profile"]
                if model_ref == planner_selected["modelRef"]
                and reasoning == planner_selected["reasoningLevel"]
                else "manual"
            )
        return runtime_profile(model_ref, reasoning, profile=profile_name)
    return planner_selected


def reset_plan_technical_review(ledger: dict[str, Any], reason: str) -> None:
    review = ledger.setdefault("evidence", {}).setdefault("planTech", {})
    review.update(
        {
            "status": "pending",
            "artifact": None,
            "summary": reason,
            "updatedAt": utc_now(),
            "reviewer": None,
            "model": None,
            "reasoningLevel": None,
            "verdict": None,
            "implementationProfile": None,
            "implementationRationale": None,
            "planSha256": None,
        }
    )


def plan_technical_review_problem(ledger: dict[str, Any], root: Path) -> str | None:
    review = (ledger.get("evidence") or {}).get("planTech") or {}
    if review.get("status") != "pass":
        return "no current independent Sol medium planner review is recorded"
    if review.get("reviewer") != PLAN_REVIEW_AGENT:
        return f"plan review must come from the {PLAN_REVIEW_AGENT} subagent"
    if review.get("model") != PLAN_REVIEW_MODEL:
        return f"Sol medium planner review requires model {PLAN_REVIEW_MODEL}"
    if review.get("reasoningLevel") != PLAN_REVIEW_REASONING:
        return f"Sol medium planner review requires reasoning level {PLAN_REVIEW_REASONING}"
    if review.get("verdict") != "PLAN_EXECUTION_READY":
        return "Sol medium planner review has not returned PLAN_EXECUTION_READY"
    profile_name = review.get("implementationProfile")
    if profile_name is not None and not is_known_implementation_profile(profile_name):
        return "Sol medium planner review selected an unknown implementation profile"
    if profile_name is not None and not str(review.get("implementationRationale") or "").strip():
        return "Sol medium planner review did not explain its implementation profile selection"
    current_hash = plan_sha256(ledger, root)
    if current_hash is None:
        return "the recorded plan is missing, outside this worktree, or unreadable"
    if review.get("planSha256") != current_hash:
        return "the Sol medium planner review is stale for the current plan"
    artifact = review.get("artifact")
    if not isinstance(artifact, str) or not artifact.strip():
        return "the Sol medium planner review artifact is missing"
    candidate = Path(artifact).expanduser()
    if not candidate.is_absolute():
        candidate = root / candidate
    candidate = candidate.resolve()
    try:
        candidate.relative_to(root.resolve())
    except ValueError:
        return "the Sol medium planner review artifact is outside the worktree"
    if not candidate.is_file():
        return "the Sol medium planner review artifact is missing"
    return None


def implementation_approval_problem(ledger: dict[str, Any], root: Path) -> str | None:
    """Explain why implementation cannot begin for this ledger, if applicable."""
    approval = ledger.get("implementationApproval") or {}
    if approval.get("status") != "approved":
        return "no current implementation authorization is recorded"
    current_hash = plan_sha256(ledger, root)
    if current_hash is None:
        return "the recorded plan is missing, outside this worktree, or unreadable"
    if approval.get("planSha256") != current_hash:
        return "the plan changed after the recorded implementation authorization"
    planner_selected = selected_implementation_profile(ledger)
    selection_source = str(approval.get("selectionSource") or "planner")
    selected = approved_implementation_profile(ledger)
    approval_profile = approval.get("profile")
    if selection_source == "planner" and (
        approval_profile is not None
        and (not is_known_implementation_profile(approval_profile)
             or canonical_implementation_profile(str(approval_profile)) != planner_selected["profile"])
    ):
        return f"implementation authorization does not match selected profile {planner_selected['profile']}"
    if selection_source != "planner" and not str(approval.get("overrideReason") or "").strip():
        return "manual implementation model selection is missing an override reason"
    expected = planner_selected if selection_source == "planner" else selected
    if approval.get("model") != expected["modelRef"]:
        return f"implementation authorization is not pinned to {expected['modelRef']}"
    if approval.get("reasoningLevel") != expected["reasoningLevel"]:
        return f"implementation authorization is not pinned to {expected['reasoningLevel']} reasoning"
    return None


def implementation_profile_problem(
    ledger: dict[str, Any], root: Path, *, check_runtime: bool
) -> str | None:
    profile = ledger.get("implementationProfile") or {}
    selected = approved_implementation_profile(ledger)
    if profile.get("status") != "ready":
        return "the selected dedicated implementation agent has not been launched successfully"
    recorded_profile = profile.get("profile")
    recorded_profile_matches = recorded_profile == selected["profile"] or (
        is_known_implementation_profile(recorded_profile)
        and canonical_implementation_profile(str(recorded_profile)) == selected["profile"]
    )
    if recorded_profile is not None and not recorded_profile_matches:
        return f"implementation agent profile must be {selected['profile']}"
    if profile.get("provider") != selected["provider"]:
        return f"implementation agent provider must be {selected['provider']}"
    if profile.get("model") != selected["model"]:
        return f"implementation agent model must be {selected['model']}"
    if profile.get("reasoningLevel") != selected["reasoningLevel"]:
        return f"implementation agent reasoning must be {selected['reasoningLevel']}"
    current_hash = plan_sha256(ledger, root)
    if current_hash is None:
        return "the recorded plan is missing, outside this worktree, or unreadable"
    if profile.get("planSha256") != current_hash:
        return "the dedicated implementation agent was launched for an older plan revision"
    if not profile.get("agentName") or not profile.get("paneId"):
        return "the dedicated implementation agent identity is incomplete"
    if check_runtime:
        provider = (os.environ.get("PI_PROVIDER") or "").strip()
        model = (os.environ.get("PI_MODEL") or "").strip()
        reasoning = (os.environ.get("PI_REASONING_LEVEL") or "").strip()
        current_pane = (os.environ.get("HERDR_PANE_ID") or "").strip()
        if not provider or not model or not reasoning or not current_pane:
            return "implementation entry must be run from the recorded pinned Herdr Pi agent"
        if current_pane != str(profile.get("paneId")):
            return (
                "current Herdr pane does not match the recorded implementation agent pane "
                f"{profile.get('paneId')}"
            )
        if provider != selected["provider"] or model != selected["model"]:
            return (
                "current Pi runtime is not the selected implementation model "
                f"{selected['modelRef']}"
            )
        if reasoning != selected["reasoningLevel"]:
            return f"current Pi runtime reasoning must be {selected['reasoningLevel']}"
    return None


def hydrate_protocol_entry_problem(ledger: dict[str, Any]) -> str | None:
    """Block IMPLEMENTING until dual-plan hydrate has transitioned to the executor."""
    if not hydrate_protocol_active(ledger):
        return None
    phase = str((ledger.get("hydrateProtocol") or {}).get("phase") or "")
    if phase in {"executor-transitioned", "executor-verified"}:
        return None
    if phase == "failed-transition":
        return (
            "hydrate protocol is in failed-transition; recover to the authorized "
            "hydrate or executor runtime, ensure a valid hydrate-transition receipt, "
            "and re-verify"
        )
    return (
        "dual-plan hydrate protocol has not reached executor-verified "
        f"(current phase={phase or 'missing'}; complete Luna hydrate, transition via "
        "delivery-hydrate prewalk, then re-run delivery verify-implementation-profile)"
    )


def hydrate_receipt_path(root: Path) -> Path:
    override = (os.environ.get("DELIVERY_HYDRATE_RECEIPT") or "").strip()
    if override:
        return Path(override)
    return root / ".delivery" / HYDRATE_RECEIPT_FILENAME


def read_hydrate_transition_receipt(root: Path) -> dict[str, Any] | None:
    path = hydrate_receipt_path(root)
    if not path.is_file():
        return None
    try:
        payload = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return None
    return payload if isinstance(payload, dict) else None


def prewalk_into_spec_for_executor(executor: dict[str, str]) -> str:
    """Map delivery executor profile to a prewalk --prewalk-into target."""
    profile = str(executor.get("profile") or "")
    if profile == "terra-high":
        return "terra"
    model_ref = str(executor.get("modelRef") or "")
    reasoning = str(executor.get("reasoningLevel") or "")
    if model_ref and reasoning:
        return f"{model_ref}:{reasoning}"
    return model_ref or "terra"


def hydrate_transition_receipt_problem(
    ledger: dict[str, Any], root: Path, *, for_executor: bool
) -> str | None:
    """Require a prewalk-written receipt before accepting executor-verified."""
    if not for_executor or not hydrate_protocol_active(ledger):
        return None
    proto = ledger.get("hydrateProtocol") or {}
    receipt = read_hydrate_transition_receipt(root)
    if not receipt:
        return (
            f"missing hydrate transition receipt at {hydrate_receipt_path(root)}; "
            "arm delivery-hydrate prewalk so the first edit/write writes the receipt"
        )
    if str(receipt.get("version") or "") != HYDRATE_RECEIPT_VERSION:
        return (
            f"hydrate transition receipt version must be {HYDRATE_RECEIPT_VERSION} "
            f"(got {receipt.get('version')!r})"
        )
    if receipt.get("checklistInjected") is not True:
        return "hydrate transition receipt must record checklistInjected=true"
    trigger_tool = str(receipt.get("triggerTool") or "")
    if trigger_tool not in {"edit", "write"}:
        return "hydrate transition receipt must record a successful edit or write triggerTool"
    to = receipt.get("to") if isinstance(receipt.get("to"), dict) else {}
    executor_provider = str(proto.get("executorProvider") or "")
    executor_model = str(proto.get("executorModel") or "")
    to_provider = str(to.get("provider") or "")
    to_model = str(to.get("model") or "")
    same_model = receipt.get("sameModel") is True
    hydrate_provider = str(proto.get("hydrateProvider") or "")
    hydrate_model = str(proto.get("hydrateModel") or "")
    if same_model:
        if hydrate_provider != executor_provider or hydrate_model != executor_model:
            return (
                "hydrate transition receipt claims sameModel but hydrate and executor "
                "runtimes differ; expected a real model switch receipt"
            )
    elif to_provider != executor_provider or to_model != executor_model:
        return (
            "hydrate transition receipt target does not match authorized executor "
            f"{executor_provider}/{executor_model} (got {to_provider}/{to_model})"
        )
    return None


def record_hydrate_transition_receipt(ledger: dict[str, Any], root: Path) -> None:
    receipt = read_hydrate_transition_receipt(root)
    if not receipt:
        return
    proto = ledger.setdefault("hydrateProtocol", {})
    to = receipt.get("to") if isinstance(receipt.get("to"), dict) else {}
    path = hydrate_receipt_path(root)
    try:
        path_display = str(path.resolve().relative_to(root.resolve()))
    except ValueError:
        path_display = str(path)
    proto["transitionReceipt"] = {
        "at": receipt.get("at"),
        "sameModel": receipt.get("sameModel") is True,
        "checklistInjected": receipt.get("checklistInjected") is True,
        "triggerTool": receipt.get("triggerTool"),
        "toProvider": to.get("provider"),
        "toModel": to.get("model"),
        "path": path_display,
    }


def implementation_run_started(ledger: dict[str, Any]) -> bool:
    history = ledger.get("history") if isinstance(ledger.get("history"), list) else []
    if any(
        item.get("type") == "stage" and "-> IMPLEMENTING" in str(item.get("detail") or "")
        for item in history
        if isinstance(item, dict)
    ):
        return True
    implementation = ((ledger.get("evidence") or {}).get("implementation") or {}).get("status")
    profile = (ledger.get("implementationProfile") or {}).get("status")
    return implementation not in {None, "pending"} or profile in {"started", "ready", "verified"}


def terminal_stage_problem(ledger: dict[str, Any], root: Path, stage: str) -> str | None:
    if stage != "DONE" or not implementation_run_started(ledger):
        return None
    evidence = ledger.get("evidence") or {}
    required_pass = (
        "implementation", "scopedReview", "implPm", "completionEval",
        "customerImpact", "autoreview", "verify", "pr",
    )
    missing = [
        key for key in required_pass
        if (evidence.get(key) or {}).get("status") != "pass"
    ]
    if (
        not is_omp_lite(ledger)
        and (evidence.get("adversarialQa") or {}).get("status") not in {"pass", "na"}
    ):
        missing.append("adversarialQa")
    if not ledger.get("prUrl"):
        missing.append("prUrl")
    if missing:
        return "missing required delivery evidence: " + ", ".join(missing)
    return None


def is_omp_lite(ledger: dict[str, Any]) -> bool:
    return ledger.get("runtime") == "omp" and ledger.get("workflowProfile") == "omp-lite"


def omp_lite_delivery_problem(ledger: dict[str, Any], root: Path, stage: str) -> str | None:
    """Return missing OMP Lite review/closeout evidence for protected delivery stages."""
    if stage not in {"PR_OPEN", "MERGE_READY", "DONE"}:
        return None
    evidence = ledger.get("evidence") or {}
    required_pass = ["implPm", "autoreview"]
    if stage == "DONE":
        required_pass.extend(("verify", "pr"))
    missing = [
        key for key in required_pass
        if (evidence.get(key) or {}).get("status") != "pass"
    ]
    if stage == "DONE" and not ledger.get("prUrl"):
        missing.append("prUrl")
    if missing:
        return "missing required OMP Lite delivery evidence: " + ", ".join(missing)
    return None


def stage_transition_problem(ledger: dict[str, Any], root: Path, stage: str) -> str | None:
    """Return the authorization or terminal-integrity failure for a protected stage transition."""
    if is_omp_lite(ledger) and stage in {"ADVERSARIAL_QA", "REFLECT"}:
        return (
            f"OMP Lite {stage} is an optional action, not a stage; "
            "record it without changing the current detailed stage"
        )
    if stage in {"PLAN_PM_REVIEW", "PLAN_TECH_REVIEW"}:
        return plan_readiness_request_problem(ledger, root)
    if stage == "EXECUTION_READY":
        if is_omp_lite(ledger):
            return plan_readiness_request_problem(ledger, root)
        return (
            plan_readiness_request_problem(ledger, root)
            or plan_technical_review_problem(ledger, root)
            or plan_sync_problem(ledger, root)
        )
    if stage == "IMPLEMENTING":
        readiness_problem = plan_readiness_request_problem(ledger, root)
        if readiness_problem:
            return f"no current execution-ready review request: {readiness_problem}"
        if is_omp_lite(ledger):
            return None
        return (
            plan_technical_review_problem(ledger, root)
            or plan_sync_problem(ledger, root)
            or implementation_approval_problem(ledger, root)
            or hydrate_protocol_entry_problem(ledger)
            or implementation_profile_problem(ledger, root, check_runtime=True)
        )
    if is_omp_lite(ledger):
        return omp_lite_delivery_problem(ledger, root, stage)
    return terminal_stage_problem(ledger, root, stage)


def reset_hydrate_protocol(ledger: dict[str, Any], reason: str) -> None:
    if "hydrateProtocol" not in ledger and not dual_plan_mode(ledger):
        return
    ledger["hydrateProtocol"] = {
        "status": "pending",
        "phase": None,
        "version": HYDRATE_PROTOCOL_VERSION,
        "reason": reason,
        "updatedAt": utc_now(),
    }


def reset_implementation_approval(ledger: dict[str, Any], reason: str) -> None:
    approval = ledger.setdefault("implementationApproval", {})
    approval.update(
        {
            "status": "pending",
            "source": None,
            "planSha256": None,
            "profile": None,
            "model": None,
            "reasoningLevel": None,
            "selectionSource": None,
            "overrideReason": None,
            "summary": None,
            "approvedAt": None,
            "invalidatedAt": utc_now(),
            "reason": reason,
        }
    )
    reset_hydrate_protocol(ledger, reason)


def reset_implementation_profile(ledger: dict[str, Any], reason: str) -> None:
    selected = approved_implementation_profile(ledger)
    profile = ledger.setdefault("implementationProfile", {})
    profile.update(
        {
            "status": "pending",
            "profile": selected["profile"],
            "provider": selected["provider"],
            "model": selected["model"],
            "modelRef": selected["modelRef"],
            "reasoningLevel": selected["reasoningLevel"],
            "selectionSource": (ledger.get("implementationApproval") or {}).get("selectionSource") or "planner",
            "overrideReason": (ledger.get("implementationApproval") or {}).get("overrideReason"),
            "planSha256": None,
            "agentName": None,
            "paneId": None,
            "tabId": None,
            "tabLabel": None,
            "sourcePaneId": None,
            "sourceTabId": None,
            "launchedAt": None,
            "promptedAt": None,
            "launchAttemptId": None,
            "reason": reason,
        }
    )


def phase_code(stage: str | None, workflow_profile: str | None = None) -> str:
    if workflow_profile == "omp-lite":
        if stage in {"ADVERSARIAL_QA", "REFLECT"}:
            return ""
        return STAGE_PHASE_CODE.get(str(stage or "INTAKE"), "PL")
    return STAGE_PHASE_CODE.get(str(stage or "INTAKE"), "PL")


def strip_phase_prefix(text: str | None) -> str:
    return PHASE_CODE_RE.sub("", (text or "").strip()).strip()


def strip_stage_suffix(text: str | None) -> str:
    """Remove trailing delivery stage tokens from titles.

    Handles legacy Herdr labels like "NOD-1475 · IMPLEMENTING" and bare
    stage-only titles so the descriptive half stays the work slug/title.
    """
    value = (text or "").strip()
    if not value:
        return ""
    prev = None
    while value and value != prev:
        prev = value
        if value.upper() in STAGE_NAME_SET:
            return ""
        value = STAGE_TOKEN_RE.sub("", value).strip(" ·-:/\t")
    return value


def sanitize_base_title(text: str | None) -> str:
    """Title only: no phase code prefix, no stage-name suffix."""
    value = strip_stage_suffix(strip_phase_prefix(text))
    value = re.sub(r"\s+", " ", value).strip(" ·-:/\t")
    # Collapse "NOD-1 · slug" separators to a single readable form later.
    return value


def title_is_weak(text: str | None, *, issue: str | None = None) -> bool:
    """True when a candidate is empty, stage-like, or issue-only."""
    value = sanitize_base_title(text)
    if not value:
        return True
    if value.upper() in STAGE_NAME_SET:
        return True
    if issue and value.upper() == str(issue).upper():
        return True
    # Repo/id leftovers like "heddle/NOD-1475" with no human title.
    if "/" in value and not re.search(r"[a-zA-Z]{3,}", strip_issue_keys(value) or ""):
        return True
    return False


def ensure_base_title(ledger: dict[str, Any]) -> str:
    """Stable human title without phase code or stage name.

    Desired Herdr form: "R: NOD-1475 one-login-path" — never
    "R: NOD-1475 · IMPLEMENTING".
    """
    labels = ledger.setdefault("labels", {})
    issue = ledger.get("issue") if isinstance(ledger.get("issue"), str) else None
    spawn = ledger.get("spawn") if isinstance(ledger.get("spawn"), dict) else {}

    stored = labels.get("baseTitle")
    if isinstance(stored, str) and stored.strip() and not title_is_weak(stored, issue=issue):
        base = sanitize_base_title(stored)
        labels["baseTitle"] = base
        return short_label(base, max_len=42)

    # Prefer durable work identity over any previously written herdr label
    # (legacy values were "{issue|id} · {STAGE}").
    slug = ledger.get("slug") if isinstance(ledger.get("slug"), str) else None
    goal = ledger.get("goal") if isinstance(ledger.get("goal"), str) else None
    intent_from_goal = strip_issue_keys(goal) if goal else ""
    candidates = [
        spawn.get("label") if isinstance(spawn, dict) else None,
        (
            f"{issue} · {slug.replace('-', ' ')}"
            if issue and slug
            else None
        ),
        f"{issue} · {intent_from_goal}" if issue and intent_from_goal else None,
        intent_from_goal or None,
        slug.replace("-", " ") if slug else None,
        goal,
        issue,
        ledger.get("id"),
        labels.get("herdr"),  # last resort; may be legacy contaminated
    ]

    base = ""
    for candidate in candidates:
        if not isinstance(candidate, str) or not candidate.strip():
            continue
        cleaned = sanitize_base_title(candidate)
        if not cleaned or title_is_weak(cleaned, issue=issue):
            # Keep issue-only as a weak fallback but keep looking for a slug/title.
            if cleaned and not base:
                base = cleaned
            continue
        base = cleaned
        break
    if not base:
        base = sanitize_base_title(issue or slug or goal or ledger.get("id") or "delivery") or "delivery"

    # Prefer compact issue-leading titles when possible.
    if issue and issue.lower() not in base.lower():
        base = f"{issue} · {base}".strip()
    # Normalize separators after salvage.
    base = re.sub(r"\s*[·]\s*", " · ", base)
    base = re.sub(r"\s+", " ", base).strip(" ·")
    base = short_label(base, max_len=42)
    labels["baseTitle"] = base
    return base


def herdr_display_label(ledger: dict[str, Any]) -> str:
    code = phase_code(str(ledger.get("stage") or "INTAKE"), ledger.get("workflowProfile"))
    base = ensure_base_title(ledger)
    # Guard: never allow a stage token back into the visible title.
    base = sanitize_base_title(base) or base
    if title_is_weak(base) and ledger.get("slug"):
        slug = str(ledger.get("slug")).replace("-", " ")
        issue = ledger.get("issue")
        base = f"{issue} · {slug}" if issue else slug
        base = short_label(sanitize_base_title(base), max_len=42)
        ledger.setdefault("labels", {})["baseTitle"] = base
    return f"{code}: {base}"


def herdr_mutations_enabled() -> bool:
    if os.environ.get("DELIVERY_SKIP_HERDR", "").strip().lower() in {"1", "true", "yes"}:
        return False
    return shutil.which("herdr") is not None


def resolve_herdr_targets(ledger: dict[str, Any]) -> dict[str, str | None]:
    """Resolve Herdr chrome targets. Workspace owner wins over ambient HERDR_* env."""
    labels = ledger.get("labels") if isinstance(ledger.get("labels"), dict) else {}
    spawn = ledger.get("spawn") if isinstance(ledger.get("spawn"), dict) else {}
    owner = ledger.get("workspaceOwner") if isinstance(ledger.get("workspaceOwner"), dict) else {}
    workspace_id = (
        owner.get("workspaceId")
        or os.environ.get("HERDR_WORKSPACE_ID")
        or labels.get("herdrWorkspaceId")
        or spawn.get("workspaceId")
    )
    # Owner tab is the product glance surface; ambient HERDR_TAB_ID must not steal chrome.
    tab_id = (
        owner.get("tabId")
        or labels.get("herdrTabId")
        or spawn.get("tabId")
        or os.environ.get("HERDR_TAB_ID")
    )
    pane_id = (
        owner.get("paneId")
        or labels.get("herdrPaneId")
        or spawn.get("paneId")
        or os.environ.get("HERDR_PANE_ID")
    )
    return {
        "workspaceId": str(workspace_id) if workspace_id else None,
        "tabId": str(tab_id) if tab_id else None,
        "paneId": str(pane_id) if pane_id else None,
    }


def caller_tab_id() -> str | None:
    value = (os.environ.get("HERDR_TAB_ID") or "").strip()
    return value or None


def enqueue_tab_retire(ledger: dict[str, Any], tab_id: str | None, reason: str) -> None:
    if not tab_id:
        return
    tid = str(tab_id)
    pending = ledger.setdefault("tabsToRetire", [])
    if not isinstance(pending, list):
        pending = []
        ledger["tabsToRetire"] = pending
    for item in pending:
        if isinstance(item, dict) and str(item.get("tabId") or "") == tid:
            return
    pending.append({"tabId": tid, "reason": reason, "enqueuedAt": utc_now()})


def retire_tab(tab_id: str | None, reason: str, *, caller_tab: str | None = None) -> str:
    """Best-effort close a Herdr tab. Returns closed|skipped-self|skipped|failed."""
    if not tab_id:
        return "skipped"
    if caller_tab and str(tab_id) == str(caller_tab):
        return "skipped-self"
    if not herdr_mutations_enabled():
        return "skipped"
    try:
        proc = subprocess.run(
            ["herdr", "tab", "close", str(tab_id)],
            check=False,
            capture_output=True,
            text=True,
            timeout=5,
        )
        return "closed" if proc.returncode == 0 else "failed"
    except Exception:
        return "failed"


def retire_pending_tabs(
    ledger: dict[str, Any],
    *,
    caller_tab: str | None = None,
    history: bool = True,
) -> list[str]:
    """Drain tabsToRetire from a non-target caller context. Returns closed tab ids."""
    pending = ledger.get("tabsToRetire")
    if not isinstance(pending, list) or not pending:
        return []
    remaining: list[dict[str, Any]] = []
    closed: list[str] = []
    caller = caller_tab if caller_tab is not None else caller_tab_id()
    for item in pending:
        if not isinstance(item, dict):
            continue
        tid = item.get("tabId")
        reason = str(item.get("reason") or "retire")
        status = retire_tab(tid if isinstance(tid, str) else None, reason, caller_tab=caller)
        if status == "closed":
            closed.append(str(tid))
            if history:
                append_history(
                    ledger,
                    "tab_retired",
                    reason,
                    tabId=str(tid),
                )
        elif status == "skipped-self":
            remaining.append(item)
        elif status == "failed":
            # Keep for a later drain attempt from another owner context.
            remaining.append(item)
        # skipped (no herdr): drop so SKIP mode does not accumulate forever
    ledger["tabsToRetire"] = remaining
    return closed


def claim_workspace_owner(
    ledger: dict[str, Any],
    *,
    role: str,
    tab_id: str | None,
    pane_id: str | None,
    agent_name: str | None = None,
    workspace_id: str | None = None,
    retire_previous_reason: str | None = None,
    focus: bool = True,
) -> None:
    """Record the single workspace owner and sync chrome to that tab."""
    prev = ledger.get("workspaceOwner") if isinstance(ledger.get("workspaceOwner"), dict) else {}
    prev_tab = prev.get("tabId")
    if (
        retire_previous_reason
        and prev_tab
        and tab_id
        and str(prev_tab) != str(tab_id)
    ):
        enqueue_tab_retire(ledger, str(prev_tab), retire_previous_reason)
    targets = resolve_herdr_targets(ledger)
    ws = workspace_id or targets.get("workspaceId")
    owner = {
        "role": role,
        "tabId": str(tab_id) if tab_id else None,
        "paneId": str(pane_id) if pane_id else None,
        "agentName": agent_name,
        "workspaceId": str(ws) if ws else None,
        "claimedAt": utc_now(),
    }
    ledger["workspaceOwner"] = owner
    labels = ledger.setdefault("labels", {})
    if isinstance(labels, dict):
        if owner["tabId"]:
            labels["herdrTabId"] = owner["tabId"]
        if owner["paneId"]:
            labels["herdrPaneId"] = owner["paneId"]
        if owner["workspaceId"]:
            labels["herdrWorkspaceId"] = owner["workspaceId"]
    if focus and herdr_mutations_enabled() and owner["tabId"]:
        try:
            subprocess.run(
                ["herdr", "tab", "focus", owner["tabId"]],
                check=False,
                capture_output=True,
                text=True,
                timeout=5,
            )
        except Exception:
            pass
    maybe_herdr_label(
        ledger,
        targets={
            "workspaceId": owner.get("workspaceId"),
            "tabId": owner.get("tabId"),
            "paneId": owner.get("paneId"),
        },
    )


def start_agent_on_pane(
    *,
    root: Path,
    agent_name: str,
    pane_id: str,
    timeout_ms: int,
    extra_args: list[str],
) -> subprocess.CompletedProcess[str]:
    """Start a Pi agent on a pane, retrying briefly on agent_pane_busy."""
    herdr = require_herdr()
    start_command = [
        herdr,
        "agent",
        "start",
        agent_name,
        "--kind",
        "pi",
        "--pane",
        str(pane_id),
        "--timeout",
        str(timeout_ms),
        *extra_args,
    ]
    deadline = time.monotonic() + min(max(timeout_ms / 1000.0, 1.0), 10.0)
    started: subprocess.CompletedProcess[str] | None = None
    while True:
        started = run_cmd(start_command, cwd=root)
        if started.returncode == 0:
            return started
        detail = (started.stderr or started.stdout or "").strip()
        if "agent_pane_busy" not in detail or time.monotonic() >= deadline:
            return started
        time.sleep(0.1)


def discover_tab_id_for_pane(ledger: dict[str, Any], root: Path, pane_id: str) -> str | None:
    """Best-effort tab id for a pane (used when enqueueing the previous owner)."""
    owner = ledger.get("workspaceOwner") if isinstance(ledger.get("workspaceOwner"), dict) else {}
    if owner.get("paneId") and str(owner.get("paneId")) == str(pane_id) and owner.get("tabId"):
        return str(owner["tabId"])
    spawn = ledger.get("spawn") if isinstance(ledger.get("spawn"), dict) else {}
    if spawn.get("paneId") and str(spawn.get("paneId")) == str(pane_id) and spawn.get("tabId"):
        return str(spawn["tabId"])
    env_tab = caller_tab_id()
    env_pane = (os.environ.get("HERDR_PANE_ID") or "").strip()
    if env_tab and env_pane and env_pane == str(pane_id):
        return env_tab
    if not herdr_mutations_enabled():
        return env_tab
    try:
        proc = run_cmd([require_herdr(), "pane", "get", str(pane_id)], cwd=root)
        if proc.returncode != 0:
            return env_tab
        payload = json.loads(proc.stdout)
        result = payload.get("result") if isinstance(payload, dict) else None
        pane = result.get("pane") if isinstance(result, dict) else result
        if isinstance(pane, dict) and pane.get("tab_id"):
            return str(pane["tab_id"])
    except Exception:
        pass
    return env_tab


def agent_tab_label(role: str, ledger: dict[str, Any]) -> str:
    """Human label for a delivery helper tab; agent names remain machine identity."""
    prefix = f"{role} · "
    base = short_label(ensure_base_title(ledger), max_len=max(12, 48 - len(prefix)))
    return prefix + base


def agent_tab_json(
    args: list[str],
    *,
    root: Path,
    step: str,
    attempted: str,
    next_action: str,
) -> dict[str, Any]:
    """Run a Herdr JSON command with launch-specific fail-closed diagnostics."""
    herdr = require_herdr()
    proc = run_cmd([herdr, *args], cwd=root)
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or "").strip() or "no diagnostic output"
        die(
            f"agent-tab {step} failed ({proc.returncode}): {detail}. "
            f"Tried: {attempted}. Next action: {next_action}."
        )
    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        die(
            f"agent-tab {step} returned non-JSON ({exc}). Tried: {attempted}. "
            f"Next action: {next_action}."
        )
    if not isinstance(payload, dict):
        die(
            f"agent-tab {step} returned a non-object JSON root. Tried: {attempted}. "
            f"Next action: {next_action}."
        )
    return payload


def resolve_workspace_id(ledger: dict[str, Any], source_pane: str) -> str:
    """Resolve the current Herdr workspace without guessing from pane identifiers."""
    workspace_id = resolve_herdr_targets(ledger).get("workspaceId")
    if workspace_id:
        return str(workspace_id)
    attempted = (
        "delivery workspace targets (HERDR_WORKSPACE_ID, labels.herdrWorkspaceId, "
        f"spawn.workspaceId), then `herdr pane get {source_pane}`"
    )
    next_action = "supply --pane from a live Herdr workspace or restore HERDR_WORKSPACE_ID context"
    payload = agent_tab_json(
        ["pane", "get", str(source_pane)],
        root=Path(ledger.get("worktree") or Path.cwd()),
        step="workspace discovery",
        attempted=attempted,
        next_action=next_action,
    )
    result = payload.get("result")
    pane = result.get("pane") if isinstance(result, dict) else None
    workspace_id = pane.get("workspace_id") if isinstance(pane, dict) else None
    if not workspace_id:
        die(
            "agent-tab workspace discovery returned no result.pane.workspace_id. "
            f"Tried: {attempted}. Next action: {next_action}."
        )
    return str(workspace_id)


def build_tab_create_command(workspace_id: str, root: Path, label: str) -> list[str]:
    """Build the shared Herdr tab-create arguments used by preview and execution."""
    return [
        "tab",
        "create",
        "--workspace",
        workspace_id,
        "--cwd",
        str(root),
        "--label",
        label,
        "--no-focus",
    ]


def create_labeled_agent_tab(
    *,
    ledger: dict[str, Any],
    root: Path,
    source_pane: str,
    role: str,
) -> dict[str, str]:
    """Create a same-workspace labeled tab and return its stable tab/pane IDs."""
    workspace_id = resolve_workspace_id(ledger, source_pane)
    label = agent_tab_label(role, ledger)
    command = build_tab_create_command(workspace_id, root, label)
    attempted = f"`herdr {' '.join(command)}` after workspace discovery"
    next_action = "supply --pane from a live Herdr workspace or restore Herdr workspace context"
    payload = agent_tab_json(
        command,
        root=root,
        step="tab creation",
        attempted=attempted,
        next_action=next_action,
    )
    result = payload.get("result")
    root_pane = result.get("root_pane") if isinstance(result, dict) else None
    tab = result.get("tab") if isinstance(result, dict) else None
    pane_id = root_pane.get("pane_id") if isinstance(root_pane, dict) else None
    tab_id = tab.get("tab_id") if isinstance(tab, dict) else None
    if not pane_id:
        die(
            "agent-tab tab creation returned no result.root_pane.pane_id. "
            f"Tried: {attempted}. Next action: {next_action}."
        )
    if not tab_id:
        die(
            "agent-tab tab creation returned no result.tab.tab_id. "
            f"Tried: {attempted}. Next action: {next_action}."
        )
    return {
        "workspaceId": workspace_id,
        "tabId": str(tab_id),
        "paneId": str(pane_id),
        "label": label,
    }


def maybe_herdr_label(
    ledger: dict[str, Any],
    *,
    targets: dict[str, str | None] | None = None,
) -> None:
    """Best-effort Herdr workspace + owner-tab label sync with phase prefix.

    Never fails the command. Format: "PL: nod-1234 short title".
    Chrome always prefers workspaceOwner via resolve_herdr_targets unless the
    caller passes explicit destination targets (spawn).
    """
    if not herdr_mutations_enabled():
        # Still record the intended label text for briefs/tests when Herdr is skipped.
        labels = ledger.setdefault("labels", {})
        if isinstance(labels, dict):
            labels["herdr"] = herdr_display_label(ledger)
            labels["phaseCode"] = phase_code(str(ledger.get("stage") or "INTAKE"), ledger.get("workflowProfile"))
        return

    label = herdr_display_label(ledger)
    targets = targets or resolve_herdr_targets(ledger)
    labels = ledger.setdefault("labels", {})
    labels["herdr"] = label
    labels["phaseCode"] = phase_code(str(ledger.get("stage") or "INTAKE"), ledger.get("workflowProfile"))

    try:
        workspace_id = targets.get("workspaceId")
        tab_id = targets.get("tabId")

        # Workspace/space name is the primary glance surface.
        if workspace_id:
            proc = subprocess.run(
                ["herdr", "workspace", "rename", str(workspace_id), label],
                check=False,
                capture_output=True,
                text=True,
                timeout=5,
            )
            if proc.returncode == 0:
                labels["herdrWorkspaceId"] = str(workspace_id)

        # Keep the owner tab aligned when we know it.
        if tab_id:
            proc = subprocess.run(
                ["herdr", "tab", "rename", str(tab_id), label],
                check=False,
                capture_output=True,
                text=True,
                timeout=5,
            )
            if proc.returncode == 0:
                labels["herdrTabId"] = str(tab_id)
        elif targets.get("paneId") and not workspace_id:
            # Last resort: older path only had pane/tab env.
            pass
    except Exception:
        # Guidance only — ignore herdr failures.
        return


def cmd_arm(args: argparse.Namespace) -> int:
    """Single operator entrypoint to create or attach a delivery ledger."""
    root = Path(args.cwd).resolve() if args.cwd else detect_repo_root()
    refuse_if_prewalk_armed(root)
    path = root / LEDGER_REL
    from_existing = bool(getattr(args, "from_existing_implementation", False))
    if path.exists() and not getattr(args, "force", False):
        ledger = load_json(path)
        if args.json:
            print(
                json.dumps(
                    {
                        "armed": True,
                        "created": False,
                        "ledger": str(path),
                        "stage": ledger.get("stage"),
                        "attachedFrom": ledger.get("attachedFrom"),
                    },
                    indent=2,
                )
            )
        else:
            print(f"delivery already armed: {path}")
            print(f"stage: {ledger.get('stage')}")
        return 0
    if from_existing:
        return arm_from_existing_implementation(args, root, path)
    if not getattr(args, "stage", None):
        args.stage = "INTAKE"
    return cmd_bootstrap(args)


def arm_from_existing_implementation(
    args: argparse.Namespace, root: Path, path: Path
) -> int:
    stage = "SCOPED_REVIEW"
    ledger_id = args.id or default_id(root, args.issue, args.slug)
    ledger = new_ledger(
        root=root,
        ledger_id=ledger_id,
        issue=args.issue,
        plan=args.plan,
        stage=stage,
        doct_url=args.doct_url,
        pr_url=args.pr_url,
        slug=args.slug,
    )
    initialize_runtime_profile(
        ledger,
        runtime=getattr(args, "runtime", None),
        workflow_profile=getattr(args, "workflow_profile", None),
    )
    ledger["attachedFrom"] = "existing-implementation"
    evidence = ledger.setdefault("evidence", empty_evidence())
    evidence["implementation"] = {
        "status": "skip",
        "artifact": None,
        "summary": "attached from existing non-delivery implementation",
        "updatedAt": utc_now(),
    }
    append_history(
        ledger,
        "attach",
        "existing-implementation; starting at SCOPED_REVIEW",
    )
    if getattr(args, "goal", None):
        goal = str(args.goal).strip()
        if goal:
            ledger["goal"] = goal
    refresh_git_fields(ledger, root)
    brief = render_agent_brief(ledger, path)
    brief_path = path.parent / "AGENT_BRIEF.md"
    path.parent.mkdir(parents=True, exist_ok=True)
    brief_path.write_text(brief + "\n", encoding="utf-8")
    ledger["agentBrief"] = str(brief_path)
    ledger["advisories"] = build_advisories(ledger, root)
    maybe_herdr_label(ledger)
    write_json(path, ledger, force_replace=bool(getattr(args, "force", False)))
    if args.json:
        print(
            json.dumps(
                {
                    "armed": True,
                    "created": True,
                    "attachedFrom": "existing-implementation",
                    "ledger": str(path),
                    "brief": str(brief_path),
                    "stage": ledger.get("stage"),
                    "id": ledger.get("id"),
                },
                indent=2,
            )
        )
    else:
        print("delivery armed from existing implementation")
        print(f"ledger: {path}")
        print(f"brief:  {brief_path}")
        print(f"stage:  {ledger.get('stage')}")
        print("next:   review / completeness / PR (no implementation pane)")
    return 0


def cmd_init(args: argparse.Namespace) -> int:
    root = Path(args.cwd).resolve() if args.cwd else detect_repo_root()
    path = root / LEDGER_REL
    if path.exists() and not args.force:
        die(f"ledger already exists: {path} (use --force to overwrite)")
    refuse_if_prewalk_armed(root)
    stage = args.stage or "INTAKE"
    if stage not in STAGES:
        die(f"unknown stage {stage!r}; choose from: {', '.join(STAGES)}")
    ledger_id = args.id or default_id(root, args.issue, args.slug)
    ledger = new_ledger(
        root=root,
        ledger_id=ledger_id,
        issue=args.issue,
        plan=args.plan,
        stage=stage,
        doct_url=args.doct_url,
        pr_url=args.pr_url,
        slug=args.slug,
    )
    initialize_runtime_profile(
        ledger,
        runtime=getattr(args, "runtime", None),
        workflow_profile=getattr(args, "workflow_profile", None),
    )
    transition_problem = stage_transition_problem(ledger, root, stage)
    if transition_problem:
        die(
            f"cannot initialize at {stage}: {transition_problem}. "
            "Create the ledger at INTAKE and advance through delivery's guarded steps."
        )
    if args.plan and not ledger.get("agenticPlan"):
        derived = derive_agentic_companion_relpath(args.plan)
        if resolve_worktree_file(derived, root) is not None:
            ledger["agenticPlan"] = derived
    write_json(path, ledger, force_replace=args.force)
    maybe_herdr_label(ledger)
    write_json(path, ledger)
    print(path)
    if args.json:
        print(json.dumps(ledger, indent=2))
    return 0


def cmd_path(args: argparse.Namespace) -> int:
    path = find_ledger_path(Path(args.cwd).resolve() if args.cwd else None, args.ledger)
    print(path)
    return 0 if path.exists() or args.allow_missing else 1


def load_ledger_for(args: argparse.Namespace) -> tuple[Path, dict[str, Any], Path]:
    root = Path(args.cwd).resolve() if getattr(args, "cwd", None) else detect_repo_root()
    path = find_ledger_path(root, getattr(args, "ledger", None))
    if not path.exists():
        die(f"no ledger at {path}; run: delivery init")
    ledger = load_json(path)
    # If ledger records a worktree, prefer that root for git refresh.
    wt = ledger.get("worktree")
    if wt and Path(wt).is_dir():
        root = Path(wt)
    backfill_legacy_runtime_profile(
        path,
        ledger,
        root,
        runtime=getattr(args, "runtime", None),
        workflow_profile=getattr(args, "workflow_profile", None),
    )
    return path, ledger, root


def cmd_show(args: argparse.Namespace) -> int:
    path, ledger, root = load_ledger_for(args)
    refresh_git_fields(ledger, root)
    if args.json:
        print(json.dumps(ledger, indent=2))
        return 0
    print(f"id:        {ledger.get('id')}")
    print(f"path:      {path}")
    print(f"stage:     {ledger.get('stage')}")
    print(f"phase:     {phase_code(str(ledger.get('stage')), ledger.get('workflowProfile'))}")
    print(f"issue:     {ledger.get('issue')}")
    print(f"slug:      {ledger.get('slug')}")
    print(f"plan:      {ledger.get('plan')}")
    print(f"agentic:   {ledger.get('agenticPlan') or expected_agentic_plan_relpath(ledger)}")
    operator_hash, agentic_hash = operator_and_agentic_plan_sha256_pair(ledger, root)
    if operator_hash or agentic_hash:
        print(f"planSha:   {operator_hash or '(unavailable)'}")
        print(f"agenticSha:{agentic_hash or '(unavailable)'}")
    companion_problem = agentic_companion_problem(ledger, root)
    if companion_problem:
        print(f"agentic!:  {companion_problem}")
    proto = ledger.get("hydrateProtocol") or {}
    if proto.get("status") == "active":
        print(
            f"hydrate:   phase={proto.get('phase')} "
            f"{proto.get('hydrateModelRef')}@{proto.get('hydrateReasoningLevel')} → "
            f"{proto.get('executorProfile')} / {proto.get('executorModelRef')}@"
            f"{proto.get('executorReasoningLevel')}"
        )
    print(f"runtime:   {ledger.get('runtime')}")
    print(f"profile:   {ledger.get('workflowProfile')}")
    print(f"branch:    {ledger.get('branch')}")
    print(f"worktree:  {ledger.get('worktree')}")
    print(f"pr:        {ledger.get('prUrl')}")
    print(f"doct:      {ledger.get('doctUrl')}")
    if is_omp_lite(ledger):
        readiness = ((ledger.get("evidence") or {}).get("planReadinessRequest") or {}).get("status", "pending")
        print(f"implementation authorization: OMP plan readiness {readiness}")
        print("implementation owner: current OMP session")
        print("implementation runtime: normal OMP coding mode")
    else:
        approval = ledger.get("implementationApproval") or {}
        approval_problem = implementation_approval_problem(ledger, root)
        approval_status = approval.get("status", "pending")
        if approval_problem:
            approval_status = f"{approval_status} ({approval_problem})"
        print(f"implementation authorization: {approval_status}")
        profile = ledger.get("implementationProfile") or {}
        profile_status = profile.get("status", "pending")
        profile_problem = implementation_profile_problem(ledger, root, check_runtime=False)
        if profile_problem:
            profile_status = f"{profile_status} ({profile_problem})"
        selected = approved_implementation_profile(ledger)
        print(f"implementation agent: {profile_status}")
        print(f"plan review cycles: {int(ledger.get('planReviewCycleCount') or 0)}/3")
        print(
            f"implementation runtime: {selected['profile']} / {selected['modelRef']} / "
            f"{selected['reasoningLevel']}"
        )
    print(f"updated:   {ledger.get('updatedAt')}")
    print(f"next:      {next_step_for(str(ledger.get('stage')), ledger.get('workflowProfile'))}")
    print("evidence:")
    for key, val in (ledger.get("evidence") or {}).items():
        status = (val or {}).get("status", "pending")
        summary = (val or {}).get("summary") or ""
        art = (val or {}).get("artifact") or ""
        extra = " ".join(x for x in (summary, art) if x)
        print(f"  - {key}: {status}" + (f"  {extra}" if extra else ""))
    notes = ledger.get("notes") or []
    if notes:
        print("notes:")
        for note in notes[-5:]:
            print(f"  - [{note.get('at')}] {note.get('text')}")
    blockers = ledger.get("blockers") or []
    if blockers:
        print("blockers:")
        for b in blockers:
            print(f"  - {b}")
    return 0

def cmd_stage(args: argparse.Namespace) -> int:
    stage = args.stage
    if stage not in STAGES:
        die(f"unknown stage {stage!r}; choose from: {', '.join(STAGES)}")
    path, ledger, root = load_ledger_for(args)
    if is_omp_lite(ledger) and stage in {"ADVERSARIAL_QA", "REFLECT"}:
        append_history(ledger, "optional_action", f"{stage} recorded without stage change")
        if args.note:
            ledger.setdefault("notes", []).append(
                {"at": utc_now(), "text": args.note, "stage": ledger.get("stage")}
            )
        refresh_git_fields(ledger, root)
        write_json(path, ledger)
        print(f"{stage} recorded; OMP Lite remains at {ledger.get('stage')}")
        return 0
    transition_problem = stage_transition_problem(ledger, root, stage)
    if transition_problem:
        if stage == "IMPLEMENTING":
            if is_omp_lite(ledger):
                die(f"cannot enter IMPLEMENTING: {transition_problem}. Record the current OMP authorization before implementing.")
            die(
                "cannot enter IMPLEMENTING: "
                f"{transition_problem}. Let the execution-ready transition automatically authorize and launch "
                "the recommended implementation agent, then enter IMPLEMENTING from the recorded Pi runtime. "
                "If this same implementation pane was deliberately switched to another model, adopt it with "
                "`delivery verify-implementation-profile --adopt-current-runtime --reason \"...\"`."
            )
        if is_omp_lite(ledger) and stage in {"PR_OPEN", "MERGE_READY", "DONE"}:
            die(
                f"cannot enter {stage}: {transition_problem}. "
                "Run `delivery check -v` and record the missing OMP review or closeout evidence."
            )
        die(
            f"cannot enter {stage}: {transition_problem}. "
            "Continue processing ordinary feedback in PLAN_BROWSER_REVIEW."
        )
    prev = ledger.get("stage")
    ledger["stage"] = stage
    refresh_git_fields(ledger, root)
    append_history(ledger, "stage", f"{prev} -> {stage}")
    if args.note:
        ledger.setdefault("notes", []).append({"at": utc_now(), "text": args.note, "stage": stage})
    if stage == "DONE":
        owner = ledger.get("workspaceOwner") if isinstance(ledger.get("workspaceOwner"), dict) else {}
        profile = ledger.get("implementationProfile") or {}
        done_tab = owner.get("tabId") or profile.get("tabId")
        done_pane = owner.get("paneId") or profile.get("paneId")
        if done_tab or done_pane:
            claim_workspace_owner(
                ledger,
                role="done",
                tab_id=str(done_tab) if done_tab else None,
                pane_id=str(done_pane) if done_pane else None,
                agent_name=owner.get("agentName") or profile.get("agentName"),
                focus=False,
            )
        review = ledger.get("completenessReview") or {}
        witness = review.get("tabId")
        if witness and str(witness) != str(done_tab or ""):
            enqueue_tab_retire(ledger, str(witness), "completeness-fulfilled")
        retire_pending_tabs(ledger, caller_tab=caller_tab_id())
    else:
        maybe_herdr_label(ledger)
        owner = ledger.get("workspaceOwner") if isinstance(ledger.get("workspaceOwner"), dict) else {}
        caller = caller_tab_id()
        if caller and owner.get("tabId") and str(caller) == str(owner.get("tabId")):
            retire_pending_tabs(ledger, caller_tab=caller)
    write_json(path, ledger)
    print(f"{prev} -> {stage}")
    print(f"next: {STAGE_NEXT_SKILL.get(stage, 'n/a')}")
    skip_herdr = os.environ.get("DELIVERY_SKIP_HERDR", "").strip().lower() in {"1", "true", "yes"}
    if (
        stage == "EXECUTION_READY"
        and not is_omp_lite(ledger)
        and not getattr(args, "hold", False)
        and not skip_herdr
        and ledger.get("attachedFrom") != "existing-implementation"
    ):
        with implementation_launch_lock(root):
            path, current, root = load_ledger_for(args)
            auto_args = argparse.Namespace(
                source="workflow",
                summary="Independent plan readiness passed; automatically continue through implementation, verification, review, and PR creation.",
                model=None,
                reasoning_level=None,
                override_reason=None,
                pane=getattr(args, "pane", None),
                agent_name=getattr(args, "agent_name", None),
                timeout_ms=getattr(args, "timeout_ms", 60000),
            )
            return approve_implementation_locked(auto_args, path, current, root)
    return 0


@contextmanager
def implementation_launch_lock(root: Path):
    lock_path = root / IMPLEMENTATION_LAUNCH_LOCK_REL
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            die("an implementation agent launch is already in progress")
        os.ftruncate(fd, 0)
        os.write(fd, f"pid={os.getpid()} at={utc_now()}\n".encode())
        yield
    finally:
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
        finally:
            os.close(fd)


def implementation_agent_name(ledger: dict[str, Any]) -> str:
    identity = str(ledger.get("issue") or ledger.get("slug") or ledger.get("id") or "delivery")
    suffix = slugify(identity, max_len=9, keep_issue_keys=True)
    return f"implementation-{suffix}-{uuid.uuid4().hex[:6]}"


def implementation_agent_prompt(ledger: dict[str, Any], root: Path) -> str:
    plan = str(ledger.get("plan") or "(missing plan)")
    agentic = str(ledger.get("agenticPlan") or expected_agentic_plan_relpath(ledger) or "(none)")
    selected = approved_implementation_profile(ledger)
    approval = ledger.get("implementationApproval") or {}
    rationale = str(
        approval.get("overrideReason")
        or ((ledger.get("evidence") or {}).get("planTech") or {}).get("implementationRationale")
        or "legacy reviewed plan retained on Sol medium"
    )
    if hydrate_protocol_active(ledger):
        proto = ledger.get("hydrateProtocol") or {}
        executor_for_prewalk = runtime_profile(
            str(proto.get("executorModelRef") or ""),
            str(proto.get("executorReasoningLevel") or ""),
            profile=str(proto.get("executorProfile") or "manual"),
        )
        prewalk_into = prewalk_into_spec_for_executor(executor_for_prewalk)
        return f"""You are the dedicated dual-plan hydrate → executor agent for this delivery run.

Worktree: {root}
Operator plan: {plan}
Agentic companion: {agentic}
Hydrate protocol: {proto.get('version')} phase={proto.get('phase')}
Hydrate runtime (launch): {proto.get('hydrateModelRef')} at {proto.get('hydrateReasoningLevel')} reasoning
Authorized executor: {proto.get('executorProfile')} / {proto.get('executorModelRef')} at {proto.get('executorReasoningLevel')} reasoning
Executor selection rationale: {rationale}

Do this now:
1. Read the operator plan for product contract and the agentic companion for files/tests/verify detail. Read `.delivery/AGENT_BRIEF.md` when present.
2. Run `delivery show` and `delivery verify-implementation-profile` (retires the planning owner tab; advances hydrate-verified when this pane matches the hydrate runtime).
3. Hydrate this session from the agentic plan (delivery-hydrate prewalk should already be armed with `--delivery-hydrate --prewalk-into {prewalk_into}` targeting the authorized executor). Materialize 5–9 execution todos, note remaining risks/verification, and continue. Do not reopen product decisions; revoke readiness if the contract contradicts the repo.
4. Under D1-A, the hydrate model may perform the first successful edit/write; prewalk then transitions in-session to the authorized executor and writes `.delivery/hydrate-transition.json`. After the live runtime matches the executor, run `delivery verify-implementation-profile` again to reach executor-verified (receipt required; do not use `adopt-current-runtime` as the happy path).
5. Run `delivery stage IMPLEMENTING` only after executor-verified.
6. Execute `/skill:run-plan {plan}` through implementation, verification, reviews, completeness, and PR readiness.

Do not treat `adopt-current-runtime` as the happy-path switch; that remains for out-of-pair manual overrides only. Do not re-plan beyond the reviewed dual-plan contract."""

    return f"""You are the dedicated implementation agent for this delivery run.

Worktree: {root}
Plan: {plan}
Selected profile: {selected['profile']}
Required runtime: {selected['modelRef']} at {selected['reasoningLevel']} reasoning
Selection rationale: {rationale}

Do this now:
1. Read the full plan. Read `.delivery/AGENT_BRIEF.md` when present; if it is absent, continue from the ledger and plan rather than blocking (`delivery bootstrap --refresh` may recreate it).
2. Run `delivery show` and `delivery verify-implementation-profile` (this retires the previous planning owner tab). If the launch is still being finalized, retry verification once it reports ready. If this pane was deliberately switched to another model, run `delivery verify-implementation-profile --adopt-current-runtime --reason "..."` to record that manual choice.
3. Run `delivery stage IMPLEMENTING` from this pinned Pi runtime.
4. Execute `/skill:run-plan {plan}` through implementation, verification, Terra code review, the visible Grok completeness review, and PR readiness.

GPT-5.6 Luna at xhigh reasoning is the normal implementation profile. Use GPT-5.6 Terra at high reasoning when correctness depends materially on technical judgment beyond the available deterministic tests. The recommendation is not a prohibition: if this recorded implementation pane is deliberately switched to another model, record it with `delivery verify-implementation-profile --adopt-current-runtime --reason "..."` before code work.

Do not re-plan beyond the reviewed contract. The planning agent must not implement; you own all code, tests, fixes, Git, and PR work from this point."""


def active_implementation_launch(
    path: Path, root: Path, attempt_id: str, *, allowed_statuses: set[str]
) -> dict[str, Any]:
    current = json.loads(path.read_text())
    if current.get("stage") != "EXECUTION_READY":
        die("implementation launch authorization changed before the agent became ready")
    problem = (
        plan_readiness_request_problem(current, root)
        or plan_technical_review_problem(current, root)
        or plan_sync_problem(current, root)
        or implementation_approval_problem(current, root)
    )
    if problem:
        die(f"implementation launch authorization changed: {problem}")
    profile = current.get("implementationProfile") or {}
    if profile.get("launchAttemptId") != attempt_id:
        die("implementation launch lease was superseded or revoked")
    if str(profile.get("status")) not in allowed_statuses:
        die("implementation launch state changed before the agent became ready")
    return current


def launch_implementation_agent(
    path: Path, ledger: dict[str, Any], root: Path, args: argparse.Namespace
) -> int:
    source_pane = args.pane or resolve_herdr_targets(ledger).get("paneId")
    if not source_pane:
        reset_implementation_profile(ledger, "no Herdr source pane available")
        write_json(path, ledger)
        die("implementation launch needs --pane, HERDR_PANE_ID, or a delivery spawn pane")
    # Prefer the planning/source pane identity before owner flips to implementation.
    source_tab = discover_tab_id_for_pane(ledger, root, str(source_pane))
    if not (ledger.get("workspaceOwner") or {}).get("tabId") and source_tab:
        claim_workspace_owner(
            ledger,
            role="planning",
            tab_id=source_tab,
            pane_id=str(source_pane),
            focus=False,
        )
    reviewer_name = args.agent_name or implementation_agent_name(ledger)
    selected = approved_implementation_profile(ledger)
    prompt = implementation_agent_prompt(ledger, root)
    attempt_id = uuid.uuid4().hex
    reset_implementation_profile(ledger, "dedicated implementation agent launch in progress")
    ledger["implementationProfile"].update(
        {"status": "launching", "launchAttemptId": attempt_id, "requestLedgerRevision": int(ledger.get("ledgerRevision") or 0)}
    )
    refresh_git_fields(ledger, root)
    write_json(path, ledger)
    try:
        agent_tab = create_labeled_agent_tab(
            ledger=ledger,
            root=root,
            source_pane=str(source_pane),
            role="impl",
        )
    except SystemExit:
        current = active_implementation_launch(path, root, attempt_id, allowed_statuses={"launching"})
        reset_implementation_profile(current, "Herdr implementation tab creation failed")
        write_json(path, current)
        raise
    implementation_pane = agent_tab["paneId"]
    implementation_tab = agent_tab["tabId"]
    caller = caller_tab_id()

    herdr = require_herdr()
    start_extra = [
        "--",
        "--provider",
        selected["provider"],
        "--model",
        selected["model"],
        "--thinking",
        selected["reasoningLevel"],
    ]
    if hydrate_protocol_active(ledger):
        # Launch on Luna hydrate; arm delivery-hydrate prewalk into the authorized executor.
        proto = ledger.get("hydrateProtocol") or {}
        executor = runtime_profile(
            str(proto.get("executorModelRef") or selected["modelRef"]),
            str(proto.get("executorReasoningLevel") or selected["reasoningLevel"]),
            profile=str(proto.get("executorProfile") or "manual"),
        )
        start_extra.extend(
            [
                "--delivery-hydrate",
                "--prewalk-into",
                prewalk_into_spec_for_executor(executor),
            ]
        )
    started = start_agent_on_pane(
        root=root,
        agent_name=reviewer_name,
        pane_id=str(implementation_pane),
        timeout_ms=int(args.timeout_ms),
        extra_args=start_extra,
    )
    reconciled = False
    if started.returncode != 0:
        observed = run_cmd([herdr, "agent", "get", reviewer_name], cwd=root)
        if observed.returncode == 0:
            try:
                payload = json.loads(observed.stdout)
                agent = ((payload.get("result") or {}).get("agent") or {}) if isinstance(payload, dict) else {}
                reconciled = bool(
                    agent.get("agent") == "pi"
                    and str(agent.get("pane_id") or "") == str(implementation_pane)
                    and str(agent.get("name") or reviewer_name) == reviewer_name
                    and agent.get("agent_status") in {"idle", "done", "working", "blocked"}
                )
            except (json.JSONDecodeError, AttributeError):
                reconciled = False
    start_succeeded = started.returncode == 0 or reconciled
    current = active_implementation_launch(path, root, attempt_id, allowed_statuses={"launching"})
    profile = current.setdefault("implementationProfile", {})
    profile.update(
        {
            "status": "started" if start_succeeded else "start-failed",
            "profile": selected["profile"],
            "provider": selected["provider"],
            "model": selected["model"],
            "modelRef": selected["modelRef"],
            "reasoningLevel": selected["reasoningLevel"],
            "planSha256": plan_sha256(current, root),
            "agentName": reviewer_name,
            "paneId": str(implementation_pane),
            "tabId": implementation_tab,
            "tabLabel": agent_tab["label"],
            "sourcePaneId": str(source_pane),
            "sourceTabId": source_tab,
            "launchedAt": utc_now() if start_succeeded else None,
            "promptedAt": None,
            "launchAttemptId": attempt_id,
            "reason": None if start_succeeded else (started.stderr or started.stdout).strip(),
        }
    )
    if not start_succeeded:
        # Failed launch tabs are never the caller — close immediately (no tab museum).
        close_status = retire_tab(
            implementation_tab,
            "implementation-start-failed",
            caller_tab=caller,
        )
        if close_status == "closed":
            append_history(
                current,
                "tab_retired",
                "implementation-start-failed",
                tabId=implementation_tab,
            )
            profile["tabId"] = None
            profile["paneId"] = None
        append_history(current, "implementation_agent", f"dedicated {selected['profile']} agent start failed")
        write_json(path, current)
        die(f"could not start dedicated implementation agent: {(started.stderr or started.stdout).strip()}")
    if reconciled:
        append_history(
            current,
            "implementation_agent_reconciled",
            "Herdr reported the expected live Pi agent after the start command failed",
            agent=reviewer_name,
            paneId=str(implementation_pane),
        )
    write_json(path, current)

    requested = run_cmd([herdr, "agent", "prompt", reviewer_name, prompt], cwd=root)
    current = active_implementation_launch(path, root, attempt_id, allowed_statuses={"started"})
    profile = current["implementationProfile"]
    if requested.returncode != 0:
        profile.update(
            {
                "status": "prompt-failed",
                "reason": (requested.stderr or requested.stdout).strip(),
            }
        )
        append_history(current, "implementation_agent", f"dedicated {selected['profile']} agent prompt failed")
        write_json(path, current)
        die(f"could not prompt dedicated implementation agent: {(requested.stderr or requested.stdout).strip()}")

    profile.update({"status": "ready", "promptedAt": utc_now(), "reason": None})
    if hydrate_protocol_active(current):
        set_hydrate_protocol_phase(current, "hydrate-launched", detail="dedicated hydrate agent ready")
    # New owner is implementation. Do not self-close the planning caller tab here.
    prior_tab = source_tab or (current.get("workspaceOwner") or {}).get("tabId")
    if prior_tab and str(prior_tab) != str(implementation_tab):
        enqueue_tab_retire(current, str(prior_tab), "planning-handoff-complete")
    claim_workspace_owner(
        current,
        role="implementation",
        tab_id=implementation_tab,
        pane_id=str(implementation_pane),
        agent_name=reviewer_name,
        workspace_id=agent_tab.get("workspaceId"),
        retire_previous_reason=None,  # already enqueued explicitly above
        focus=True,
    )
    # Drain only tabs that are not the caller (failed helpers etc.).
    retire_pending_tabs(current, caller_tab=caller)
    append_history(
        current,
        "implementation_agent",
        f"dedicated {selected['profile']} implementation agent ready",
        agent=reviewer_name,
        paneId=str(implementation_pane),
        tabId=implementation_tab,
        tabLabel=agent_tab["label"],
        profile=selected["profile"],
        model=selected["modelRef"],
        reasoningLevel=selected["reasoningLevel"],
    )
    refresh_git_fields(current, root)
    write_json(path, current)
    print(
        f"implementation agent ready: {reviewer_name} in tab {implementation_tab} "
        f"({agent_tab['label']}) / pane {implementation_pane}"
    )
    print(
        "next: the pinned implementation agent verifies its profile "
        "(retires the previous owner tab) and enters IMPLEMENTING"
    )
    return 0


def cmd_approve_implementation(args: argparse.Namespace) -> int:
    _, _, root = load_ledger_for(args)
    with implementation_launch_lock(root):
        path, ledger, root = load_ledger_for(args)
        return approve_implementation_locked(args, path, ledger, root)


def approve_implementation_locked(
    args: argparse.Namespace, path: Path, ledger: dict[str, Any], root: Path
) -> int:
    if ledger.get("stage") != "EXECUTION_READY":
        die("implementation authorization is allowed only at EXECUTION_READY")
    if (ledger.get("implementationApproval") or {}).get("status") == "approved":
        die(
            "implementation is already approved; refusing to launch a second writer "
            "(use `delivery start-implementation` only when the recorded launch failed)"
        )
    readiness_problem = plan_readiness_request_problem(ledger, root)
    if readiness_problem:
        die(f"cannot approve implementation: {readiness_problem}")
    review_problem = plan_technical_review_problem(ledger, root)
    if review_problem:
        die(f"cannot approve implementation: {review_problem}")
    sync_problem = plan_sync_problem(ledger, root)
    if sync_problem:
        die(f"cannot approve implementation: {sync_problem}")
    planner_selected = selected_implementation_profile(ledger)
    requested_model = args.model or planner_selected["modelRef"]
    requested_reasoning = args.reasoning_level or planner_selected["reasoningLevel"]
    manual_override = (
        requested_model != planner_selected["modelRef"]
        or requested_reasoning != planner_selected["reasoningLevel"]
    )
    if manual_override:
        if not str(args.override_reason or "").strip():
            die("manual implementation model selection requires --override-reason")
        selected = runtime_profile(requested_model, requested_reasoning, profile="manual")
        selection_source = "manual-approval"
    else:
        selected = planner_selected
        selection_source = "planner"
    if dual_plan_mode(ledger):
        # Planner/manual selection is the executor; launch runtime is always Luna hydrate.
        ensure_hydrate_protocol(ledger, executor=selected)
    fingerprint = plan_sha256(ledger, root)
    if fingerprint is None:
        die("cannot approve implementation: recorded plan is missing, outside this worktree, or unreadable")
    approval = ledger.setdefault("implementationApproval", {})
    approval.update(
        {
            "status": "approved",
            "source": args.source,
            "planSha256": fingerprint,
            "profile": selected["profile"],
            "model": selected["modelRef"],
            "reasoningLevel": selected["reasoningLevel"],
            "selectionSource": selection_source,
            "overrideReason": args.override_reason if manual_override else None,
            "summary": args.summary,
            "approvedAt": utc_now(),
            "invalidatedAt": None,
            "reason": None,
        }
    )
    reset_implementation_profile(ledger, "implementation authorized; implementation agent launch pending")
    authorization_actor = "workflow authorized" if args.source == "workflow" else "operator approved"
    if dual_plan_mode(ledger):
        launch_label = (
            f"{selection_source} executor {selected['profile']} via "
            f"{HYDRATE_PROFILE_NAME} hydrate"
        )
    else:
        launch_label = f"{selection_source} {selected['profile']} implementation"
    append_history(
        ledger,
        "implementation_approval",
        f"{authorization_actor} {launch_label}",
        source=args.source,
        planSha256=fingerprint,
        profile=selected["profile"],
        model=selected["modelRef"],
        reasoningLevel=selected["reasoningLevel"],
        selectionSource=selection_source,
        overrideReason=args.override_reason if manual_override else None,
    )
    refresh_git_fields(ledger, root)
    write_json(path, ledger)
    print(f"implementation authorization recorded; launching {launch_label} agent")
    return launch_implementation_agent(path, ledger, root, args)


def cmd_start_implementation(args: argparse.Namespace) -> int:
    _, _, root = load_ledger_for(args)
    with implementation_launch_lock(root):
        path, ledger, root = load_ledger_for(args)
        return start_implementation_locked(args, path, ledger, root)


def start_implementation_locked(
    args: argparse.Namespace, path: Path, ledger: dict[str, Any], root: Path
) -> int:
    if ledger.get("stage") != "EXECUTION_READY":
        die("implementation agent launch is allowed only at EXECUTION_READY")
    profile_status = str((ledger.get("implementationProfile") or {}).get("status") or "pending")
    if profile_status == "ready":
        die("implementation agent is already ready; refusing to launch a second writer")
    problem = (
        plan_readiness_request_problem(ledger, root)
        or plan_technical_review_problem(ledger, root)
        or plan_sync_problem(ledger, root)
        or implementation_approval_problem(ledger, root)
    )
    if problem:
        die(f"cannot start implementation agent: {problem}")
    return launch_implementation_agent(path, ledger, root, args)


def adopt_current_implementation_runtime(
    path: Path, ledger: dict[str, Any], root: Path, reason: str
) -> None:
    if ledger.get("stage") != "EXECUTION_READY":
        die("current runtime can be adopted only at EXECUTION_READY before code work")
    if not reason.strip():
        die("adopting the current runtime requires --reason")
    problem = (
        plan_readiness_request_problem(ledger, root)
        or plan_technical_review_problem(ledger, root)
        or implementation_approval_problem(ledger, root)
        or implementation_profile_problem(ledger, root, check_runtime=False)
    )
    if problem:
        die(f"cannot adopt current implementation runtime: {problem}")
    provider = (os.environ.get("PI_PROVIDER") or "").strip()
    model = (os.environ.get("PI_MODEL") or "").strip()
    reasoning = (os.environ.get("PI_REASONING_LEVEL") or "").strip()
    pane_id = (os.environ.get("HERDR_PANE_ID") or "").strip()
    profile = ledger.get("implementationProfile") or {}
    if not provider or not model or not reasoning or not pane_id:
        die("adopting the current runtime requires PI_PROVIDER, PI_MODEL, PI_REASONING_LEVEL, and HERDR_PANE_ID")
    if pane_id != str(profile.get("paneId") or ""):
        die(
            "manual runtime adoption must occur in the already-recorded implementation pane "
            f"{profile.get('paneId')}"
        )
    adopted = runtime_profile(f"{provider}/{model}", reasoning, profile="manual")
    approval = ledger.setdefault("implementationApproval", {})
    approval.update(
        {
            "profile": "manual",
            "model": adopted["modelRef"],
            "reasoningLevel": adopted["reasoningLevel"],
            "selectionSource": "manual-runtime",
            "overrideReason": reason,
        }
    )
    profile.update(
        {
            "profile": "manual",
            "provider": adopted["provider"],
            "model": adopted["model"],
            "modelRef": adopted["modelRef"],
            "reasoningLevel": adopted["reasoningLevel"],
            "selectionSource": "manual-runtime",
            "overrideReason": reason,
        }
    )
    append_history(
        ledger,
        "implementation_runtime_override",
        reason,
        model=adopted["modelRef"],
        reasoningLevel=adopted["reasoningLevel"],
        paneId=pane_id,
    )
    refresh_git_fields(ledger, root)
    write_json(path, ledger)


def cmd_verify_implementation_profile(args: argparse.Namespace) -> int:
    path, ledger, root = load_ledger_for(args)
    if args.adopt_current_runtime:
        adopt_current_implementation_runtime(path, ledger, root, args.reason or "")
        ledger = load_json(path)
    if hydrate_protocol_active(ledger):
        proto = ledger.get("hydrateProtocol") or {}
        provider = (os.environ.get("PI_PROVIDER") or "").strip()
        model = (os.environ.get("PI_MODEL") or "").strip()
        reasoning = (os.environ.get("PI_REASONING_LEVEL") or "").strip()
        live_ref = f"{provider}/{model}" if provider and model else ""
        phase = str(proto.get("phase") or "authorized")
        hydrate_ref = str(proto.get("hydrateModelRef") or "")
        hydrate_reason = str(proto.get("hydrateReasoningLevel") or "")
        executor_ref = str(proto.get("executorModelRef") or "")
        executor_reason = str(proto.get("executorReasoningLevel") or "")
        profile = ledger.setdefault("implementationProfile", {})
        executor_phase = phase in {"hydrate-verified", "executor-armed", "executor-transitioned", "executor-verified"}
        hydrate_phase = phase in {"authorized", "hydrate-launched", "failed-transition"}
        if executor_phase and live_ref == executor_ref and reasoning == executor_reason:
            receipt_problem = hydrate_transition_receipt_problem(ledger, root, for_executor=True)
            if receipt_problem:
                die(f"cannot reach executor-verified: {receipt_problem}")
            record_hydrate_transition_receipt(ledger, root)
            if phase in {"hydrate-verified", "executor-armed", "executor-transitioned", "failed-transition"}:
                set_hydrate_protocol_phase(
                    ledger,
                    "executor-verified",
                    detail="live runtime matches authorized executor with hydrate receipt",
                )
            elif phase in {"authorized", "hydrate-launched"}:
                die(
                    "executor runtime observed before hydrate-verified; "
                    "verify on the Luna hydrate runtime first"
                )
            executor = runtime_profile(
                executor_ref,
                executor_reason,
                profile=str(proto.get("executorProfile") or "manual"),
            )
            profile.update(
                {
                    "profile": executor["profile"],
                    "provider": executor["provider"],
                    "model": executor["model"],
                    "modelRef": executor["modelRef"],
                    "reasoningLevel": executor["reasoningLevel"],
                }
            )
        elif hydrate_phase and live_ref == hydrate_ref and reasoning == hydrate_reason:
            set_hydrate_protocol_phase(ledger, "hydrate-verified", detail="live runtime matches hydrate")
            # Keep recorded launch identity on the hydrate runtime until executor transition.
            hydrate = implementation_profile_spec(HYDRATE_PROFILE_NAME)
            profile.update(
                {
                    "profile": hydrate["profile"],
                    "provider": hydrate["provider"],
                    "model": hydrate["model"],
                    "modelRef": hydrate["modelRef"],
                    "reasoningLevel": hydrate["reasoningLevel"],
                }
            )
        elif live_ref:
            set_hydrate_protocol_phase(
                ledger,
                "failed-transition",
                detail=f"live runtime {live_ref}@{reasoning} is outside authorized hydrate/executor pair",
            )
            write_json(path, ledger)
            die(
                "hydrate protocol failed-transition: live runtime is neither the authorized "
                f"hydrate ({hydrate_ref}) nor executor ({executor_ref})"
            )
    problem = (
        plan_readiness_request_problem(ledger, root)
        or plan_technical_review_problem(ledger, root)
        or plan_sync_problem(ledger, root)
        or implementation_approval_problem(ledger, root)
        or implementation_profile_problem(ledger, root, check_runtime=True)
    )
    if problem:
        die(f"implementation profile invalid: {problem}")
    if hydrate_protocol_active(ledger):
        phase = str((ledger.get("hydrateProtocol") or {}).get("phase") or "")
        if phase not in {"hydrate-verified", "executor-armed", "executor-transitioned", "executor-verified"}:
            die(
                "dual-plan hydrate protocol must reach hydrate-verified "
                "(or executor-verified after transition) before continuing"
            )
    # New owner retires previous owner tabs (planning handoff) from the impl pane.
    retire_pending_tabs(ledger, caller_tab=caller_tab_id())
    profile = ledger.get("implementationProfile") or {}
    if profile.get("tabId") and profile.get("paneId"):
        claim_workspace_owner(
            ledger,
            role="implementation",
            tab_id=str(profile.get("tabId")),
            pane_id=str(profile.get("paneId")),
            agent_name=profile.get("agentName") if isinstance(profile.get("agentName"), str) else None,
            focus=False,
        )
    refresh_git_fields(ledger, root)
    write_json(path, ledger)
    selected = approved_implementation_profile(ledger)
    proto = ledger.get("hydrateProtocol") or {}
    extra = ""
    if hydrate_protocol_active(ledger):
        extra = f" (hydrate phase={proto.get('phase')})"
    print(
        f"implementation profile verified: {selected['profile']} / "
        f"{selected['modelRef']} / {selected['reasoningLevel']}{extra}"
    )
    return 0


def cmd_revoke_implementation_approval(args: argparse.Namespace) -> int:
    path, ledger, root = load_ledger_for(args)
    profile = ledger.get("implementationProfile") or {}
    impl_tab = profile.get("tabId")
    if impl_tab:
        enqueue_tab_retire(ledger, str(impl_tab), "implementation-revoked")
    spawn = ledger.get("spawn") if isinstance(ledger.get("spawn"), dict) else {}
    planning_tab = spawn.get("tabId") or (ledger.get("implementationProfile") or {}).get("sourceTabId")
    planning_pane = spawn.get("paneId") or (ledger.get("implementationProfile") or {}).get("sourcePaneId")
    reset_implementation_approval(ledger, args.reason)
    reset_implementation_profile(ledger, args.reason)
    if planning_tab or planning_pane:
        claim_workspace_owner(
            ledger,
            role="planning",
            tab_id=str(planning_tab) if planning_tab else None,
            pane_id=str(planning_pane) if planning_pane else None,
            workspace_id=spawn.get("workspaceId"),
            focus=bool(planning_tab),
        )
    # Drain from the new planning caller when safe (not closing self).
    retire_pending_tabs(ledger, caller_tab=caller_tab_id())
    append_history(ledger, "implementation_approval_revoked", args.reason)
    refresh_git_fields(ledger, root)
    write_json(path, ledger)
    print("implementation authorization and agent profile revoked")
    return 0


def cmd_note(args: argparse.Namespace) -> int:
    path, ledger, root = load_ledger_for(args)
    text = " ".join(args.text).strip()
    if not text:
        die("note text required")
    ledger.setdefault("notes", []).append(
        {"at": utc_now(), "text": text, "stage": ledger.get("stage")}
    )
    append_history(ledger, "note", text)
    refresh_git_fields(ledger, root)
    write_json(path, ledger)
    print("noted")
    return 0


def cmd_set(args: argparse.Namespace) -> int:
    """Attach or update metadata after start (issue is optional at init)."""
    path, ledger, root = load_ledger_for(args)
    changes: list[str] = []

    if args.clear_issue:
        if ledger.get("issue") is not None:
            changes.append(f"issue: {ledger.get('issue')!r} -> None")
        ledger["issue"] = None
    elif args.issue is not None:
        issue = args.issue.strip() or None
        prev = ledger.get("issue")
        if prev != issue:
            changes.append(f"issue: {prev!r} -> {issue!r}")
        ledger["issue"] = issue

    if args.plan is not None:
        plan = args.plan.strip() or None
        prev = ledger.get("plan")
        if prev != plan:
            changes.append(f"plan: {prev!r} -> {plan!r}")
            reset_plan_readiness_request(ledger, "recorded plan path changed")
            reset_plan_technical_review(ledger, "recorded plan path changed")
            reset_plan_sync(ledger, "recorded plan path changed")
            reset_implementation_approval(ledger, "recorded plan path changed")
            reset_implementation_profile(ledger, "recorded plan path changed")
            reset_hydrate_protocol(ledger, "recorded plan path changed")
        ledger["plan"] = plan
        title_problem = plan_title_problem(ledger, root)
        if title_problem:
            print(f"warning: {title_problem}", file=sys.stderr)
        else:
            if plan:
                plan_path = Path(plan).expanduser()
                if not plan_path.is_absolute():
                    plan_path = root / plan_path
                canonical = extract_plan_title(plan_path)
                if canonical:
                    ledger["planContentTitle"] = canonical
                    labels = ledger.setdefault("labels", {})
                    if isinstance(labels, dict):
                        labels["planContentTitle"] = canonical
        # When the operator plan changes and no explicit agentic path is set,
        # adopt the derived companion path if that file already exists.
        if plan and not (isinstance(ledger.get("agenticPlan"), str) and str(ledger.get("agenticPlan")).strip()):
            derived = derive_agentic_companion_relpath(plan)
            if resolve_worktree_file(derived, root) is not None:
                ledger["agenticPlan"] = derived
                changes.append(f"agenticPlan: None -> {derived!r} (derived)")
                reset_plan_sync(ledger, "agentic companion auto-derived")

    if getattr(args, "agentic_plan", None) is not None:
        agentic = (args.agentic_plan or "").strip() or None
        prev = ledger.get("agenticPlan")
        if prev != agentic:
            changes.append(f"agenticPlan: {prev!r} -> {agentic!r}")
            reset_plan_technical_review(ledger, "recorded agentic plan path changed")
            reset_plan_sync(ledger, "recorded agentic plan path changed")
            reset_implementation_approval(ledger, "recorded agentic plan path changed")
            reset_implementation_profile(ledger, "recorded agentic plan path changed")
            reset_hydrate_protocol(ledger, "recorded agentic plan path changed")
        ledger["agenticPlan"] = agentic

    if getattr(args, "doct_title", None) is not None:
        doct_title = (args.doct_title or "").strip() or None
        prev = ledger.get("doctTitle")
        if prev != doct_title:
            changes.append(f"doctTitle: {prev!r} -> {doct_title!r}")
        ledger["doctTitle"] = doct_title
        labels = ledger.setdefault("labels", {})
        if isinstance(labels, dict):
            if doct_title:
                labels["doctTitle"] = doct_title
                labels["doctTitleSource"] = "doct"
            else:
                labels.pop("doctTitle", None)
                labels.pop("doctTitleSource", None)
        if doct_title:
            ledger["doctTitleSource"] = "doct"
        else:
            ledger.pop("doctTitleSource", None)

    if args.doct_url is not None:
        url = args.doct_url.strip() or None
        prev = ledger.get("doctUrl")
        if prev != url:
            changes.append(f"doctUrl: {prev!r} -> {url!r}")
        ledger["doctUrl"] = url

    if args.pr_url is not None:
        url = args.pr_url.strip() or None
        prev = ledger.get("prUrl")
        if prev != url:
            changes.append(f"prUrl: {prev!r} -> {url!r}")
        ledger["prUrl"] = url

    if args.slug is not None:
        slug = args.slug.strip() or None
        prev = ledger.get("slug")
        if prev != slug:
            changes.append(f"slug: {prev!r} -> {slug!r}")
        ledger["slug"] = slug

    if args.id is not None:
        new_id = args.id.strip()
        if not new_id:
            die("--id cannot be empty")
        prev = ledger.get("id")
        if prev != new_id:
            changes.append(f"id: {prev!r} -> {new_id!r}")
        ledger["id"] = new_id
    elif args.retarget_id:
        # Rebuild id from repo + issue/slug/branch once an issue arrives later.
        new_id = default_id(root, ledger.get("issue"), ledger.get("slug"))
        prev = ledger.get("id")
        if prev != new_id:
            changes.append(f"id: {prev!r} -> {new_id!r}")
        ledger["id"] = new_id

    if not changes and not any(
        [
            args.clear_issue,
            args.issue is not None,
            args.plan is not None,
            getattr(args, "agentic_plan", None) is not None,
            args.doct_url is not None,
            getattr(args, "doct_title", None) is not None,
            args.pr_url is not None,
            args.slug is not None,
            args.id is not None,
            args.retarget_id,
        ]
    ):
        die(
            "nothing to set; pass --issue, --plan, --agentic-plan, --doct-url, "
            "--doct-title, --pr-url, --slug, --id, and/or --retarget-id"
        )

    if changes:
        append_history(ledger, "set", "; ".join(changes))
    else:
        append_history(ledger, "set", "no-op (values unchanged)")

    refresh_git_fields(ledger, root)
    maybe_herdr_label(ledger)
    write_json(path, ledger)
    if changes:
        for line in changes:
            print(line)
    else:
        print("unchanged")
    print(f"id: {ledger.get('id')}")
    print(f"issue: {ledger.get('issue')}")
    return 0


def cmd_record(args: argparse.Namespace) -> int:
    key = args.key
    if key not in RECOMMENDED_EVIDENCE and key not in {"completionEval", "customerImpact"}:
        known = ", ".join(sorted(set(RECOMMENDED_EVIDENCE) | {"completionEval", "customerImpact"}))
        die(f"unknown evidence key {key!r}; known: {known}")
    status = args.status
    if status not in EVIDENCE_STATUSES:
        die(f"status must be one of {', '.join(EVIDENCE_STATUSES)}")
    path, ledger, root = load_ledger_for(args)
    now = utc_now()
    if key == "planTech":
        ev = ledger.setdefault("evidence", {}).setdefault("planTech", {})
        if status == "pass":
            if args.reviewer != PLAN_REVIEW_AGENT:
                die(f"planTech=pass requires reviewer {PLAN_REVIEW_AGENT}")
            if args.model != PLAN_REVIEW_MODEL:
                die(f"planTech=pass requires model {PLAN_REVIEW_MODEL}")
            if args.reasoning_level != PLAN_REVIEW_REASONING:
                die(f"planTech=pass requires reasoning level {PLAN_REVIEW_REASONING}")
            if args.verdict != "PLAN_EXECUTION_READY":
                die("planTech=pass requires verdict PLAN_EXECUTION_READY")
            if args.implementation_profile not in PLANNER_IMPLEMENTATION_PROFILES:
                die(
                    "planTech=pass requires a current planner implementation profile; choose from: "
                    + ", ".join(sorted(PLANNER_IMPLEMENTATION_PROFILES))
                )
            if not str(args.implementation_rationale or "").strip():
                die("planTech=pass requires --implementation-rationale for the profile decision")
            if not args.artifact:
                die("planTech=pass requires --artifact")
            artifact = Path(args.artifact).expanduser()
            if not artifact.is_absolute():
                artifact = root / artifact
            artifact = artifact.resolve()
            try:
                artifact.relative_to(root.resolve())
            except ValueError:
                die("planTech artifact must be inside the worktree")
            if not artifact.is_file():
                die("planTech artifact does not exist")
            fingerprint = plan_sha256(ledger, root)
            if fingerprint is None:
                die("cannot record planTech=pass: recorded plan is missing, outside this worktree, or unreadable")
            ev.update(
                {
                    "status": "pass",
                    "artifact": args.artifact,
                    "summary": args.summary,
                    "updatedAt": now,
                    "reviewer": args.reviewer,
                    "model": args.model,
                    "reasoningLevel": args.reasoning_level,
                    "verdict": args.verdict,
                    "implementationProfile": args.implementation_profile,
                    "implementationRationale": args.implementation_rationale,
                    "planSha256": fingerprint,
                }
            )
        else:
            if status == "gap":
                cycle_count = int(ledger.get("planReviewCycleCount") or 0)
                if cycle_count >= 3:
                    die(
                        "planning review convergence budget exhausted after three gap cycles; "
                        "record a blocker or obtain an explicit operator decision instead of launching another ordinary review"
                    )
                ledger["planReviewCycleCount"] = cycle_count + 1
            reset_plan_technical_review(ledger, args.summary or f"planTech={status}")
            ev = ledger["evidence"]["planTech"]
            ev["status"] = status
            ev["artifact"] = args.artifact
    elif key == "completionEval":
        slot = ledger.setdefault(
            "completionEval",
            {"status": "pending", "gaps": [], "summary": None},
        )
        slot["status"] = status
        if args.summary:
            slot["summary"] = args.summary
        if args.gap:
            gaps = slot.setdefault("gaps", [])
            for g in args.gap:
                if g not in gaps:
                    gaps.append(g)
        # Mirror into evidence for board uniformity.
        ev = ledger.setdefault("evidence", {}).setdefault(
            "completionEval",
            {"status": "pending", "artifact": None, "summary": None, "updatedAt": None},
        )
        ev.update(
            {
                "status": status,
                "artifact": args.artifact,
                "summary": args.summary or ev.get("summary"),
                "updatedAt": now,
            }
        )
    elif key == "customerImpact":
        slot = ledger.setdefault(
            "customerImpact",
            {"promised": [], "observed": [], "gaps": [], "summary": None},
        )
        if args.summary:
            slot["summary"] = args.summary
        if args.promised:
            slot["promised"] = list(args.promised)
        if args.observed:
            slot["observed"] = list(args.observed)
        if args.gap:
            slot["gaps"] = list(dict.fromkeys((slot.get("gaps") or []) + list(args.gap)))
        ev = ledger.setdefault("evidence", {}).setdefault(
            "customerImpact",
            {"status": "pending", "artifact": None, "summary": None, "updatedAt": None},
        )
        ev.update(
            {
                "status": status,
                "artifact": args.artifact,
                "summary": args.summary or slot.get("summary"),
                "updatedAt": now,
            }
        )
    elif key == "planSync":
        if status == "pass":
            if not dual_plan_mode(ledger):
                die(
                    "planSync=pass requires ledger.agenticPlan; "
                    "set the companion with delivery set --agentic-plan <path>"
                )
            companion = agentic_companion_problem(ledger, root)
            if companion:
                die(f"cannot record planSync=pass: {companion}")
            operator_hash, agentic_hash = operator_and_agentic_plan_sha256_pair(ledger, root)
            if operator_hash is None or agentic_hash is None:
                die(
                    "cannot record planSync=pass: both operator and agentic plans must be "
                    "readable files inside the worktree"
                )
            ev = ledger.setdefault("evidence", {}).setdefault(
                "planSync",
                {
                    "status": "pending",
                    "artifact": None,
                    "summary": None,
                    "updatedAt": None,
                    "operatorPlanSha256": None,
                    "agenticPlanSha256": None,
                },
            )
            ev.update(
                {
                    "status": "pass",
                    "artifact": args.artifact,
                    "summary": args.summary,
                    "updatedAt": now,
                    "operatorPlanSha256": operator_hash,
                    "agenticPlanSha256": agentic_hash,
                }
            )
        else:
            reset_plan_sync(ledger, args.summary or f"planSync={status}")
            ev = ledger["evidence"]["planSync"]
            ev["status"] = status
            if args.artifact is not None:
                ev["artifact"] = args.artifact
    else:
        ev = ledger.setdefault("evidence", {}).setdefault(
            key,
            {"status": "pending", "artifact": None, "summary": None, "updatedAt": None},
        )
        ev["status"] = status
        if args.artifact is not None:
            ev["artifact"] = args.artifact
        if args.summary is not None:
            ev["summary"] = args.summary
        ev["updatedAt"] = now
        if key == "planReadinessRequest":
            ev["planSha256"] = plan_sha256(ledger, root) if status == "pass" else None
            if status == "pass" and ev["planSha256"] is None:
                die("cannot record planReadinessRequest=pass: recorded plan is missing, outside this worktree, or unreadable")
            if status == "pass":
                reset_plan_technical_review(ledger, "fresh execution-ready review request")
                reset_plan_sync(ledger, "fresh execution-ready review request")
                reset_implementation_approval(ledger, "fresh execution-ready review request")
                reset_implementation_profile(ledger, "fresh execution-ready review request")

    if args.pr_url:
        ledger["prUrl"] = args.pr_url
    if args.doct_url:
        ledger["doctUrl"] = args.doct_url
    if args.plan:
        if ledger.get("plan") != args.plan:
            reset_plan_readiness_request(ledger, "recorded plan path changed")
            reset_plan_technical_review(ledger, "recorded plan path changed")
            reset_plan_sync(ledger, "recorded plan path changed")
            reset_implementation_approval(ledger, "recorded plan path changed")
            reset_implementation_profile(ledger, "recorded plan path changed")
            reset_hydrate_protocol(ledger, "recorded plan path changed")
        ledger["plan"] = args.plan
        title_problem = plan_title_problem(ledger, root)
        if title_problem:
            print(f"warning: {title_problem}", file=sys.stderr)
        else:
            plan_path = Path(args.plan)
            if not plan_path.is_absolute():
                plan_path = root / plan_path
            canonical = extract_plan_title(plan_path)
            if canonical:
                ledger["planContentTitle"] = canonical
                labels = ledger.setdefault("labels", {})
                if isinstance(labels, dict):
                    labels["planContentTitle"] = canonical

    append_history(ledger, "record", f"{key}={status}", key=key, status=status)
    refresh_git_fields(ledger, root)
    write_json(path, ledger)
    print(f"recorded {key}={status}")
    return 0


COMPLETENESS_REVIEW_MODEL = "xai/grok-4.5:high"


def completeness_reviewer_name(ledger: dict[str, Any]) -> str:
    identity = str(ledger.get("issue") or ledger.get("slug") or ledger.get("id") or "delivery")
    return f"completeness-{slugify(identity, max_len=19, keep_issue_keys=True)}"

def completeness_review_prompt(ledger: dict[str, Any], root: Path, *, rerun: bool, request_id: str) -> str:
    plan = str(ledger.get("plan") or "(no plan path recorded)")
    round_text = "This is a rereview after the driving agent addressed prior findings." if rerun else "This is the initial completeness review."
    return f"""You are the visible, read-only plan-completeness reviewer for this delivery run.

{round_text}
Worktree: {root}
Plan: {plan}
Delivery stage: {ledger.get('stage')}
Completeness-review request ID: {request_id}

Inspect the current live worktree, including committed, staged, unstaged, and untracked changes. Read the plan, diff, plan-progress/validation artifacts, and the driving agent's stated verification evidence. Do not edit files. Do not run tests, builds, linters, or other executable verification.

Check whether the implementation is complete according to the plan: every acceptance criterion and BDD scenario, required producer/consumer or cross-surface wiring, real post-mutation UI states, stated non-goals, and truthful verification. Do not accept a green helper/unit test as proof that the user-visible completion state works.

When the worktree is Heddle or has a local permanent-docs skill, also require a durable-outcome coverage row:

| Durable outcome in this PR slice | Disposition (`none`/`patch`/`new-record`/`ADR`/`deferred-to-final-plan-slice`) | Permanent home | In diff? |

Reject hollow permanent docs (empty templates, TODO-only bodies, or “see plan” stubs) for `patch` / `new-record` / `ADR`. Do not require CCore archive packages or plan-source deletion. Missing or false disposition is FINDINGS_TO_RESOLVE unless an explicit operator waiver is disclosed.

Start your response with `COMPLETENESS_REVIEW_RESPONSE_ID: {request_id}`, immediately followed by your verdict. Return exactly one verdict:
- VERDICT: FINDINGS_TO_RESOLVE — for an in-plan gap, with criterion/BDD reference, concrete evidence, user impact, and smallest correction.
- VERDICT: COMPLETE — only when the plan is complete by substance. Include an AC/BDD coverage table and a `Not examined:` line.
- VERDICT: BLOCKED_BY_QUESTION — only for a real plan or product decision.

The driving agent will read your visible response, make in-scope corrections, and ask you to rereview until the implementation and this review agree it is complete."""


def _fingerprint_paths(root: Path, paths: list[str], digest: Any, exclude_paths: set[str] | None = None) -> None:
    for raw in sorted(paths):
        if raw == ".delivery" or raw.startswith(".delivery/") or raw in (exclude_paths or set()):
            continue
        candidate = root / raw
        digest.update(raw.encode("utf-8") + b"\0")
        if candidate.is_file():
            digest.update(candidate.read_bytes())
        else:
            digest.update(b"<missing>")


def working_tree_fingerprint(root: Path, *, exclude_paths: set[str] | None = None) -> str:
    """Fingerprint worktree content independently of whether it has been committed."""
    digest = hashlib.sha256()
    tracked = run_cmd(["git", "ls-files", "-z"], cwd=root)
    if tracked.returncode != 0:
        die("cannot list tracked files for completeness review")
    untracked = run_cmd(["git", "ls-files", "--others", "--exclude-standard", "-z"], cwd=root)
    if untracked.returncode != 0:
        die("cannot list untracked files for completeness review")
    _fingerprint_paths(
        root,
        [part for part in tracked.stdout.split("\0") if part]
        + [part for part in untracked.stdout.split("\0") if part],
        digest,
        exclude_paths,
    )
    return digest.hexdigest()


def completeness_review_problem(ledger: dict[str, Any], root: Path) -> str | None:
    review = ledger.get("completenessReview") or {}
    if review.get("status") == "waived" and review.get("summary"):
        return None
    if review.get("status") != "complete":
        return "visible completeness review has not been accepted"
    if review.get("verdict") != "COMPLETE":
        return "visible completeness review did not return VERDICT: COMPLETE"
    artifact = review.get("artifact")
    if not isinstance(artifact, str) or not (root / artifact).is_file():
        return "visible completeness review artifact is missing"
    if is_omp_lite(ledger):
        try:
            artifact_path = (root / artifact).resolve()
            artifact_path.relative_to(root.resolve())
            artifact_bytes = artifact_path.read_bytes()
            values = parse_omp_completeness_artifact(artifact_bytes.decode("ascii"))
        except (OSError, UnicodeDecodeError, ValueError):
            return "OMP completeness review artifact is malformed"
        if review.get("artifactSha256") != hashlib.sha256(artifact_bytes).hexdigest():
            return "OMP completeness review artifact has changed since acceptance"
        expected_envelope = {
            "COMPLETENESS_REVIEW_RESPONSE_ID": review.get("responseId"),
            "REVIEWER_IDENTITY": review.get("reviewerIdentity"),
            "PLAN_SHA256": review.get("planSha256"),
            "WORKTREE_FINGERPRINT": review.get("worktreeFingerprint"),
            "VERDICT": "COMPLETE",
        }
        if any(values.get(key) != value for key, value in expected_envelope.items()):
            return "OMP completeness review artifact does not match the accepted response"
    plan_fingerprint = plan_sha256(ledger, root)
    if not plan_fingerprint or review.get("planSha256") != plan_fingerprint:
        return "visible completeness review is stale for the current plan"
    excluded = {artifact} if review.get("responseId") else None
    if review.get("worktreeFingerprint") != working_tree_fingerprint(root, exclude_paths=excluded):
        return "visible completeness review is stale for the current worktree"
    return None


def completion_artifact_path(root: Path, ledger: dict[str, Any], requested: str | None) -> tuple[Path, str]:
    slug = slugify(str(ledger.get("slug") or ledger.get("issue") or "delivery"))
    raw = Path(requested or f"thoughts/validation/{slug}-completeness.md")
    candidate = raw if raw.is_absolute() else root / raw
    try:
        resolved = candidate.resolve()
        relative = resolved.relative_to(root.resolve())
    except ValueError:
        die("completeness review artifact must be inside the worktree")
    return resolved, relative.as_posix()


def pi_session_transcript(path: Path, *, max_lines: int = 500) -> str:
    """Extract bounded assistant text from a Pi JSONL session without terminal wrapping."""
    messages: list[str] = []
    with path.open(encoding="utf-8") as handle:
        for raw in handle:
            try:
                event = json.loads(raw)
            except json.JSONDecodeError:
                continue
            message = event.get("message") if event.get("type") == "message" else None
            if not isinstance(message, dict) or message.get("role") != "assistant":
                continue
            content = message.get("content")
            if not isinstance(content, list):
                continue
            text = "\n".join(
                item.get("text", "")
                for item in content
                if isinstance(item, dict) and item.get("type") == "text" and isinstance(item.get("text"), str)
            )
            if text:
                messages.append(text)
    return "\n".join("\n".join(messages).splitlines()[-max_lines:]) + "\n"


def read_completeness_transcript(reviewer_name: str, root: Path, request_id: str) -> str:
    rendered = run_cmd(["herdr", "agent", "read", reviewer_name, "--source", "recent-unwrapped", "--lines", "500"], cwd=root)
    if rendered.returncode != 0:
        die(f"could not read visible completeness reviewer: {(rendered.stderr or rendered.stdout).strip()}")
    if request_id in rendered.stdout:
        return rendered.stdout
    details = run_cmd(["herdr", "agent", "get", reviewer_name], cwd=root)
    if details.returncode != 0:
        return rendered.stdout
    try:
        payload = json.loads(details.stdout)
        result = payload.get("result") if isinstance(payload.get("result"), dict) else payload
        agent = result.get("agent") if isinstance(result.get("agent"), dict) else result
        session = agent.get("agent_session") if isinstance(agent, dict) else None
        raw_path = session.get("value") if isinstance(session, dict) and session.get("agent") == "pi" else None
        if not isinstance(raw_path, str):
            return rendered.stdout
        session_path = Path(raw_path).expanduser().resolve()
        sessions_root = (Path(os.environ.get("PI_CODING_AGENT_DIR", Path.home() / ".pi" / "agent")) / "sessions").resolve()
        session_path.relative_to(sessions_root)
        if not session_path.is_file():
            return rendered.stdout
        exact = pi_session_transcript(session_path)
        return exact if request_id in exact else rendered.stdout
    except (OSError, ValueError, json.JSONDecodeError, AttributeError):
        return rendered.stdout


def parse_completeness_transcript(text: str, request_id: str) -> dict[str, Any]:
    lines = text.splitlines()
    id_label = re.compile(r"^\s*COMPLETENESS_REVIEW_RESPONSE_ID:\s*(.*?)\s*$")
    verdict_label = re.compile(r"^\s*VERDICT:\s*(.*?)\s*$")
    valid_id = re.compile(r"^[0-9a-f]{32}$")
    allowed = {"FINDINGS_TO_RESOLVE", "COMPLETE", "BLOCKED_BY_QUESTION"}
    starts = [index for index, line in enumerate(lines) if id_label.match(line)]
    blocks: list[dict[str, Any]] = []
    for position, start in enumerate(starts):
        end = starts[position + 1] if position + 1 < len(starts) else len(lines)
        match = id_label.match(lines[start]); raw_id = (match.group(1) if match else "").strip()
        id_line = start
        if not raw_id:
            cursor = start + 1
            while cursor < end and not lines[cursor].strip(): cursor += 1
            if cursor < end: raw_id = lines[cursor].strip(); id_line = cursor
        verdicts = []
        for cursor in range(id_line + 1, end):
            verdict_match = verdict_label.match(lines[cursor])
            if not verdict_match: continue
            raw_verdict = verdict_match.group(1).strip()
            if not raw_verdict:
                following = cursor + 1
                while following < end and not lines[following].strip(): following += 1
                if following < end: raw_verdict = lines[following].strip()
            verdicts.append(raw_verdict if raw_verdict in allowed else "INVALID:" + raw_verdict)
        blocks.append({"id": raw_id if valid_id.fullmatch(raw_id) else None, "rawId": raw_id, "startLine": start + 1, "endLine": end, "verdicts": verdicts})
    current = [block for block in blocks if block["id"] == request_id]
    visible = [block["id"] or block["rawId"] for block in blocks]
    first_nonempty = next((line.strip() for line in lines if line.strip()), "")
    likely_truncated = bool(first_nonempty and not id_label.match(first_nonempty) and ("VERDICT:" in first_nonempty or bool(starts)))
    result = {"blocks": blocks, "currentBlocks": current, "visibleIds": visible, "likelyTruncated": likely_truncated, "accepted": False, "verdict": None, "diagnostic": ""}
    if not current:
        result["diagnostic"] = f"current response ID {request_id} missing; visible IDs={visible or ['none']}; likelyTruncated={likely_truncated}"
        return result
    latest = current[-1]; result["selectedRange"] = [latest["startLine"], latest["endLine"]]; result["duplicateCount"] = len(current)
    if len(latest["verdicts"]) != 1:
        result["diagnostic"] = f"current response block lines {latest['startLine']}-{latest['endLine']} has {len(latest['verdicts'])} parsed verdicts; duplicateBlocks={len(current)}; likelyTruncated={likely_truncated}"
        return result
    verdict = latest["verdicts"][0]; result["verdict"] = verdict
    if verdict != "COMPLETE":
        result["diagnostic"] = f"latest current response block lines {latest['startLine']}-{latest['endLine']} verdict={verdict}; duplicateBlocks={len(current)}"
        return result
    result["accepted"] = True
    result["diagnostic"] = f"accepted latest current response block lines {latest['startLine']}-{latest['endLine']}; duplicateBlocks={len(current)}"
    return result


def cmd_record_receipt(args: argparse.Namespace) -> int:
    path, ledger, root = load_ledger_for(args)
    artifact = Path(args.artifact).expanduser()
    if not artifact.is_absolute():
        artifact = (root / artifact).resolve()


    try:
        receipt = json.loads(artifact.read_text(encoding="utf-8"))
    except FileNotFoundError:
        die(f"receipt artifact not found: {artifact}")
    except json.JSONDecodeError as exc:
        die(f"invalid receipt JSON in {artifact}: {exc}")
    required = {"schemaVersion", "command", "mode", "status", "startedAt", "finishedAt", "cwd", "repoRoot", "managedSurfaceManifest", "transportProbe", "hosts", "warnings", "rollback"}
    missing = sorted(required - set(receipt)) if isinstance(receipt, dict) else sorted(required)
    if missing or receipt.get("schemaVersion") != 1:
        die(f"receipt does not satisfy install summary schema v1; missing={missing}")
    if args.command and receipt.get("command") != args.command:
        die(f"receipt command mismatch: expected {args.command}, got {receipt.get('command')}")
    digest = hashlib.sha256(artifact.read_bytes()).hexdigest()
    reference = {
        "artifact": str(artifact),
        "sha256": digest,
        "command": receipt.get("command"),
        "mode": receipt.get("mode"),
        "status": receipt.get("status"),
        "transportStatus": (receipt.get("transportProbe") or {}).get("status"),
        "recordedAt": utc_now(),
    }
    ledger.setdefault("receipts", []).append(reference)
    ledger["updatedAt"] = utc_now()
    ledger.setdefault("history", []).append({"at": utc_now(), "type": "receipt", "stage": ledger.get("stage"), "detail": f"{reference['command']} {reference['status']}: {artifact}"})
    write_json(path, ledger)
    if getattr(args, "json", False):
        print(json.dumps(reference, indent=2))
    else:
        print(f"recorded receipt: {artifact} ({reference['status']})")
    return 0
OMP_COMPLETENESS_OPEN = "<!-- OMP_COMPLETENESS_RESPONSE -->"
OMP_COMPLETENESS_CLOSE = "<!-- /OMP_COMPLETENESS_RESPONSE -->"
OMP_COMPLETENESS_REVIEWER_IDENTITY = "omp-completeness-grok-4.5-high"
OMP_COMPLETENESS_FIELDS = (
    "COMPLETENESS_REVIEW_RESPONSE_ID",
    "REVIEWER_IDENTITY",
    "PLAN_SHA256",
    "WORKTREE_FINGERPRINT",
    "VERDICT",
)


def omp_completion_artifact_path(root: Path, ledger: dict[str, Any], requested: str | None) -> tuple[Path, str]:
    slug = slugify(str(ledger.get("slug") or ledger.get("issue") or "delivery"))
    raw = Path(requested or f"thoughts/validation/{slug}-completeness-review.md")
    candidate = raw if raw.is_absolute() else root / raw
    try:
        resolved = candidate.resolve()
        relative = resolved.relative_to(root.resolve())
    except ValueError:
        die("completeness review artifact must be inside the worktree")
    return resolved, relative.as_posix()


def parse_omp_completeness_artifact(text: str) -> dict[str, str]:
    if not text.isascii():
        raise ValueError("OMP completeness artifact must be ASCII")
    lines = text.splitlines(keepends=True)
    if len(lines) < 7 or any(not line.endswith("\n") or line.endswith("\r\n") for line in lines[:7]):
        raise ValueError("OMP completeness artifact must begin with exactly seven LF-terminated envelope lines")
    envelope = [line[:-1] for line in lines[:7]]
    patterns = (
        re.compile(r"^COMPLETENESS_REVIEW_RESPONSE_ID: ([0-9a-f]{32})$"),
        re.compile(r"^REVIEWER_IDENTITY: ([A-Za-z0-9._-]+)$"),
        re.compile(r"^PLAN_SHA256: ([0-9a-f]{64})$"),
        re.compile(r"^WORKTREE_FINGERPRINT: ([0-9a-f]{64})$"),
        re.compile(r"^VERDICT: (COMPLETE|INCOMPLETE)$"),
    )
    if envelope[0] != OMP_COMPLETENESS_OPEN or envelope[6] != OMP_COMPLETENESS_CLOSE:
        raise ValueError("OMP completeness artifact has an invalid envelope delimiter")
    values: dict[str, str] = {}
    for label, line, pattern in zip(OMP_COMPLETENESS_FIELDS, envelope[1:6], patterns):
        match = pattern.fullmatch(line)
        if not match:
            raise ValueError(f"OMP completeness artifact has invalid {label} line")
        values[label] = match.group(1)
    for field in OMP_COMPLETENESS_FIELDS:
        if text.count(field) != 1:
            raise ValueError(f"OMP completeness artifact must contain {field} exactly once in its opening envelope")
    return values


def cmd_omp_completion_review(args: argparse.Namespace, path: Path, ledger: dict[str, Any], root: Path) -> int:
    if args.waive or args.rerun:
        die("OMP Lite completeness uses --prepare and --accept; Pi reviewer controls are unavailable")
    if args.prepare:
        prior_pending = ledger.get("pendingCompletenessReview")
        plan_fingerprint = plan_sha256(ledger, root)
        if not plan_fingerprint:
            die("OMP completeness review requires a readable plan inside the worktree")
        if (
            args.reviewer_identity is not None
            and args.reviewer_identity != OMP_COMPLETENESS_REVIEWER_IDENTITY
        ):
            die(
                "OMP completeness reviewer identity must be "
                f"`{OMP_COMPLETENESS_REVIEWER_IDENTITY}`"
            )
        reviewer = OMP_COMPLETENESS_REVIEWER_IDENTITY
        request_id = uuid.uuid4().hex
        artifact_path, artifact_rel = omp_completion_artifact_path(root, ledger, args.artifact)
        pending = {
            "responseId": request_id,
            "reviewerIdentity": reviewer,
            "planSha256": plan_fingerprint,
            "worktreeFingerprint": working_tree_fingerprint(root, exclude_paths={artifact_rel}),
            "artifact": artifact_rel,
            "requestedAt": utc_now(),
        }
        ledger["pendingCompletenessReview"] = pending
        ledger.setdefault("evidence", {}).setdefault("completenessReview", {}).update(
            {"status": "pending", "updatedAt": utc_now()}
        )
        if isinstance(prior_pending, dict):
            append_history(
                ledger,
                "completeness_review",
                "superseded pending OMP reviewer packet",
                responseId=prior_pending.get("responseId"),
            )
        append_history(ledger, "completeness_review", "OMP reviewer packet prepared", responseId=request_id)
        refresh_git_fields(ledger, root)
        write_json(path, ledger)
        packet = {
            "runtime": "omp",
            "reviewer": reviewer,
            "responseId": request_id,
            "artifact": artifact_rel,
            "acceptCommand": f"delivery completion-review --accept --response-id {request_id}",
            "requiredEnvelope": [
                OMP_COMPLETENESS_OPEN,
                f"COMPLETENESS_REVIEW_RESPONSE_ID: {request_id}",
                f"REVIEWER_IDENTITY: {reviewer}",
                f"PLAN_SHA256: {plan_fingerprint}",
                f"WORKTREE_FINGERPRINT: {pending['worktreeFingerprint']}",
                "VERDICT: COMPLETE",
                OMP_COMPLETENESS_CLOSE,
            ],
        }
        print(json.dumps(packet, indent=2))
        return 0
    if not args.accept:
        die("OMP Lite completeness requires --prepare or --accept")
    pending = ledger.get("pendingCompletenessReview")
    if not isinstance(pending, dict):
        die("no OMP completeness request is pending; run `delivery completion-review --prepare`")
    if args.response_id != pending.get("responseId"):
        die("OMP completeness response ID does not match the pending request; rerun `delivery completion-review --prepare`")
    artifact_path, artifact_rel = omp_completion_artifact_path(root, ledger, pending.get("artifact"))
    if args.artifact is not None:
        _, requested_rel = omp_completion_artifact_path(root, ledger, args.artifact)
        if requested_rel != artifact_rel:
            die("OMP completeness artifact does not match the pending request; rerun `delivery completion-review --prepare`")
    try:
        artifact_bytes = artifact_path.read_bytes()
        values = parse_omp_completeness_artifact(artifact_bytes.decode("ascii"))
    except FileNotFoundError:
        die("OMP completeness artifact is missing; rerun the OMP reviewer")
    except (UnicodeDecodeError, ValueError) as exc:
        die(str(exc))
    expected = {
        "COMPLETENESS_REVIEW_RESPONSE_ID": pending.get("responseId"),
        "REVIEWER_IDENTITY": pending.get("reviewerIdentity"),
        "PLAN_SHA256": plan_sha256(ledger, root),
        "WORKTREE_FINGERPRINT": working_tree_fingerprint(root, exclude_paths={artifact_rel}),
    }
    if any(values.get(key) != value for key, value in expected.items()) or values["VERDICT"] != "COMPLETE":
        die("OMP completeness artifact does not match the pending current request; rerun `delivery completion-review --prepare`")
    del ledger["pendingCompletenessReview"]
    ledger["completenessReview"] = {
        "status": "complete",
        "verdict": "COMPLETE",
        "artifact": artifact_rel,
        "artifactSha256": hashlib.sha256(artifact_bytes).hexdigest(),
        "responseId": values["COMPLETENESS_REVIEW_RESPONSE_ID"],
        "reviewerIdentity": values["REVIEWER_IDENTITY"],
        "planSha256": values["PLAN_SHA256"],
        "worktreeFingerprint": values["WORKTREE_FINGERPRINT"],
        "acceptedAt": utc_now(),
    }
    ledger.setdefault("evidence", {}).setdefault("completenessReview", {}).update(
        {"status": "pass", "artifact": artifact_rel, "summary": "OMP reviewer returned COMPLETE", "updatedAt": utc_now()}
    )
    append_history(ledger, "completeness_review", "OMP completeness review accepted", artifact=artifact_rel)
    refresh_git_fields(ledger, root)
    write_json(path, ledger)
    print(f"OMP completeness review accepted -> {artifact_rel}")
    return 0


def cmd_completion_review(args: argparse.Namespace) -> int:
    """Launch, rerequest, or accept the visible labeled-tab Pi completeness review."""
    path, ledger, root = load_ledger_for(args)
    if is_omp_lite(ledger):
        return cmd_omp_completion_review(args, path, ledger, root)
    labels = ledger.get("labels") or {}
    review = ledger.get("completenessReview") or {}
    source_pane = args.pane or os.environ.get("HERDR_PANE_ID") or labels.get("herdrPaneId")
    reviewer_name = args.agent_name or review.get("agentName") or completeness_reviewer_name(ledger)

    if args.waive:
        if not args.summary:
            die("completion-review --waive requires --summary describing the direct operator waiver")
        witness_tab = review.get("tabId")
        ledger["completenessReview"] = {"status": "waived", "summary": args.summary, "waivedAt": utc_now()}
        append_history(ledger, "completeness_review", "operator waived visible completeness review")
        if witness_tab:
            enqueue_tab_retire(ledger, str(witness_tab), "completeness-waived")
            retire_pending_tabs(ledger, caller_tab=caller_tab_id())
        refresh_git_fields(ledger, root)
        write_json(path, ledger)
        print("visible completeness review waived")
        return 0

    if args.accept:
        reviewer_pane = review.get("paneId")
        if not reviewer_pane:
            die("no visible completeness reviewer is recorded; run `delivery completion-review` first")
        plan_fingerprint = plan_sha256(ledger, root)
        if not plan_fingerprint:
            die("cannot accept completeness review: recorded plan is missing, outside this worktree, or unreadable")
        if review.get("planSha256") != plan_fingerprint or review.get("worktreeFingerprint") != working_tree_fingerprint(root):
            die("cannot accept completeness review: request is stale for the current plan or worktree; run `delivery completion-review --rerun`")
        request_id = review.get("requestId")
        if not isinstance(request_id, str) or not request_id:
            die("recorded completeness review has no request ID; run `delivery completion-review --rerun`")
        transcript = read_completeness_transcript(reviewer_name, root, request_id)
        parsed = parse_completeness_transcript(transcript, request_id)
        verdict = parsed.get("verdict")
        if not parsed.get("accepted"):
            die("visible reviewer completeness response rejected: " + str(parsed.get("diagnostic")) + "; address findings and run `delivery completion-review --rerun`")
        artifact_path, artifact_rel = completion_artifact_path(root, ledger, args.artifact)
        artifact_path.parent.mkdir(parents=True, exist_ok=True)
        artifact_transcript = "\n".join(line.rstrip() for line in transcript.splitlines()) + "\n"
        artifact_path.write_text(
            f"# Visible completeness review\n\n- Reviewer: {reviewer_name}\n- Model: {COMPLETENESS_REVIEW_MODEL}\n- Accepted: {utc_now()}\n\n## Transcript\n\n{artifact_transcript}",
            encoding="utf-8",
        )
        witness_tab = review.get("tabId")
        ledger["completenessReview"] = {
            **review,
            "status": "complete",
            "verdict": verdict,
            "artifact": artifact_rel,
            "planSha256": plan_fingerprint,
            "worktreeFingerprint": working_tree_fingerprint(root),
            "acceptedAt": utc_now(),
        }
        ev = ledger.setdefault("evidence", {}).setdefault("completenessReview", {})
        ev.update({"status": "pass", "artifact": artifact_rel, "summary": "Visible Grok 4.5 reviewer returned COMPLETE", "updatedAt": utc_now()})
        append_history(ledger, "completeness_review", "visible Grok 4.5 review accepted", agent=reviewer_name, paneId=str(reviewer_pane), artifact=artifact_rel)
        if witness_tab:
            enqueue_tab_retire(ledger, str(witness_tab), "completeness-accepted")
            retire_pending_tabs(ledger, caller_tab=caller_tab_id())
        refresh_git_fields(ledger, root)
        write_json(path, ledger)
        print(f"visible completeness review accepted -> {artifact_rel}")
        return 0

    if not source_pane:
        die("completion-review needs --pane, HERDR_PANE_ID, or a delivery spawn pane")
    request_id = uuid.uuid4().hex
    prompt = completeness_review_prompt(ledger, root, rerun=bool(args.rerun), request_id=request_id)
    start_command = [
        "herdr", "agent", "start", reviewer_name, "--kind", "pi", "--pane", "<reviewer-pane>",
        "--timeout", str(args.timeout_ms), "--", "--model", COMPLETENESS_REVIEW_MODEL,
    ]

    if args.dry_run:
        workspace_id = resolve_workspace_id(ledger, str(source_pane))
        label = agent_tab_label("complete", ledger)
        print(json.dumps({
            "sourcePane": source_pane,
            "reviewerName": reviewer_name,
            "model": COMPLETENESS_REVIEW_MODEL,
            "rerun": bool(args.rerun),
            "tabCreateCommand": ["herdr", *build_tab_create_command(workspace_id, root, label)],
            "startCommand": start_command,
            "prompt": prompt,
        }, indent=2))
        return 0

    if args.rerun:
        reviewer_pane = review.get("paneId")
        if not reviewer_pane:
            die("no visible completeness reviewer is recorded; run `delivery completion-review` first")
        reviewer_tab = review.get("tabId")
        if not reviewer_tab:
            die(
                "recorded completeness reviewer has no tab metadata; run `delivery completion-review` "
                "without --rerun to create a fresh labeled tab"
            )
        agent_tab = {
            "paneId": str(reviewer_pane),
            "tabId": str(reviewer_tab),
            "label": str(review.get("tabLabel") or agent_tab_label("complete", ledger)),
        }
    else:
        agent_tab = create_labeled_agent_tab(
            ledger=ledger,
            root=root,
            source_pane=str(source_pane),
            role="complete",
        )
        reviewer_pane = agent_tab["paneId"]
        started = start_agent_on_pane(
            root=root,
            agent_name=reviewer_name,
            pane_id=str(reviewer_pane),
            timeout_ms=int(args.timeout_ms),
            extra_args=["--", "--model", COMPLETENESS_REVIEW_MODEL],
        )
        if started.returncode != 0:
            detail = (started.stderr or started.stdout).strip()
            close_status = retire_tab(
                agent_tab["tabId"],
                "completeness-start-failed",
                caller_tab=caller_tab_id(),
            )
            if close_status == "closed":
                append_history(
                    ledger,
                    "tab_retired",
                    "completeness-start-failed",
                    tabId=agent_tab["tabId"],
                )
                write_json(path, ledger)
            die(f"could not start visible completeness reviewer: {detail}")

    requested = run_cmd(["herdr", "agent", "prompt", reviewer_name, prompt], cwd=root)
    if requested.returncode != 0:
        die(f"could not prompt visible completeness reviewer: {(requested.stderr or requested.stdout).strip()}")

    ledger["completenessReview"] = {
        "status": "pending",
        "agentName": reviewer_name,
        "paneId": str(reviewer_pane),
        "tabId": agent_tab["tabId"],
        "tabLabel": agent_tab["label"],
        "model": COMPLETENESS_REVIEW_MODEL,
        "requestId": request_id,
        "requestLedgerRevision": int(ledger.get("ledgerRevision") or 0),
        "planSha256": plan_sha256(ledger, root),
        "worktreeFingerprint": working_tree_fingerprint(root),
        "lastRequestedAt": utc_now(),
        "round": int(review.get("round") or 0) + 1,
    }
    ledger.setdefault("evidence", {}).setdefault("completenessReview", {}).update({"status": "pending", "updatedAt": utc_now()})
    append_history(
        ledger,
        "completeness_review",
        "visible Grok 4.5 review requested",
        agent=reviewer_name,
        paneId=str(reviewer_pane),
        tabId=agent_tab["tabId"],
        tabLabel=agent_tab["label"],
        rerun=bool(args.rerun),
    )
    refresh_git_fields(ledger, root)
    write_json(path, ledger)
    print(
        f"visible completeness reviewer: {reviewer_name} in tab {agent_tab['tabId']} "
        f"({agent_tab['label']}) / pane {reviewer_pane}"
    )
    print("next: read the reviewer response, fix any in-plan findings, then run `delivery completion-review --rerun`; after COMPLETE run `delivery completion-review --accept`")
    return 0


def cmd_blocker(args: argparse.Namespace) -> int:
    path, ledger, root = load_ledger_for(args)
    text = " ".join(args.text).strip()
    if args.clear:
        ledger["blockers"] = []
        if ledger.get("stage") == "BLOCKED" and args.stage:
            if args.stage not in STAGES:
                die(f"unknown stage {args.stage!r}")
            if args.stage == "EXECUTION_READY":
                die("clear the blocker first, then run `delivery stage EXECUTION_READY` so automatic authorization and launch cannot be bypassed")
            transition_problem = stage_transition_problem(ledger, root, args.stage)
            if transition_problem:
                die(f"cannot restore {args.stage}: {transition_problem}")
            previous = ledger["stage"]
            ledger["stage"] = args.stage
            append_history(ledger, "stage", f"{previous} -> {args.stage}")
        append_history(ledger, "blocker_clear", "blockers cleared")
    elif text:
        ledger.setdefault("blockers", []).append({"at": utc_now(), "text": text})
        if args.mark_blocked:
            ledger["stage"] = "BLOCKED"
        append_history(ledger, "blocker", text)
    else:
        die("provide blocker text or --clear")
    refresh_git_fields(ledger, root)
    maybe_herdr_label(ledger)
    write_json(path, ledger)
    print("ok")
    return 0


def build_advisories(
    ledger: dict[str, Any], root: Path | None = None
) -> list[dict[str, str]]:
    stage = str(ledger.get("stage") or "INTAKE")
    advisories: list[dict[str, str]] = []
    evidence = ledger.get("evidence") or {}
    worktree = root
    if worktree is None:
        raw_worktree = ledger.get("worktree")
        worktree = Path(raw_worktree) if isinstance(raw_worktree, str) and raw_worktree.strip() else Path.cwd()

    def add(code: str, message: str, severity: str = "info") -> None:
        advisories.append({"code": code, "severity": severity, "message": message})

    add("NEXT", STAGE_NEXT_SKILL.get(stage, "No mapped next skill"), "info")

    title_problem = plan_title_problem(ledger, worktree)
    if title_problem and stage not in {"INTAKE", "DONE"}:
        add("PLAN_TITLE", title_problem, "warn")

    if stage == "EXECUTION_READY":
        approval_problem = implementation_approval_problem(ledger, worktree)
        if approval_problem:
            add(
                "IMPLEMENTATION_APPROVAL",
                "Implementation is paused: "
                f"{approval_problem}. Present the operator summary and wait for approval.",
                "warn",
            )

    for key, stages in RECOMMENDED_EVIDENCE.items():
        if stage not in stages:
            continue
        slot = evidence.get(key) or {}
        status = slot.get("status") or "pending"
        if status in {"pass", "skip", "na"}:
            continue
        if status == "gap":
            add(
                f"GAP_{key}",
                f"Recommended evidence '{key}' is marked gap"
                + (f": {slot.get('summary')}" if slot.get("summary") else ""),
                "warn",
            )
        else:
            add(
                f"MISSING_{key}",
                f"Recommended evidence '{key}' is {status} at stage {stage}. "
                f"Record with: delivery record {key} --status pass|skip|gap|na",
                "warn",
            )

    # Completion / customer impact soft prompts near the end of the cycle.
    if stage in {"IMPL_PM_OUTCOME", "AUTOREVIEW", "VERIFY_FRESHNESS", "PR_OPEN", "MERGE_READY"}:
        ce = ledger.get("completionEval") or {}
        if (ce.get("status") or "pending") in {"pending", "gap"}:
            add(
                "COMPLETION_EVAL",
                "Consider a completion evaluation against plan AC/BDD/progress before calling the work done.",
                "warn",
            )
        ci = ledger.get("customerImpact") or {}
        if not ci.get("summary") and not (ci.get("promised") or ci.get("observed")):
            if (evidence.get("customerImpact") or {}).get("status") not in {"pass", "skip", "na"}:
                add(
                    "CUSTOMER_IMPACT",
                    "Consider recording customer/operator impact promised vs observed "
                    "(delivery record customerImpact --status pass --summary '...').",
                    "warn",
                )

    if stage in {"MERGE_READY", "PR_OPEN", "ADVERSARIAL_QA", "DONE"}:
        aq = evidence.get("adversarialQa") or {}
        if (aq.get("status") or "pending") == "pending":
            add(
                "QA_OPTIONAL",
                "If this change touches a customer-visible path, consider adversarial golden-path QA "
                "(/qa:run) or record adversarialQa --status na.",
                "info",
            )

    if ledger.get("blockers"):
        add("BLOCKERS", f"{len(ledger['blockers'])} blocker note(s) present", "warn")

    if not ledger.get("plan") and stage not in {"INTAKE", "DONE"}:
        add("PLAN_PATH", "No plan path recorded yet (delivery record plan via --plan on record/init).", "info")

    companion_problem = agentic_companion_problem(ledger, root)
    if companion_problem:
        add(
            "AGENTIC_COMPANION",
            companion_problem,
            "warn" if stage in {"PLAN_TECH_REVIEW", "EXECUTION_READY", "IMPLEMENTING"} else "info",
        )
    if stage in {"REFLECT", "DONE", "MERGE_READY", "PR_OPEN", "BLOCKED"} and not ledger.get(
        "lastReflectionAt"
    ):
        add(
            "REFLECT",
            "No end-of-run reflection logged yet. "
            "Recommended: delivery reflect --trigger end-of-run --friction '...' "
            "--improvement '...' --mark-done  (writes ~/.pi/DELIVERY_REFLECTIONS.md).",
            "info" if stage in {"PR_OPEN", "MERGE_READY"} else "warn",
        )

    return advisories


def cmd_check(args: argparse.Namespace) -> int:
    path, ledger, root = load_ledger_for(args)
    refresh_git_fields(ledger, root)
    advisories = build_advisories(ledger, root)
    ledger["advisories"] = advisories
    ledger["updatedAt"] = utc_now()
    # Persist latest advisories for board visibility; never fail on gaps.
    write_json(path, ledger)

    payload = {
        "id": ledger.get("id"),
        "stage": ledger.get("stage"),
        "path": str(path),
        "doctrine": "guidance-not-gates",
        "hardBlock": False,
        "advisories": advisories,
        "next": STAGE_NEXT_SKILL.get(str(ledger.get("stage")), None),
    }
    if args.json:
        print(json.dumps(payload, indent=2))
    else:
        print(f"stage: {ledger.get('stage')}  (guidance only; never hard-blocks)")
        print(f"next:  {payload['next']}")
        warns = [a for a in advisories if a.get("severity") == "warn"]
        infos = [a for a in advisories if a.get("severity") != "warn"]
        if warns:
            print("advisories:")
            for a in warns:
                print(f"  ! [{a['code']}] {a['message']}")
        if infos and args.verbose:
            print("info:")
            for a in infos:
                print(f"  - [{a['code']}] {a['message']}")
        elif not warns:
            print("advisories: none beyond next-step guidance")
        print("exit: 0 (gaps do not block continuation)")
    # Doctrine: always succeed.
    return 0


def iter_ledger_paths(extra_roots: list[Path] | None = None) -> list[Path]:
    found: list[Path] = []
    seen: set[Path] = set()

    def add(path: Path) -> None:
        path = path.resolve()
        if path in seen or not path.is_file():
            return
        seen.add(path)
        found.append(path)

    cwd_ledger = detect_repo_root() / LEDGER_REL
    add(cwd_ledger)

    if HERDR_WORKTREES.is_dir():
        for path in HERDR_WORKTREES.glob("*/*/.delivery/ledger.json"):
            add(path)

    for root in extra_roots or []:
        add(Path(root) / LEDGER_REL)

    return found


def summarize_ledger(path: Path) -> dict[str, Any] | None:
    try:
        ledger = load_json(path)
    except SystemExit:
        return None
    return {
        "id": ledger.get("id"),
        "stage": ledger.get("stage"),
        "issue": ledger.get("issue"),
        "runtime": ledger.get("runtime"),
        "workflowProfile": ledger.get("workflowProfile"),
        "phaseCode": phase_code(str(ledger.get("stage")), ledger.get("workflowProfile")),
        "plan": ledger.get("plan"),
        "branch": ledger.get("branch"),
        "worktree": ledger.get("worktree") or str(path.parent.parent),
        "prUrl": ledger.get("prUrl"),
        "updatedAt": ledger.get("updatedAt"),
        "blockers": len(ledger.get("blockers") or []),
        "path": str(path),
        "next": next_step_for(str(ledger.get("stage")), ledger.get("workflowProfile")),
    }


def cmd_board(args: argparse.Namespace) -> int:
    paths = iter_ledger_paths([Path(p) for p in (args.root or [])])
    rows = []
    for path in paths:
        row = summarize_ledger(path)
        if row:
            rows.append(row)
    # Active first (not DONE), then newest updatedAt.
    rows.sort(
        key=lambda r: (
            0 if r.get("stage") != "DONE" else 1,
            -_parse_ts(r.get("updatedAt")),
            str(r.get("id") or ""),
        )
    )

    if args.json:
        print(json.dumps({"count": len(rows), "runs": rows}, indent=2))
        return 0

    if not rows:
        print("no delivery ledgers found")
        print(f"scanned: cwd, {HERDR_WORKTREES}/*/*/.delivery/ledger.json")
        return 0

    # Simple table
    print(f"{'STAGE':<18} {'PHASE':<6} {'RUNTIME':<8} {'PROFILE':<12} {'ISSUE':<14} {'ID':<28} {'UPDATED':<22} PATH")
    for r in rows:
        print(
            f"{str(r.get('stage') or '-'):<18} "
            f"{str(r.get('phaseCode') or '-'):<6} "
            f"{str(r.get('runtime') or '-'):<8} "
            f"{str(r.get('workflowProfile') or '-'):<12} "
            f"{str(r.get('issue') or '-'):<14} "
            f"{str(r.get('id') or '-'):<28} "
            f"{str(r.get('updatedAt') or '-'):<22} "
            f"{r.get('path')}"
        )
    return 0


def _parse_ts(value: Any) -> float:
    if not value or not isinstance(value, str):
        return 0.0
    try:
        cleaned = value.replace("Z", "+00:00")
        return datetime.fromisoformat(cleaned).timestamp()
    except ValueError:
        return 0.0


def cmd_status(args: argparse.Namespace) -> int:
    # Alias: single-run show if ledger present, else board.
    root = Path(args.cwd).resolve() if args.cwd else detect_repo_root()
    path = find_ledger_path(root, args.ledger)
    if path.exists() and not args.all:
        args.json = args.json
        return cmd_show(args)
    return cmd_board(args)


def cmd_stages(args: argparse.Namespace) -> int:
    profile = None
    root = Path(args.cwd).resolve() if args.cwd else detect_repo_root()
    path = find_ledger_path(root, getattr(args, "ledger", None))
    if path.exists():
        ledger = load_json(path)
        backfill_legacy_runtime_profile(path, ledger, root)
        profile = ledger.get("workflowProfile")
    print(f"runtime profile: {profile or 'unbound'}")
    print(f"{'STAGE':<22} {'CODE':<5} NEXT")
    for stage in STAGES:
        if profile == "omp-lite" and stage in {"ADVERSARIAL_QA", "REFLECT"}:
            continue
        code = phase_code(stage, profile)
        print(f"{stage:<22} {code:<5} {next_step_for(stage, profile)}")
    return 0


ISSUE_KEY_RE = re.compile(r"\b([A-Za-z][A-Za-z0-9]*-\d+)\b")


def extract_issue_key(text: str) -> str | None:
    """Best-effort Linear-style key from freeform operator text."""
    if not text:
        return None
    matches = ISSUE_KEY_RE.findall(text)
    if not matches:
        return None
    # Prefer the first KEY-123 form; normalize to uppercase.
    return matches[0].upper()


def strip_issue_keys(text: str) -> str:
    """Remove issue keys so slug/label come from the intent words."""
    cleaned = ISSUE_KEY_RE.sub(" ", text or "")
    cleaned = re.sub(
        r"\b(linear|issue|ticket)\b[:\s]*", " ", cleaned, flags=re.IGNORECASE
    )
    return re.sub(r"\s+", " ", cleaned).strip()


def slugify(text: str, *, max_len: int = 48, keep_issue_keys: bool = False) -> str:
    raw = (text or "").strip()
    if not keep_issue_keys:
        raw = strip_issue_keys(raw)
    raw = raw.lower()
    # drop common stop-ish prefixes operators type when asking
    raw = re.sub(
        r"^(please\s+)?(help\s+me\s+)?(can\s+you\s+)?(to\s+)?",
        "",
        raw,
    )
    raw = re.sub(
        r"^(fix|implement|build|add|make|create|ship|start|spawn)\s+",
        "",
        raw,
    )
    raw = raw.replace("&", " and ")
    raw = re.sub(r"[^a-z0-9]+", "-", raw)
    raw = re.sub(r"-+", "-", raw).strip("-")
    if not raw:
        raw = "delivery"
    if len(raw) > max_len:
        raw = raw[:max_len].rstrip("-")
    return raw or "delivery"


def short_label(text: str, *, max_len: int = 36) -> str:
    text = re.sub(r"\s+", " ", (text or "").strip())
    if len(text) <= max_len:
        return text or "delivery"
    cut = text[: max_len - 1].rsplit(" ", 1)[0]
    return (cut or text[: max_len - 1]).rstrip() + "…"


def run_cmd(
    args: list[str],
    *,
    cwd: Path | None = None,
    check: bool = False,
    env: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    merged = os.environ.copy()
    if env:
        merged.update(env)
    return subprocess.run(
        args,
        cwd=str(cwd) if cwd else None,
        check=check,
        capture_output=True,
        text=True,
        env=merged,
    )


def require_herdr() -> str:
    path = shutil.which("herdr")
    if not path:
        die("herdr not found on PATH; install/start Herdr before delivery spawn")
    return path


def herdr_json(args: list[str], *, cwd: Path | None = None) -> dict[str, Any]:
    herdr = require_herdr()
    proc = run_cmd([herdr, *args], cwd=cwd)
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or "").strip()
        die(f"herdr {' '.join(args)} failed ({proc.returncode}): {detail}")
    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        die(f"herdr returned non-JSON: {exc}\n{proc.stdout[:500]}")
    if not isinstance(payload, dict):
        die("herdr JSON root must be an object")
    return payload


def unique_branch_name(repo: Path, base_slug: str, issue: str | None) -> str:
    if issue:
        # Keep TEAM-123 form; do not strip issue keys here.
        issue_slug = slugify(issue, max_len=32, keep_issue_keys=True)
        candidate = issue_slug
    else:
        candidate = base_slug
    # Prefer short delivery/ prefix only when no issue, to avoid colliding with mainline names.
    if not issue:
        candidate = f"delivery/{candidate}"

    def exists(name: str) -> bool:
        local = run_cmd(["git", "show-ref", "--verify", "--quiet", f"refs/heads/{name}"], cwd=repo)
        remote = run_cmd(
            ["git", "show-ref", "--verify", "--quiet", f"refs/remotes/origin/{name}"],
            cwd=repo,
        )
        return local.returncode == 0 or remote.returncode == 0

    if not exists(candidate):
        return candidate
    suffix = datetime.now(timezone.utc).strftime("%m%d%H%M")
    alt = f"{candidate}-{suffix}"
    if not exists(alt):
        return alt
    return f"{candidate}-{int(time.time()) % 100000}"


def default_spawn_agent_name(workspace_id: str | None) -> str:
    """Create a unique, Herdr-valid agent name for a new delivery workspace."""
    if workspace_id:
        # Workspace IDs are opaque and can contain uppercase characters, while
        # Herdr agent names permit only lowercase letters, digits, '-' and '_'.
        # Hex encoding preserves the exact workspace identity without collisions.
        token = str(workspace_id).encode("utf-8").hex()
        name = f"delivery-{token}"
        if len(name) <= 32:
            return name
    # Worktree creation normally returns a short workspace ID. Retain collision
    # safety if an older response omits it or exceeds Herdr's name-length limit.
    return f"delivery-{uuid.uuid4().hex[:23]}"


def agent_start_prompt(
    goal: str,
    *,
    issue: str | None,
    worktree: str,
    workflow_profile: str,
) -> str:
    issue_line = (
        f"Linear issue is attached as {issue}."
        if issue
        else "Linear issue is optional; if one appears later run: delivery set --issue KEY --retarget-id"
    )
    if workflow_profile == "omp-lite":
        route = (
            "3. Continue in this same OMP session through normal-mode planning, implementation, "
            "PM outcome review, autoreview, OMP completeness review, verification, and PR.\n"
            "   Never launch Pi or hand implementation to another agent. At completeness, run "
            "`delivery completion-review --prepare --reviewer-identity "
            "omp-completeness-grok-4.5-high`, send its packet to `@completeness` "
            "(xai/grok-4.5:high), write the exact response artifact, then run "
            "`delivery completion-review --accept`.\n"
            "4. Keep the delivery ledger current with `delivery stage` / `delivery record`.\n"
            "5. Reflection and adversarial QA are optional and never gate OMP completion.\n"
        )
    else:
        route = (
            "3. Continue from the current state's recommended next step using existing worker skills\n"
            "   (reviewed-html-plan / dev-plan → Luna-xhigh/Terra-high profile decision → GPT-5.6 Luna at xhigh "
            "or Terra high for judgment-heavy work → Terra autoreview → Grok completeness → PR).\n"
            "   During `PLAN_BROWSER_REVIEW`, integrate ordinary feedback but wait for Doct's explicit\n"
            "   `Request execution-ready review` action before PM or technical readiness review.\n"
            "4. Keep the delivery ledger current with `delivery stage` / `delivery record`.\n"
            "5. Before finishing: `delivery reflect --trigger end-of-run --friction '...' "
            "--improvement '...' --mark-done`.\n"
        )
    return (
        "You were spawned into a fresh Herdr delivery worktree.\n\n"
        f"Worktree: {worktree}\n"
        f"Goal: {goal}\n"
        f"{issue_line}\n\n"
        "Do this now:\n"
        "1. Read `.delivery/AGENT_BRIEF.md` when present. If it is absent, continue from "
        "`delivery show`, the ledger, and the plan; `delivery bootstrap --refresh` may recreate it.\n"
        "2. Run `delivery show` and `delivery check -v`.\n"
        f"{route}\n"
        "Doctrine: guidance, not gates. Missing delivery evidence is advisory only — "
        "never hard-block the operator solely because a recommended check is pending.\n"
    )


def cmd_spawn(args: argparse.Namespace) -> int:
    """Create a Herdr worktree named from the goal and bootstrap delivery there."""
    goal_parts = [p for p in (args.goal or []) if p and p != "--"]
    # Drop a leading bare flag fragment if REMAINDER captured options incorrectly.
    while goal_parts and goal_parts[0] in {"-", "--"}:
        goal_parts.pop(0)
    goal = " ".join(goal_parts).strip()
    if not goal:
        die('goal text required, e.g. delivery spawn "honest auto-sync status"')

    repo = Path(args.cwd).resolve() if args.cwd else detect_repo_root()
    if not (repo / ".git").exists() and not (repo / ".git").is_file():
        # allow worktree paths that point at linked git via rev-parse
        top = git_capture(repo, "rev-parse", "--show-toplevel")
        if not top:
            die(f"not a git repo: {repo}")
        repo = Path(top)

    # Freeform-first: operators paste a request; agents/flags only override.
    inferred_issue = extract_issue_key(goal)
    issue = (args.issue.strip().upper() if args.issue else None) or inferred_issue
    intent_text = strip_issue_keys(goal) or goal
    slug = slugify(args.slug) if args.slug else slugify(intent_text)
    branch = args.branch or unique_branch_name(repo, slug, issue)
    label_basis = intent_text if intent_text else goal
    label = args.label or (
        f"{issue} · {short_label(label_basis, max_len=28)}"
        if issue
        else short_label(label_basis)
    )
    base = args.base or "origin/main"
    focus = bool(args.focus)
    requested_stage = args.stage or "INTAKE"
    runtime, workflow_profile, _ = resolve_runtime_profile(
        None,
        runtime=getattr(args, "runtime", None),
        workflow_profile=getattr(args, "workflow_profile", None),
    )
    if args.agent and args.agent != runtime:
        die(
            f"agent kind {args.agent!r} conflicts with immutable runtime {runtime!r}; "
            f"use `--agent {runtime}` or omit --agent"
        )
    if requested_stage not in STAGES:
        die(f"unknown stage {requested_stage!r}; choose from: {', '.join(STAGES)}")
    stage_probe = {
        "stage": requested_stage,
        "plan": args.plan,
        "evidence": empty_evidence(),
        "implementationApproval": {"status": "pending"},
    }
    transition_problem = stage_transition_problem(stage_probe, repo, requested_stage)
    if transition_problem:
        die(
            f"cannot initialize at {requested_stage}: {transition_problem}. "
            "Create the worktree at INTAKE and advance through delivery's guarded steps."
        )

    # Ensure base exists when possible (non-fatal if offline).
    base_ok = run_cmd(["git", "rev-parse", "--verify", f"{base}^{{commit}}"], cwd=repo)
    if base_ok.returncode != 0:
        fetch = run_cmd(["git", "fetch", "--prune", "--tags"], cwd=repo)
        if fetch.returncode != 0:
            die(
                f"base ref {base!r} not found and git fetch failed: "
                f"{(fetch.stderr or fetch.stdout or '').strip()}"
            )
        base_ok = run_cmd(["git", "rev-parse", "--verify", f"{base}^{{commit}}"], cwd=repo)
        if base_ok.returncode != 0:
            die(f"base ref {base!r} still not found after fetch")

    if args.dry_run:
        preview_stage = requested_stage
        preview_ledger = {
            "issue": issue,
            "slug": slug,
            "goal": goal,
            "stage": preview_stage,
            "labels": {"baseTitle": sanitize_base_title(label)},
            "spawn": {"label": label},
            "runtime": runtime,
            "workflowProfile": workflow_profile,
        }
        payload = {
            "dryRun": True,
            "repo": str(repo),
            "goal": goal,
            "intent": intent_text,
            "issue": issue,
            "issueInferred": bool(inferred_issue) and not bool(args.issue),
            "slug": slug,
            "branch": branch,
            "label": herdr_display_label(preview_ledger),
            "baseTitle": sanitize_base_title(label),
            "phaseCode": phase_code(preview_stage, workflow_profile),
            "base": base,
            "focus": focus,
            "agent": None if args.no_agent else (args.agent or runtime),
        }
        print(json.dumps(payload, indent=2))
        return 0

    create_args = [
        "worktree",
        "create",
        "--cwd",
        str(repo),
        "--branch",
        branch,
        "--base",
        base,
        "--label",
        label,
    ]
    if args.path:
        create_args.extend(["--path", str(Path(args.path).expanduser())])
    create_args.append("--focus" if focus else "--no-focus")

    created = herdr_json(create_args)
    result = created.get("result") if isinstance(created.get("result"), dict) else created
    root_pane = result.get("root_pane") or {}
    workspace = result.get("workspace") or {}
    worktree = result.get("worktree") or {}
    tab = result.get("tab") or {}

    worktree_path = (
        worktree.get("path")
        or (workspace.get("worktree") or {}).get("checkout_path")
        or root_pane.get("cwd")
    )
    if not worktree_path:
        die(f"herdr create succeeded but no worktree path in response: {created}")
    worktree_path = str(worktree_path)
    pane_id = root_pane.get("pane_id")
    tab_id = tab.get("tab_id") or root_pane.get("tab_id")
    workspace_id = (
        workspace.get("workspace_id")
        or root_pane.get("workspace_id")
        or worktree.get("open_workspace_id")
    )

    # Bootstrap delivery navigator inside the new worktree (in-process).
    boot_ns = argparse.Namespace(
        cwd=worktree_path,
        ledger=None,
        json=False,
        issue=issue,
        slug=slug,
        plan=args.plan,
        doct_url=None,
        pr_url=None,
        goal=goal,
        stage=args.stage or "INTAKE",
        id=None,
        retarget_id=bool(issue),
        refresh=False,
        force=False,
        runtime=runtime,
        workflow_profile=workflow_profile,
    )
    # Bootstrap runs in this parent process, whose HERDR_* variables still
    # identify the caller. Suppress its best-effort label sync; spawn applies
    # the label to the explicit destination IDs after recording them.
    bootstrap_skip = os.environ.get("DELIVERY_SKIP_HERDR")
    os.environ["DELIVERY_SKIP_HERDR"] = "1"
    try:
        # bootstrap prints a long brief; capture by temporarily redirecting if quiet
        if args.quiet:
            import io
            from contextlib import redirect_stdout

            buf = io.StringIO()
            with redirect_stdout(buf):
                cmd_bootstrap(boot_ns)
        else:
            print("--- delivery bootstrap ---")
            cmd_bootstrap(boot_ns)
    finally:
        if bootstrap_skip is None:
            os.environ.pop("DELIVERY_SKIP_HERDR", None)
        else:
            os.environ["DELIVERY_SKIP_HERDR"] = bootstrap_skip

    agent_name = None
    agent_kind = None
    prompted = False
    agent_status = None
    if not args.no_agent:
        agent_kind = args.agent or runtime
        agent_name = args.agent_name or default_spawn_agent_name(workspace_id)
        if not pane_id:
            agent_status = "skipped-no-pane"
            print("delivery spawn: no pane id from herdr; skipped agent start", file=sys.stderr)
        else:
            start = run_cmd(
                [
                    "herdr",
                    "agent",
                    "start",
                    agent_name,
                    "--kind",
                    agent_kind,
                    "--pane",
                    str(pane_id),
                    "--timeout",
                    str(args.agent_timeout_ms),
                ]
            )
            if start.returncode != 0:
                agent_status = "start-failed"
                print(
                    "delivery spawn: herdr agent start failed; worktree+bootstrap are ready.\n"
                    f"{(start.stderr or start.stdout or '').strip()}",
                    file=sys.stderr,
                )
            else:
                prompt = agent_start_prompt(
                    goal,
                    issue=issue,
                    worktree=worktree_path,
                    workflow_profile=workflow_profile,
                )
                prompt_cmd = [
                    "herdr",
                    "agent",
                    "prompt",
                    agent_name,
                    prompt,
                ]
                if args.wait_agent:
                    prompt_cmd.extend(
                        [
                            "--wait",
                            "--until",
                            "idle",
                            "--until",
                            "done",
                            "--until",
                            "blocked",
                            "--timeout",
                            str(args.wait_timeout_ms),
                        ]
                    )
                pr = run_cmd(prompt_cmd)
                prompted = pr.returncode == 0
                agent_status = "prompted" if prompted else "prompt-failed"
                if pr.returncode != 0:
                    print(
                        "delivery spawn: agent started but initial prompt failed.\n"
                        f"{(pr.stderr or pr.stdout or '').strip()}\n"
                        "Paste /delivery:bootstrap manually in the pane.",
                        file=sys.stderr,
                    )

    summary = {
        "goal": goal,
        "issue": issue,
        "runtime": runtime,
        "workflowProfile": workflow_profile,
        "slug": slug,
        "branch": branch,
        "label": label,
        "base": base,
        "repo": str(repo),
        "worktree": worktree_path,
        "workspaceId": workspace_id,
        "tabId": tab_id,
        "paneId": pane_id,
        "ledger": str(Path(worktree_path) / LEDGER_REL),
        "brief": str(Path(worktree_path) / ".delivery" / "AGENT_BRIEF.md"),
        "agent": {
            "name": agent_name,
            "kind": agent_kind,
            "prompted": prompted,
            "status": agent_status,
        }
        if not args.no_agent
        else None,
        "next": "Open the Herdr workspace and let the agent follow .delivery/AGENT_BRIEF.md",
    }

    # Record spawn + apply phase-prefixed Herdr space/tab labels.
    display_label = label
    ledger_path = Path(worktree_path) / LEDGER_REL
    if ledger_path.exists():
        ledger = load_json(ledger_path)
        ledger["spawn"] = {
            "at": utc_now(),
            "branch": branch,
            "label": label,
            "workspaceId": workspace_id,
            "tabId": tab_id,
            "paneId": pane_id,
            "fromRepo": str(repo),
        }
        labels = ledger.setdefault("labels", {})
        labels["baseTitle"] = sanitize_base_title(label)
        if workspace_id:
            labels["herdrWorkspaceId"] = str(workspace_id)
        if tab_id:
            labels["herdrTabId"] = str(tab_id)
        if pane_id:
            labels["herdrPaneId"] = str(pane_id)
        append_history(ledger, "spawn", f"herdr worktree {branch}")
        # Temporarily allow herdr renames even if parent had SKIP set for tests.
        prev_skip = os.environ.get("DELIVERY_SKIP_HERDR")
        if args.dry_run:
            pass
        else:
            # Spawn always attempts label sync for the new workspace.
            os.environ.pop("DELIVERY_SKIP_HERDR", None)
            try:
                claim_workspace_owner(
                    ledger,
                    role="planning",
                    tab_id=str(tab_id) if tab_id else None,
                    pane_id=str(pane_id) if pane_id else None,
                    agent_name=agent_name,
                    workspace_id=str(workspace_id) if workspace_id else None,
                    focus=False,
                )
            finally:
                if prev_skip is not None:
                    os.environ["DELIVERY_SKIP_HERDR"] = prev_skip
        display_label = str((ledger.get("labels") or {}).get("herdr") or herdr_display_label(ledger))
        write_json(ledger_path, ledger)
    else:
        # Fallback rename without ledger.
        display_label = f"{phase_code(args.stage or 'INTAKE')}: {sanitize_base_title(label)}"
        if workspace_id:
            run_cmd(["herdr", "workspace", "rename", str(workspace_id), display_label])
        if tab_id:
            run_cmd(["herdr", "tab", "rename", str(tab_id), display_label])

    summary["label"] = display_label
    summary["phaseCode"] = phase_code(args.stage or "INTAKE")

    if args.json:
        print(json.dumps(summary, indent=2))
    else:
        print("delivery spawn ready")
        print(f"goal:      {goal}")
        print(f"label:     {display_label}")
        print(f"branch:    {branch}")
        print(f"worktree:  {worktree_path}")
        print(f"workspace: {workspace_id}")
        print(f"pane:      {pane_id}")
        print(f"brief:     {summary['brief']}")
        if summary.get("agent"):
            print(f"agent:     {agent_kind}:{agent_name} ({agent_status})")
        print("next:      watch the Herdr workspace; agent should follow AGENT_BRIEF.md")
    return 0


def _reflect_timestamp(now: datetime | None = None) -> str:
    now = now or datetime.now().astimezone()
    return (
        f"{str(now.year)[-2:]}-{now.month:02d}-{now.day:02d} "
        f"{now.hour:02d}:{now.minute:02d}"
    )


def _split_items(values: list[str] | None, freeform: str | None = None) -> list[str]:
    items: list[str] = []
    for value in values or []:
        text = value.strip()
        if text:
            items.append(text)
    if freeform:
        text = freeform.strip()
        if text:
            items.append(text)
    # de-dupe preserving order
    seen: set[str] = set()
    out: list[str] = []
    for item in items:
        if item in seen:
            continue
        seen.add(item)
        out.append(item)
    return out


def append_reflection(
    *,
    ledger: dict[str, Any] | None,
    friction: list[str],
    rework: list[str],
    improvements: list[str],
    notes: list[str],
    trigger: str | None,
    outcome: str | None,
) -> dict[str, Any]:
    if not any([friction, rework, improvements, notes, outcome]):
        die(
            "reflect needs at least one of --friction, --rework, --improvement, "
            "--note, --outcome, or freeform text"
        )

    ts = _reflect_timestamp()
    ledger = ledger or {}
    title_bits = [
        str(ledger.get("id") or "untracked"),
        str(ledger.get("stage") or ""),
    ]
    if trigger:
        title_bits.append(trigger)
    title = " · ".join(b for b in title_bits if b)

    md_lines = [f"## {ts} — {title}", ""]
    meta = {
        "id": ledger.get("id"),
        "issue": ledger.get("issue"),
        "slug": ledger.get("slug"),
        "stage": ledger.get("stage"),
        "plan": ledger.get("plan"),
        "prUrl": ledger.get("prUrl"),
        "worktree": ledger.get("worktree"),
        "branch": ledger.get("branch"),
        "outcome": outcome,
        "trigger": trigger,
    }
    md_lines.append("| Field | Value |")
    md_lines.append("|---|---|")
    for key, label in [
        ("id", "id"),
        ("issue", "issue"),
        ("slug", "slug"),
        ("stage", "stage"),
        ("plan", "plan"),
        ("prUrl", "pr"),
        ("worktree", "worktree"),
        ("branch", "branch"),
        ("outcome", "outcome"),
        ("trigger", "trigger"),
    ]:
        val = meta.get(key)
        if val:
            md_lines.append(f"| {label} | {val} |")
    md_lines.append("")

    def section(name: str, items: list[str]) -> None:
        if not items:
            return
        md_lines.append(f"### {name}")
        md_lines.append("")
        for item in items:
            md_lines.append(f"- {item}")
        md_lines.append("")

    section("Friction", friction)
    section("Rework challenges", rework)
    section("Improvement opportunities", improvements)
    section("Notes", notes)

    entry_md = "\n".join(md_lines).rstrip() + "\n\n"
    record = {
        "ts": utc_now(),
        "localTs": ts,
        "trigger": trigger,
        "outcome": outcome,
        "friction": friction,
        "rework": rework,
        "improvements": improvements,
        "notes": notes,
        "delivery": {
            "id": ledger.get("id"),
            "issue": ledger.get("issue"),
            "slug": ledger.get("slug"),
            "stage": ledger.get("stage"),
            "plan": ledger.get("plan"),
            "prUrl": ledger.get("prUrl"),
            "worktree": ledger.get("worktree"),
            "branch": ledger.get("branch"),
            "goal": ledger.get("goal"),
        },
    }

    PI_HOME.mkdir(parents=True, exist_ok=True)
    if not REFLECTIONS_MD.exists():
        REFLECTIONS_MD.write_text(REFLECTIONS_HEADING, encoding="utf-8")
    with REFLECTIONS_MD.open("a", encoding="utf-8") as fh:
        fh.write(entry_md)
    with REFLECTIONS_JSONL.open("a", encoding="utf-8") as fh:
        fh.write(json.dumps(record, ensure_ascii=False) + "\n")

    return {
        "markdownPath": str(REFLECTIONS_MD),
        "jsonlPath": str(REFLECTIONS_JSONL),
        "timestamp": ts,
        "record": record,
    }


def cmd_reflect(args: argparse.Namespace) -> int:
    """Append an end-of-run reflection outside the worktree (~/.pi)."""
    ledger: dict[str, Any] | None = None
    path: Path | None = None
    root = Path(args.cwd).resolve() if args.cwd else detect_repo_root()
    candidate = find_ledger_path(root, args.ledger)
    if candidate.exists():
        path = candidate
        ledger = load_json(path)
        refresh_git_fields(ledger, root)
    elif not args.allow_untracked:
        die(
            f"no ledger at {candidate}; skip reflection unless delivery is already armed, "
            "or pass --allow-untracked to log without a ledger. Do not bootstrap or init delivery."
        )

    if args.list:
        if not REFLECTIONS_MD.exists():
            print(f"no reflections yet at {REFLECTIONS_MD}")
            return 0
        text = REFLECTIONS_MD.read_text(encoding="utf-8")
        # print last N heading blocks roughly
        chunks = [c for c in text.split("\n## ") if c.strip()]
        # first chunk may be title
        entries = []
        for i, chunk in enumerate(chunks):
            if i == 0 and chunk.lstrip().startswith("# DELIVERY"):
                continue
            entries.append("## " + chunk if not chunk.startswith("## ") else chunk)
        tail = entries[-args.list :]
        print("\n".join(t.rstrip() for t in tail) if tail else "(no entries)")
        print(f"\nlog: {REFLECTIONS_MD}")
        return 0

    freeform = " ".join(args.text).strip() if args.text else ""
    # strip leading -- leftovers from REMAINDER usage
    if freeform.startswith("--"):
        freeform = ""

    friction = _split_items(args.friction)
    rework = _split_items(args.rework)
    improvements = _split_items(args.improvement)
    notes = _split_items(args.note)
    if freeform:
        notes = _split_items(notes, freeform)

    omp_optional = ledger is not None and is_omp_lite(ledger)
    if args.mark_done and ledger is not None and not omp_optional:
        done_problem = terminal_stage_problem(ledger, root, "DONE")
        if done_problem:
            die(f"cannot enter DONE: {done_problem}")

    result = append_reflection(
        ledger=ledger,
        friction=friction,
        rework=rework,
        improvements=improvements,
        notes=notes,
        trigger=args.trigger,
        outcome=args.outcome,
    )

    if ledger is not None and path is not None:
        ledger.setdefault("reflections", []).append(
            {
                "at": utc_now(),
                "timestamp": result["timestamp"],
                "markdownPath": result["markdownPath"],
                "jsonlPath": result["jsonlPath"],
                "trigger": args.trigger,
                "outcome": args.outcome,
            }
        )
        # Keep only recent pointers in-worktree; full text lives in ~/.pi.
        if len(ledger["reflections"]) > 20:
            ledger["reflections"] = ledger["reflections"][-20:]
        ledger["lastReflectionAt"] = utc_now()
        append_history(
            ledger,
            "reflect",
            args.trigger or args.outcome or "reflection logged",
            path=result["markdownPath"],
        )
        if args.mark_done and not omp_optional and ledger.get("stage") != "DONE":
            prev = ledger.get("stage")
            ledger["stage"] = "DONE"
            append_history(ledger, "stage", f"{prev} -> DONE")
        elif ledger.get("stage") not in {"DONE", "BLOCKED", "REFLECT"}:
            # Soft nudge into REFLECT without forcing DONE.
            if args.stage_reflect and not omp_optional:
                prev = ledger.get("stage")
                ledger["stage"] = "REFLECT"
                append_history(ledger, "stage", f"{prev} -> REFLECT")
        maybe_herdr_label(ledger)
        write_json(path, ledger)

    if args.json:
        print(json.dumps(result, indent=2))
    else:
        print(f"reflected -> {result['markdownPath']}")
        print(f"jsonl     -> {result['jsonlPath']}")
        print(f"timestamp: {result['timestamp']}")
        if args.mark_done and not omp_optional:
            print("stage: DONE")
        elif args.mark_done and omp_optional:
            print(f"stage: {ledger.get('stage')} (OMP reflection does not change stage)")
    return 0


def render_omp_agent_brief(ledger: dict[str, Any], path: Path) -> str:
    stage = str(ledger.get("stage") or "INTAKE")
    root = Path(ledger.get("worktree") or path.parent.parent)
    warnings = [
        f"- [{item.get('code')}] {item.get('message')}"
        for item in build_advisories(ledger, root)
        if item.get("severity") == "warn"
    ] or ["- none beyond next-step guidance"]
    stage_rows = "\n".join(
        f"| `{item}` | `{phase_code(item, 'omp-lite')}:` | {next_step_for(item, 'omp-lite')} |"
        for item in STAGES
        if item not in {"ADVERSARIAL_QA", "REFLECT"}
    )
    return f"""# OMP Lite delivery brief

Generated: {utc_now()}

- Runtime: `omp`
- Workflow profile: `omp-lite`
- Stage: `{stage}`
- Plan: `{ledger.get('plan') or '(set with delivery set --plan path)'}`
- Ledger: `{path}`

## Ownership contract

Stay in this OMP session. Use normal OMP coding mode for planning and implementation.
Do not enable native plan mode, launch Pi, select a Pi implementation profile, or hand
implementation to another process. The ledger is the shared scoreboard, not the worker.

## Do this now

1. Run `delivery show` and `delivery check -v`.
2. Follow the compatible next action: **{next_step_for(stage, 'omp-lite')}**
3. Record material progress with `delivery stage` and `delivery record`.
4. Refresh this brief after material progress with `delivery bootstrap --refresh`.

## OMP completeness

Only if the operator asked for a plan walk: at `COMPLETENESS_REVIEW`, run
`delivery completion-review --prepare --reviewer-identity
omp-completeness-grok-4.5-high`. Send the emitted packet unchanged to
`@completeness` on `xai/grok-4.5:high`. Write its exact seven-line response
envelope to the packet's artifact path, then run
`delivery completion-review --accept --response-id <id>`. Fix an `INCOMPLETE`
result and prepare a fresh request; never reuse a response ID. Skip this
section when they did not ask.

PM outcome review, autoreview, final verification, and PR evidence remain
required. Completeness is on-request and never gates OMP completion.
Reflection and adversarial QA are optional and never gate OMP completion or
change the visible OMP phase.

## Current advisories

{chr(10).join(warnings)}

## OMP phase map

| Detailed stage | Label | Compatible next action |
|---|---|---|
{stage_rows}

If blocked on a human decision, run `delivery blocker "..." --mark-blocked`. Otherwise,
continue until the requested work is complete; do not stop at an internal phase boundary.
"""


def render_agent_brief(ledger: dict[str, Any], path: Path) -> str:
    if is_omp_lite(ledger):
        return render_omp_agent_brief(ledger, path)
    stage = str(ledger.get("stage") or "INTAKE")
    next_step = STAGE_NEXT_SKILL.get(stage, "delivery check -v")
    root = Path(ledger.get("worktree") or path.parent.parent)
    advisories = build_advisories(ledger, root)
    warn_lines = [
        f"- [{a.get('code')}] {a.get('message')}"
        for a in advisories
        if a.get("severity") == "warn"
    ]
    if not warn_lines:
        warn_lines = ["- none beyond next-step guidance"]

    issue = ledger.get("issue") or "(none yet — attach later with delivery set --issue KEY --retarget-id)"
    plan = ledger.get("plan") or "(none yet — set with delivery set --plan path)"
    slug = ledger.get("slug") or "(none)"
    pr = ledger.get("prUrl") or "(none)"
    doct = ledger.get("doctUrl") or "(none)"
    approval = ledger.get("implementationApproval") or {}
    approval_status = approval.get("status") or "pending"
    selected = approved_implementation_profile(ledger)
    approval_profile = " / ".join(
        part for part in (approval.get("profile"), approval.get("model"), approval.get("reasoningLevel")) if part
    ) or f"{selected['profile']} / {selected['modelRef']} / {selected['reasoningLevel']} (selected at plan review)"
    implementation_profile = ledger.get("implementationProfile") or {}
    implementation_agent_status = implementation_profile.get("status") or "pending"

    stage_rows = "\n".join(
        f"| `{s}` | {STAGE_NEXT_SKILL.get(s, '')} |" for s in STAGES
    )

    return f"""# Delivery agent brief

Generated: {utc_now()}  
Doctrine: **guidance, not gates** for advisory evidence. Readiness authorization, independent Sol-medium plan review, a recorded single-writer implementation handoff, and completeness evidence are explicit boundaries. Luna xhigh is the default implementation profile; Terra high is for judgment-heavy correctness, and unresolved consequential choices may escalate to Oracle. The recommended model may be overridden manually with a recorded reason.

## This worktree

| Field | Value |
|---|---|
| id | {ledger.get('id')} |
| stage | {stage} |
| issue | {issue} |
| slug | {slug} |
| plan | {plan} |
| pr | {pr} |
| doct | {doct} |
| worktree | {ledger.get('worktree')} |
| branch | {ledger.get('branch')} |
| ledger | {path} |
| implementation authorization | {approval_status} ({approval_profile}) |
| implementation agent | {implementation_agent_status} ({selected['profile']} / {selected['modelRef']} / {selected['reasoningLevel']}) |

## Your job

Keep this worktree moving through:

```text
plan ↔ Sol-medium planner decision → GPT-5.6 Luna at xhigh by default or Terra high for judgment-heavy work → Terra autoreview → Grok completeness → PR
```

You are the planning/driving agent through reviewed-plan readiness. Use existing worker skills for real work.
The `delivery` CLI is the scoreboard + navigator, not the implementer. The read-only Sol-medium planner selects Luna xhigh by default or Terra high for judgment-heavy implementation. Escalate unresolved consequential choices to Oracle rather than selecting Sol for implementation. Entering `EXECUTION_READY` automatically authorizes and launches that dedicated agent; the planning agent then stops without another routine approval pause.

## Do this first

1. `delivery show`
2. `delivery check -v`
3. Follow the **Recommended next step** below by invoking the named skill/command.
4. After each meaningful step: `delivery stage <STAGE>`, `delivery record ...`, `delivery check -v`.
5. If a Linear issue appears later: `delivery set --issue KEY --retarget-id`.
6. Never stop solely because recommended evidence is pending/gap.

## Browser-review readiness trigger

While the stage is `PLAN_BROWSER_REVIEW`:

- An ordinary routed Doct comment (`submitAction: "agent"` with no
  `agentRoute.requestedSkill`) is browser feedback. Integrate and acknowledge it,
  then remain in `PLAN_BROWSER_REVIEW`.
- Do **not** start PM or technical readiness review because the first feedback was
  processed, the listener is quiet, or `planBrowserReview` is marked pass.
- Start the readiness cycle only after a direct operator instruction or Doct's
  explicit **Request execution-ready review** action. The current toolbar action
  emits `agentRoute.requestedSkill: "plan-reviewer-execution-ready"`.
- Record that signal before advancing: `delivery record planReadinessRequest
  --status pass --summary "Doct execution-ready review request"`, then move to
  `PLAN_PM_REVIEW`. `delivery stage PLAN_PM_REVIEW` and `PLAN_TECH_REVIEW`
  reject a missing request record. `EXECUTION_READY` additionally requires a
  current independent planner artifact from `openai-codex/gpt-5.6-sol` at medium
  with `VERDICT: PLAN_EXECUTION_READY`. The same review should select `luna-xhigh`
  by default, and `terra-high` when correctness depends materially on technical judgment.
  These are authorization boundaries.

## Automatic execution-ready handoff

When the PM and independent Sol-medium readiness gates pass for the exact plan, run:

```bash
delivery stage EXECUTION_READY
```

In Herdr this transition records workflow authorization, creates a labeled sibling **implementation owner** tab, starts Pi on its root pane with the planner-selected `{selected['profile']}` profile (`{selected['modelRef']}` at `{selected['reasoningLevel']}`), claims `workspaceOwner` for that tab, and prompts the new implementation agent to continue through PR creation. Do not ask for another routine approval. The planning agent stops after the handoff and must not implement. The planning tab is enqueued for retirement and is closed when the implementation agent runs `delivery verify-implementation-profile` (never self-closed mid-launch).

Use `delivery stage EXECUTION_READY --hold` only when the operator explicitly requests a pause or a real external dependency blocks execution. After a hold, `delivery approve-implementation` remains available for compatibility or a deliberate manual model override with `--override-reason`.

The new agent runs `delivery verify-implementation-profile` (which retires the previous owner tab) and then `delivery stage IMPLEMENTING`; the stage rejects missing/stale authorization, launch evidence, plan review, or a runtime that does not match the recorded profile. If launch failed, delivery closes the failed shell tab; retry with `delivery start-implementation`. Delivery reconciles the expected live Pi agent after a shell-readiness race. If material Doct feedback changes the contract before implementation, update the plan, revoke authorization, and return to `PLAN_BROWSER_REVIEW` for a fresh readiness cycle.

**Workspace owner chrome:** labels and focus follow ledger `workspaceOwner`, not ambient `HERDR_TAB_ID`. Completeness review uses a short-lived witness tab that is closed after `--accept` or `--waive`. After a tab is closed, evidence is ledger + artifacts + Pi session transcripts—not the retired TUI.

## Recommended next step

**{next_step}**

## Current advisories

{chr(10).join(warn_lines)}

## Navigation commands

```bash
delivery show
delivery check -v
delivery stages
delivery stage <STAGE> [--note "..."]        # EXECUTION_READY auto-launches
delivery stage EXECUTION_READY --hold            # explicit pause only
delivery approve-implementation --source chat|doct --summary "..."  # compatibility/manual override after hold
delivery start-implementation                    # retry failed dedicated-agent launch
delivery verify-implementation-profile           # run in the recorded implementation pane
delivery verify-implementation-profile --adopt-current-runtime --reason "..."  # record a deliberate manual switch
delivery revoke-implementation-approval --reason "material plan feedback"
delivery set --issue KEY --retarget-id          # Linear optional at start
delivery set --plan path/to/plan.html
delivery record <key> --status pass|skip|gap|na --artifact <path> --summary "..."
delivery note "what happened / why waiting"
delivery board                                  # all worktrees
delivery bootstrap --refresh                    # rewrite this brief
```

