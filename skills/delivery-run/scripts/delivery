EVIDENCE_STATUSES = ("pending", "pass", "skip", "gap", "na")
HELD_IMPLEMENTATION_LAUNCH_LOCKS: set[Path] = set()


def utc_now() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def die(msg: str, code: int = 2) -> None:
    print(f"delivery: {msg}", file=sys.stderr)
    raise SystemExit(code)


def load_json(path: Path) -> dict[str, Any]:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        die(f"ledger not found: {path}")
    except json.JSONDecodeError as exc:
        die(f"invalid JSON in {path}: {exc}")


def write_json(path: Path, data: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    is_ledger = path.name == LEDGER_REL.name and path.parent.name == LEDGER_REL.parent.name
    root = path.parent.parent.resolve() if is_ledger else None
    lock_fd: int | None = None
    if root is not None and root not in HELD_IMPLEMENTATION_LAUNCH_LOCKS:
        lock_path = root / IMPLEMENTATION_LAUNCH_LOCK_REL
        lock_fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            os.close(lock_fd)
            die("ledger mutation rejected while an implementation launch is in progress")
    try:
        if is_ledger:
            supplied_revision = int(data.get("ledgerRevision") or 0)
            if path.exists():
                current = json.loads(path.read_text(encoding="utf-8"))
                current_revision = int(current.get("ledgerRevision") or 0)
                if current_revision != supplied_revision:
                    die(
                        "stale ledger mutation rejected; reload delivery state and retry "
                        f"(current revision {current_revision}, supplied {supplied_revision})"
                    )
            data["ledgerRevision"] = supplied_revision + 1
        tmp = path.with_suffix(path.suffix + f".tmp.{os.getpid()}")
        tmp.write_text(json.dumps(data, indent=2, sort_keys=False) + "\n", encoding="utf-8")
        tmp.replace(path)
    finally:
        if lock_fd is not None:
            fcntl.flock(lock_fd, fcntl.LOCK_UN)
            os.close(lock_fd)


def git_capture(cwd: Path, *args: str) -> str | None:
    import subprocess

    try:
        proc = subprocess.run(
            ["git", *args],
            cwd=str(cwd),
            check=False,
            capture_output=True,
            text=True,
        )
    except OSError:
        return None
    if proc.returncode != 0:
        return None
    return proc.stdout.strip() or None


def detect_repo_root(start: Path | None = None) -> Path:
    start = (start or Path.cwd()).resolve()
    captured = git_capture(start, "rev-parse", "--show-toplevel")
    if captured:
        return Path(captured)
    return start


def default_id(root: Path, issue: str | None, slug: str | None) -> str:
    repo = root.name
    branch = git_capture(root, "branch", "--show-current") or ""
    label = issue or slug or branch or root.name
    label = label.strip().replace(" ", "-")
    return f"{repo}/{label}"


def empty_evidence() -> dict[str, Any]:
    out: dict[str, Any] = {}
    for key in RECOMMENDED_EVIDENCE:
        out[key] = {
            "status": "pending",
            "artifact": None,
            "summary": None,
            "updatedAt": None,
        }
    out["planTech"].update(
        {
            "reviewer": None,
            "model": None,
            "reasoningLevel": None,
            "verdict": None,
            "planSha256": None,
        }
    )
    return out


def new_ledger(
    *,
    root: Path,
    ledger_id: str,
    issue: str | None,
    plan: str | None,
    stage: str,
    doct_url: str | None,
    pr_url: str | None,
    slug: str | None = None,
) -> dict[str, Any]:
    now = utc_now()
    branch = git_capture(root, "branch", "--show-current")
    head = git_capture(root, "rev-parse", "--short", "HEAD")
    return {
        "schemaVersion": SCHEMA_VERSION,
        "id": ledger_id,
        "issue": issue,
        "slug": slug,
        "plan": plan,
        "doctUrl": doct_url,
        "prUrl": pr_url,
        "worktree": str(root),
        "branch": branch,
        "head": head,
        "stage": stage,
        "createdAt": now,
        "updatedAt": now,
        "notes": [],
        "history": [
            {
                "at": now,
                "type": "init",
                "stage": stage,
                "detail": "ledger created",
            }
        ],
        "evidence": empty_evidence(),
        "implementationApproval": {
            "status": "pending",
            "source": None,
            "planSha256": None,
            "model": None,
            "reasoningLevel": None,
            "summary": None,
            "approvedAt": None,
            "invalidatedAt": None,
            "reason": None,
        },
        "implementationProfile": {
            "status": "pending",
            "provider": IMPLEMENTATION_PROVIDER,
            "model": IMPLEMENTATION_MODEL,
            "modelRef": IMPLEMENTATION_MODEL_REF,
            "reasoningLevel": IMPLEMENTATION_REASONING,
            "planSha256": None,
            "agentName": None,
            "paneId": None,
            "sourcePaneId": None,
            "launchedAt": None,
            "promptedAt": None,
            "launchAttemptId": None,
            "reason": None,
        },
        "customerImpact": {
            "promised": [],
            "observed": [],
            "gaps": [],
            "summary": None,
        },
        "completionEval": {
            "status": "pending",
            "gaps": [],
            "summary": None,
        },
        "blockers": [],
        "advisories": [],
        "labels": {
            "herdr": None,
        },
        "doctrine": "guidance-not-gates",
    }


def find_ledger_path(start: Path | None = None, explicit: str | None = None) -> Path:
    if explicit:
        path = Path(explicit).expanduser().resolve()
        if path.is_dir():
            path = path / LEDGER_REL
        return path
    root = detect_repo_root(start)
    return root / LEDGER_REL


def append_history(ledger: dict[str, Any], event_type: str, detail: str, **extra: Any) -> None:
    entry = {"at": utc_now(), "type": event_type, "stage": ledger.get("stage"), "detail": detail}
    entry.update(extra)
    history = ledger.setdefault("history", [])
    history.append(entry)
    # Keep history bounded but useful.
    if len(history) > 200:
        del history[:-200]
    ledger["updatedAt"] = utc_now()


def refresh_git_fields(ledger: dict[str, Any], root: Path) -> None:
    branch = git_capture(root, "branch", "--show-current")
    head = git_capture(root, "rev-parse", "--short", "HEAD")
    if branch:
        ledger["branch"] = branch
    if head:
        ledger["head"] = head
    ledger["worktree"] = str(root)


def plan_sha256(ledger: dict[str, Any], root: Path) -> str | None:
    """Return the recorded plan's current content hash, or None when unavailable."""
    raw_plan = ledger.get("plan")
    if not isinstance(raw_plan, str) or not raw_plan.strip():
        return None
    candidate = Path(raw_plan).expanduser()
    if not candidate.is_absolute():
        candidate = root / candidate
    try:
        candidate = candidate.resolve()
        candidate.relative_to(root.resolve())
    except ValueError:
        return None
    if not candidate.is_file():
        return None
    return hashlib.sha256(candidate.read_bytes()).hexdigest()


def plan_readiness_request_problem(ledger: dict[str, Any], root: Path) -> str | None:
    """Explain why readiness review cannot begin for the current plan revision."""
    evidence = ledger.get("evidence") or {}
    request = evidence.get("planReadinessRequest") or {}
    if request.get("status") != "pass":
        return (
            "no explicit execution-ready review request is recorded "
            "(record planReadinessRequest=pass only after the operator asks or uses Doct's action)"
        )
    current_hash = plan_sha256(ledger, root)
    if current_hash is None:
        return "the recorded plan is missing, outside this worktree, or unreadable"
    if request.get("planSha256") != current_hash:
        return "the plan changed after the recorded execution-ready review request"
    return None


def reset_plan_readiness_request(ledger: dict[str, Any], reason: str) -> None:
    request = ledger.setdefault("evidence", {}).setdefault(
        "planReadinessRequest",
        {"status": "pending", "artifact": None, "summary": None, "updatedAt": None},
    )
    request.update({"status": "pending", "planSha256": None, "updatedAt": utc_now()})
    request["summary"] = reason


def reset_plan_technical_review(ledger: dict[str, Any], reason: str) -> None:
    review = ledger.setdefault("evidence", {}).setdefault("planTech", {})
    review.update(
        {
            "status": "pending",
            "artifact": None,
            "summary": reason,
            "updatedAt": utc_now(),
            "reviewer": None,
            "model": None,
            "reasoningLevel": None,
            "verdict": None,
            "planSha256": None,
        }
    )


def plan_technical_review_problem(ledger: dict[str, Any], root: Path) -> str | None:
    review = (ledger.get("evidence") or {}).get("planTech") or {}
    if review.get("status") != "pass":
        return "no current independent Sol medium planner review is recorded"
    if review.get("reviewer") != PLAN_REVIEW_AGENT:
        return f"plan review must come from the {PLAN_REVIEW_AGENT} subagent"
    if review.get("model") != PLAN_REVIEW_MODEL:
        return f"Sol medium planner review requires model {PLAN_REVIEW_MODEL}"
    if review.get("reasoningLevel") != PLAN_REVIEW_REASONING:
        return f"Sol medium planner review requires reasoning level {PLAN_REVIEW_REASONING}"
    if review.get("verdict") != "PLAN_EXECUTION_READY":
        return "Sol medium planner review has not returned PLAN_EXECUTION_READY"
    current_hash = plan_sha256(ledger, root)
    if current_hash is None:
        return "the recorded plan is missing, outside this worktree, or unreadable"
    if review.get("planSha256") != current_hash:
        return "the Sol medium planner review is stale for the current plan"
    artifact = review.get("artifact")
    if not isinstance(artifact, str) or not artifact.strip():
        return "the Sol medium planner review artifact is missing"
    candidate = Path(artifact).expanduser()
    if not candidate.is_absolute():
        candidate = root / candidate
    candidate = candidate.resolve()
    try:
        candidate.relative_to(root.resolve())
    except ValueError:
        return "the Sol medium planner review artifact is outside the worktree"
    if not candidate.is_file():
        return "the Sol medium planner review artifact is missing"
    return None


def implementation_approval_problem(ledger: dict[str, Any], root: Path) -> str | None:
    """Explain why implementation cannot begin for this ledger, if applicable."""
    approval = ledger.get("implementationApproval") or {}
    if approval.get("status") != "approved":
        return "no explicit operator implementation approval is recorded"
    current_hash = plan_sha256(ledger, root)
    if current_hash is None:
        return "the recorded plan is missing, outside this worktree, or unreadable"
    if approval.get("planSha256") != current_hash:
        return "the plan changed after the recorded implementation approval"
    if approval.get("model") != IMPLEMENTATION_MODEL_REF:
        return f"implementation approval is not pinned to {IMPLEMENTATION_MODEL_REF}"
    if approval.get("reasoningLevel") != IMPLEMENTATION_REASONING:
        return f"implementation approval is not pinned to {IMPLEMENTATION_REASONING} reasoning"
    return None


def implementation_profile_problem(
    ledger: dict[str, Any], root: Path, *, check_runtime: bool
) -> str | None:
    profile = ledger.get("implementationProfile") or {}
    if profile.get("status") != "ready":
        return "the dedicated Sol medium implementation agent has not been launched successfully"
    if profile.get("provider") != IMPLEMENTATION_PROVIDER:
        return f"implementation agent provider must be {IMPLEMENTATION_PROVIDER}"
    if profile.get("model") != IMPLEMENTATION_MODEL:
        return f"implementation agent model must be {IMPLEMENTATION_MODEL}"
    if profile.get("reasoningLevel") != IMPLEMENTATION_REASONING:
        return f"implementation agent reasoning must be {IMPLEMENTATION_REASONING}"
    current_hash = plan_sha256(ledger, root)
    if current_hash is None:
        return "the recorded plan is missing, outside this worktree, or unreadable"
    if profile.get("planSha256") != current_hash:
        return "the dedicated implementation agent was launched for an older plan revision"
    if not profile.get("agentName") or not profile.get("paneId"):
        return "the dedicated implementation agent identity is incomplete"
    if check_runtime:
        provider = (os.environ.get("PI_PROVIDER") or "").strip()
        model = (os.environ.get("PI_MODEL") or "").strip()
        reasoning = (os.environ.get("PI_REASONING_LEVEL") or "").strip()
        current_pane = (os.environ.get("HERDR_PANE_ID") or "").strip()
        if not provider or not model or not reasoning or not current_pane:
            return "implementation entry must be run from the recorded pinned Herdr Pi agent"
        if current_pane != str(profile.get("paneId")):
            return (
                "current Herdr pane does not match the recorded implementation agent pane "
                f"{profile.get('paneId')}"
            )
        if provider != IMPLEMENTATION_PROVIDER or model != IMPLEMENTATION_MODEL:
            return (
                "current Pi runtime is not the pinned implementation model "
                f"{IMPLEMENTATION_MODEL_REF}"
            )
        if reasoning != IMPLEMENTATION_REASONING:
            return f"current Pi runtime reasoning must be {IMPLEMENTATION_REASONING}"
    return None


def stage_transition_problem(ledger: dict[str, Any], root: Path, stage: str) -> str | None:
    """Return the authorization failure for a protected stage transition."""
    if stage in {"PLAN_PM_REVIEW", "PLAN_TECH_REVIEW"}:
        return plan_readiness_request_problem(ledger, root)
    if stage == "EXECUTION_READY":
        return plan_readiness_request_problem(ledger, root) or plan_technical_review_problem(ledger, root)
    if stage == "IMPLEMENTING":
        readiness_problem = plan_readiness_request_problem(ledger, root)
        if readiness_problem:
            return f"no current execution-ready review request: {readiness_problem}"
        return (
            plan_technical_review_problem(ledger, root)
            or implementation_approval_problem(ledger, root)
            or implementation_profile_problem(ledger, root, check_runtime=True)
        )
    return None


def reset_implementation_approval(ledger: dict[str, Any], reason: str) -> None:
    approval = ledger.setdefault("implementationApproval", {})
    approval.update(
        {
            "status": "pending",
            "source": None,
            "planSha256": None,
            "model": None,
            "reasoningLevel": None,
            "summary": None,
            "approvedAt": None,
            "invalidatedAt": utc_now(),
            "reason": reason,
        }
    )


def reset_implementation_profile(ledger: dict[str, Any], reason: str) -> None:
    profile = ledger.setdefault("implementationProfile", {})
    profile.update(
        {
            "status": "pending",
            "provider": IMPLEMENTATION_PROVIDER,
            "model": IMPLEMENTATION_MODEL,
            "modelRef": IMPLEMENTATION_MODEL_REF,
            "reasoningLevel": IMPLEMENTATION_REASONING,
            "planSha256": None,
            "agentName": None,
            "paneId": None,
            "sourcePaneId": None,
            "launchedAt": None,
            "promptedAt": None,
            "launchAttemptId": None,
            "reason": reason,
        }
    )


def phase_code(stage: str | None) -> str:
    return STAGE_PHASE_CODE.get(str(stage or "INTAKE"), "PL")


def strip_phase_prefix(text: str | None) -> str:
    return PHASE_CODE_RE.sub("", (text or "").strip()).strip()


def strip_stage_suffix(text: str | None) -> str:
    """Remove trailing delivery stage tokens from titles.

    Handles legacy Herdr labels like "NOD-1475 · IMPLEMENTING" and bare
    stage-only titles so the descriptive half stays the work slug/title.
    """
    value = (text or "").strip()
    if not value:
        return ""
    prev = None
    while value and value != prev:
        prev = value
        if value.upper() in STAGE_NAME_SET:
            return ""
        value = STAGE_TOKEN_RE.sub("", value).strip(" ·-:/\t")
    return value


def sanitize_base_title(text: str | None) -> str:
    """Title only: no phase code prefix, no stage-name suffix."""
    value = strip_stage_suffix(strip_phase_prefix(text))
    value = re.sub(r"\s+", " ", value).strip(" ·-:/\t")
    # Collapse "NOD-1 · slug" separators to a single readable form later.
    return value


def title_is_weak(text: str | None, *, issue: str | None = None) -> bool:
    """True when a candidate is empty, stage-like, or issue-only."""
    value = sanitize_base_title(text)
    if not value:
        return True
    if value.upper() in STAGE_NAME_SET:
        return True
    if issue and value.upper() == str(issue).upper():
        return True
    # Repo/id leftovers like "heddle/NOD-1475" with no human title.
    if "/" in value and not re.search(r"[a-zA-Z]{3,}", strip_issue_keys(value) or ""):
        return True
    return False


def ensure_base_title(ledger: dict[str, Any]) -> str:
    """Stable human title without phase code or stage name.

    Desired Herdr form: "R: NOD-1475 one-login-path" — never
    "R: NOD-1475 · IMPLEMENTING".
    """
    labels = ledger.setdefault("labels", {})
    issue = ledger.get("issue") if isinstance(ledger.get("issue"), str) else None
    spawn = ledger.get("spawn") if isinstance(ledger.get("spawn"), dict) else {}

    stored = labels.get("baseTitle")
    if isinstance(stored, str) and stored.strip() and not title_is_weak(stored, issue=issue):
        base = sanitize_base_title(stored)
        labels["baseTitle"] = base
        return short_label(base, max_len=42)

    # Prefer durable work identity over any previously written herdr label
    # (legacy values were "{issue|id} · {STAGE}").
    slug = ledger.get("slug") if isinstance(ledger.get("slug"), str) else None
    goal = ledger.get("goal") if isinstance(ledger.get("goal"), str) else None
    intent_from_goal = strip_issue_keys(goal) if goal else ""
    candidates = [
        spawn.get("label") if isinstance(spawn, dict) else None,
        (
            f"{issue} · {slug.replace('-', ' ')}"
            if issue and slug
            else None
        ),
        f"{issue} · {intent_from_goal}" if issue and intent_from_goal else None,
        intent_from_goal or None,
        slug.replace("-", " ") if slug else None,
        goal,
        issue,
        ledger.get("id"),
        labels.get("herdr"),  # last resort; may be legacy contaminated
    ]

    base = ""
    for candidate in candidates:
        if not isinstance(candidate, str) or not candidate.strip():
            continue
        cleaned = sanitize_base_title(candidate)
        if not cleaned or title_is_weak(cleaned, issue=issue):
            # Keep issue-only as a weak fallback but keep looking for a slug/title.
            if cleaned and not base:
                base = cleaned
            continue
        base = cleaned
        break
    if not base:
        base = sanitize_base_title(issue or slug or goal or ledger.get("id") or "delivery") or "delivery"

    # Prefer compact issue-leading titles when possible.
    if issue and issue.lower() not in base.lower():
        base = f"{issue} · {base}".strip()
    # Normalize separators after salvage.
    base = re.sub(r"\s*[·]\s*", " · ", base)
    base = re.sub(r"\s+", " ", base).strip(" ·")
    base = short_label(base, max_len=42)
    labels["baseTitle"] = base
    return base


def herdr_display_label(ledger: dict[str, Any]) -> str:
    code = phase_code(str(ledger.get("stage") or "INTAKE"))
    base = ensure_base_title(ledger)
    # Guard: never allow a stage token back into the visible title.
    base = sanitize_base_title(base) or base
    if title_is_weak(base) and ledger.get("slug"):
        slug = str(ledger.get("slug")).replace("-", " ")
        issue = ledger.get("issue")
        base = f"{issue} · {slug}" if issue else slug
        base = short_label(sanitize_base_title(base), max_len=42)
        ledger.setdefault("labels", {})["baseTitle"] = base
    return f"{code}: {base}"


def resolve_herdr_targets(ledger: dict[str, Any]) -> dict[str, str | None]:
    labels = ledger.get("labels") if isinstance(ledger.get("labels"), dict) else {}
    spawn = ledger.get("spawn") if isinstance(ledger.get("spawn"), dict) else {}
    workspace_id = (
        os.environ.get("HERDR_WORKSPACE_ID")
        or labels.get("herdrWorkspaceId")
        or spawn.get("workspaceId")
    )
    tab_id = (
        os.environ.get("HERDR_TAB_ID")
        or labels.get("herdrTabId")
        or spawn.get("tabId")
    )
    pane_id = (
        os.environ.get("HERDR_PANE_ID")
        or labels.get("herdrPaneId")
        or spawn.get("paneId")
    )
    return {
        "workspaceId": str(workspace_id) if workspace_id else None,
        "tabId": str(tab_id) if tab_id else None,
        "paneId": str(pane_id) if pane_id else None,
    }


def maybe_herdr_label(
    ledger: dict[str, Any],
    *,
    targets: dict[str, str | None] | None = None,
) -> None:
    """Best-effort Herdr workspace + tab label sync with phase prefix.

    Never fails the command. Format: "PL: nod-1234 short title".
    Explicit targets let parent commands update a newly created destination
    without inheriting the caller's HERDR_* environment identifiers.
    """
    if os.environ.get("DELIVERY_SKIP_HERDR", "").strip() in {"1", "true", "yes"}:
        return
    if shutil.which("herdr") is None:
        return

    label = herdr_display_label(ledger)
    targets = targets or resolve_herdr_targets(ledger)
    labels = ledger.setdefault("labels", {})
    labels["herdr"] = label
    labels["phaseCode"] = phase_code(str(ledger.get("stage") or "INTAKE"))

    try:
        workspace_id = targets.get("workspaceId")
        tab_id = targets.get("tabId")

        # Workspace/space name is the primary glance surface.
        if workspace_id:
            proc = subprocess.run(
                ["herdr", "workspace", "rename", str(workspace_id), label],
                check=False,
                capture_output=True,
                text=True,
                timeout=5,
            )
            if proc.returncode == 0:
                labels["herdrWorkspaceId"] = str(workspace_id)

        # Keep the tab aligned when we know it.
        if tab_id:
            proc = subprocess.run(
                ["herdr", "tab", "rename", str(tab_id), label],
                check=False,
                capture_output=True,
                text=True,
                timeout=5,
            )
            if proc.returncode == 0:
                labels["herdrTabId"] = str(tab_id)
        elif targets.get("paneId") and not workspace_id:
            # Last resort: older path only had pane/tab env.
            pass
    except Exception:
        # Guidance only — ignore herdr failures.
        return


def cmd_init(args: argparse.Namespace) -> int:
    root = Path(args.cwd).resolve() if args.cwd else detect_repo_root()
    path = root / LEDGER_REL
    if path.exists() and not args.force:
        die(f"ledger already exists: {path} (use --force to overwrite)")
    stage = args.stage or "INTAKE"
    if stage not in STAGES:
        die(f"unknown stage {stage!r}; choose from: {', '.join(STAGES)}")
    ledger_id = args.id or default_id(root, args.issue, args.slug)
    ledger = new_ledger(
        root=root,
        ledger_id=ledger_id,
        issue=args.issue,
        plan=args.plan,
        stage=stage,
        doct_url=args.doct_url,
        pr_url=args.pr_url,
        slug=args.slug,
    )
    transition_problem = stage_transition_problem(ledger, root, stage)
    if transition_problem:
        die(
            f"cannot initialize at {stage}: {transition_problem}. "
            "Create the ledger at INTAKE and advance through delivery's guarded steps."
        )
    write_json(path, ledger)
    maybe_herdr_label(ledger)
    write_json(path, ledger)
    print(path)
    if args.json:
        print(json.dumps(ledger, indent=2))
    return 0


def cmd_path(args: argparse.Namespace) -> int:
    path = find_ledger_path(Path(args.cwd).resolve() if args.cwd else None, args.ledger)
    print(path)
    return 0 if path.exists() or args.allow_missing else 1


def load_ledger_for(args: argparse.Namespace) -> tuple[Path, dict[str, Any], Path]:
    root = Path(args.cwd).resolve() if getattr(args, "cwd", None) else detect_repo_root()
    path = find_ledger_path(root, getattr(args, "ledger", None))
    if not path.exists():
        die(f"no ledger at {path}; run: delivery init")
    ledger = load_json(path)
    # If ledger records a worktree, prefer that root for git refresh.
    wt = ledger.get("worktree")
    if wt and Path(wt).is_dir():
        root = Path(wt)
    return path, ledger, root


def cmd_show(args: argparse.Namespace) -> int:
    path, ledger, root = load_ledger_for(args)
    refresh_git_fields(ledger, root)
    if args.json:
        print(json.dumps(ledger, indent=2))
        return 0
    print(f"id:        {ledger.get('id')}")
    print(f"path:      {path}")
    print(f"stage:     {ledger.get('stage')}")
    print(f"issue:     {ledger.get('issue')}")
    print(f"slug:      {ledger.get('slug')}")
    print(f"plan:      {ledger.get('plan')}")
    print(f"branch:    {ledger.get('branch')}")
    print(f"worktree:  {ledger.get('worktree')}")
    print(f"pr:        {ledger.get('prUrl')}")
    print(f"doct:      {ledger.get('doctUrl')}")
    approval = ledger.get("implementationApproval") or {}
    approval_problem = implementation_approval_problem(ledger, root)
    approval_status = approval.get("status", "pending")
    if approval_problem:
        approval_status = f"{approval_status} ({approval_problem})"
    print(f"implementation approval: {approval_status}")
    profile = ledger.get("implementationProfile") or {}
    profile_status = profile.get("status", "pending")
    profile_problem = implementation_profile_problem(ledger, root, check_runtime=False)
    if profile_problem:
        profile_status = f"{profile_status} ({profile_problem})"
    print(f"implementation agent: {profile_status}")
    print(f"implementation runtime: {IMPLEMENTATION_MODEL_REF} / {IMPLEMENTATION_REASONING}")
    print(f"updated:   {ledger.get('updatedAt')}")
    print(f"next:      {STAGE_NEXT_SKILL.get(str(ledger.get('stage')), 'n/a')}")
    print("evidence:")
    for key, val in (ledger.get("evidence") or {}).items():
        status = (val or {}).get("status", "pending")
        summary = (val or {}).get("summary") or ""
        art = (val or {}).get("artifact") or ""
        extra = " ".join(x for x in (summary, art) if x)
        print(f"  - {key}: {status}" + (f"  {extra}" if extra else ""))
    notes = ledger.get("notes") or []
    if notes:
        print("notes:")
        for note in notes[-5:]:
            print(f"  - [{note.get('at')}] {note.get('text')}")
    blockers = ledger.get("blockers") or []
    if blockers:
        print("blockers:")
        for b in blockers:
            print(f"  - {b}")
    return 0


def cmd_stage(args: argparse.Namespace) -> int:
    stage = args.stage
    if stage not in STAGES:
        die(f"unknown stage {stage!r}; choose from: {', '.join(STAGES)}")
    path, ledger, root = load_ledger_for(args)
    transition_problem = stage_transition_problem(ledger, root, stage)
    if transition_problem:
        if stage == "IMPLEMENTING":
            die(
                "cannot enter IMPLEMENTING: "
                f"{transition_problem}. Obtain direct operator approval, let `delivery "
                "approve-implementation` launch the fixed Sol medium agent, then enter "
                "IMPLEMENTING from that pinned Pi runtime."
            )
        die(
            f"cannot enter {stage}: {transition_problem}. "
            "Continue processing ordinary feedback in PLAN_BROWSER_REVIEW."
        )
    if stage == "MERGE_READY":
        completeness_problem = completeness_review_problem(ledger, root)
        if completeness_problem:
            die(
                "cannot enter MERGE_READY: "
                f"{completeness_problem}. Run `delivery completion-review`, fix in-plan findings, "
                "then run `delivery completion-review --accept` after `VERDICT: COMPLETE`; only a "
                "direct operator waiver may use `delivery completion-review --waive --summary \"...\"`."
            )
    prev = ledger.get("stage")
    ledger["stage"] = stage
    refresh_git_fields(ledger, root)
    append_history(ledger, "stage", f"{prev} -> {stage}")
    if args.note:
        ledger.setdefault("notes", []).append({"at": utc_now(), "text": args.note, "stage": stage})
    maybe_herdr_label(ledger)
    write_json(path, ledger)
    print(f"{prev} -> {stage}")
    print(f"next: {STAGE_NEXT_SKILL.get(stage, 'n/a')}")
    return 0


@contextmanager
def implementation_launch_lock(root: Path):
    lock_path = root / IMPLEMENTATION_LAUNCH_LOCK_REL
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            die("an implementation agent launch is already in progress")
        os.ftruncate(fd, 0)
        os.write(fd, f"pid={os.getpid()} at={utc_now()}\n".encode())
        HELD_IMPLEMENTATION_LAUNCH_LOCKS.add(root.resolve())
        yield
    finally:
        HELD_IMPLEMENTATION_LAUNCH_LOCKS.discard(root.resolve())
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
        finally:
            os.close(fd)


def implementation_agent_name(ledger: dict[str, Any]) -> str:
    identity = str(ledger.get("issue") or ledger.get("slug") or ledger.get("id") or "delivery")
    suffix = slugify(identity, max_len=9, keep_issue_keys=True)
    return f"implementation-{suffix}-{uuid.uuid4().hex[:6]}"


def implementation_agent_prompt(ledger: dict[str, Any], root: Path) -> str:
    plan = str(ledger.get("plan") or "(missing plan)")
    return f"""You are the dedicated implementation agent for this delivery run.

Worktree: {root}
Plan: {plan}
Required runtime: {IMPLEMENTATION_MODEL_REF} at {IMPLEMENTATION_REASONING} reasoning

Do this now:
1. Read `.delivery/AGENT_BRIEF.md` and the full plan.
2. Run `delivery show` and `delivery verify-implementation-profile`. If the launch is still being finalized, retry verification once it reports ready.
3. Run `delivery stage IMPLEMENTING` from this pinned Pi runtime.
4. Execute `/skill:run-plan {plan}` through implementation, verification, Terra code review, the visible Grok completeness review, and PR readiness.

Do not re-plan beyond the reviewed contract. The planning agent must not implement; you own all code, tests, fixes, Git, and PR work from this point."""


def active_implementation_launch(
    path: Path, root: Path, attempt_id: str, *, allowed_statuses: set[str]
) -> dict[str, Any]:
    current = json.loads(path.read_text())
    if current.get("stage") != "EXECUTION_READY":
        die("implementation launch authorization changed before the agent became ready")
    problem = (
        plan_readiness_request_problem(current, root)
        or plan_technical_review_problem(current, root)
        or implementation_approval_problem(current, root)
    )
    if problem:
        die(f"implementation launch authorization changed: {problem}")
    profile = current.get("implementationProfile") or {}
    if profile.get("launchAttemptId") != attempt_id:
        die("implementation launch lease was superseded or revoked")
    if str(profile.get("status")) not in allowed_statuses:
        die("implementation launch state changed before the agent became ready")
    return current


def launch_implementation_agent(
    path: Path, ledger: dict[str, Any], root: Path, args: argparse.Namespace
) -> int:
    source_pane = args.pane or resolve_herdr_targets(ledger).get("paneId")
    if not source_pane:
        reset_implementation_profile(ledger, "no Herdr source pane available")
        write_json(path, ledger)
        die("implementation launch needs --pane, HERDR_PANE_ID, or a delivery spawn pane")
    reviewer_name = args.agent_name or implementation_agent_name(ledger)
    prompt = implementation_agent_prompt(ledger, root)
    attempt_id = uuid.uuid4().hex
    reset_implementation_profile(ledger, "dedicated implementation agent launch in progress")
    ledger["implementationProfile"].update(
        {"status": "launching", "launchAttemptId": attempt_id}
    )
    refresh_git_fields(ledger, root)
    write_json(path, ledger)
    split = herdr_json(
        ["pane", "split", str(source_pane), "--direction", "right", "--cwd", str(root), "--no-focus"],
        cwd=root,
    )
    split_result = split.get("result") if isinstance(split.get("result"), dict) else split
    pane = split_result.get("pane") if isinstance(split_result.get("pane"), dict) else split_result
    implementation_pane = pane.get("pane_id")
    if not implementation_pane:
        current = active_implementation_launch(path, root, attempt_id, allowed_statuses={"launching"})
        reset_implementation_profile(current, "Herdr split returned no pane id")
        write_json(path, current)
        die(f"implementation pane split returned no pane id: {split}")

    herdr = require_herdr()
    start_command = [
        herdr,
        "agent",
        "start",
        reviewer_name,
        "--kind",
        "pi",
        "--pane",
        str(implementation_pane),
        "--timeout",
        str(args.timeout_ms),
        "--",
        "--provider",
        IMPLEMENTATION_PROVIDER,
        "--model",
        IMPLEMENTATION_MODEL,
        "--thinking",
        IMPLEMENTATION_REASONING,
    ]
    started = run_cmd(start_command, cwd=root)
    current = active_implementation_launch(path, root, attempt_id, allowed_statuses={"launching"})
    profile = current.setdefault("implementationProfile", {})
    profile.update(
        {
            "status": "started" if started.returncode == 0 else "start-failed",
            "provider": IMPLEMENTATION_PROVIDER,
            "model": IMPLEMENTATION_MODEL,
            "modelRef": IMPLEMENTATION_MODEL_REF,
            "reasoningLevel": IMPLEMENTATION_REASONING,
            "planSha256": plan_sha256(current, root),
            "agentName": reviewer_name,
            "paneId": str(implementation_pane),
            "sourcePaneId": str(source_pane),
            "launchedAt": utc_now() if started.returncode == 0 else None,
            "promptedAt": None,
            "launchAttemptId": attempt_id,
            "reason": None if started.returncode == 0 else (started.stderr or started.stdout).strip(),
        }
    )
    if started.returncode != 0:
        append_history(current, "implementation_agent", "dedicated Sol medium agent start failed")
        write_json(path, current)
        die(f"could not start dedicated implementation agent: {(started.stderr or started.stdout).strip()}")
    write_json(path, current)

    requested = run_cmd([herdr, "agent", "prompt", reviewer_name, prompt], cwd=root)
    current = active_implementation_launch(path, root, attempt_id, allowed_statuses={"started"})
    profile = current["implementationProfile"]
    if requested.returncode != 0:
        profile.update(
            {
                "status": "prompt-failed",
                "reason": (requested.stderr or requested.stdout).strip(),
            }
        )
        append_history(current, "implementation_agent", "dedicated Sol medium agent prompt failed")
        write_json(path, current)
        die(f"could not prompt dedicated implementation agent: {(requested.stderr or requested.stdout).strip()}")

    profile.update({"status": "ready", "promptedAt": utc_now(), "reason": None})
    append_history(
        current,
        "implementation_agent",
        "dedicated Sol medium implementation agent ready",
        agent=reviewer_name,
        paneId=str(implementation_pane),
        model=IMPLEMENTATION_MODEL_REF,
        reasoningLevel=IMPLEMENTATION_REASONING,
    )
    refresh_git_fields(current, root)
    write_json(path, current)
    print(f"implementation agent ready: {reviewer_name} in {implementation_pane}")
    print("next: the pinned implementation agent verifies its profile and enters IMPLEMENTING")
    return 0


def cmd_approve_implementation(args: argparse.Namespace) -> int:
    _, _, root = load_ledger_for(args)
    with implementation_launch_lock(root):
        path, ledger, root = load_ledger_for(args)
        return approve_implementation_locked(args, path, ledger, root)


def approve_implementation_locked(
    args: argparse.Namespace, path: Path, ledger: dict[str, Any], root: Path
) -> int:
    if ledger.get("stage") != "EXECUTION_READY":
        die("implementation approval is allowed only at EXECUTION_READY")
    if (ledger.get("implementationApproval") or {}).get("status") == "approved":
        die(
            "implementation is already approved; refusing to launch a second writer "
            "(use `delivery start-implementation` only when the recorded launch failed)"
        )
    readiness_problem = plan_readiness_request_problem(ledger, root)
    if readiness_problem:
        die(f"cannot approve implementation: {readiness_problem}")
    review_problem = plan_technical_review_problem(ledger, root)
    if review_problem:
        die(f"cannot approve implementation: {review_problem}")
    if args.model and args.model != IMPLEMENTATION_MODEL_REF:
        die(f"implementation model is fixed at {IMPLEMENTATION_MODEL_REF}")
    if args.reasoning_level and args.reasoning_level != IMPLEMENTATION_REASONING:
        die(f"implementation reasoning level is fixed at {IMPLEMENTATION_REASONING}")
    fingerprint = plan_sha256(ledger, root)
    if fingerprint is None:
        die("cannot approve implementation: recorded plan is missing, outside this worktree, or unreadable")
    approval = ledger.setdefault("implementationApproval", {})
    approval.update(
        {
            "status": "approved",
            "source": args.source,
            "planSha256": fingerprint,
            "model": IMPLEMENTATION_MODEL_REF,
            "reasoningLevel": IMPLEMENTATION_REASONING,
            "summary": args.summary,
            "approvedAt": utc_now(),
            "invalidatedAt": None,
            "reason": None,
        }
    )
    reset_implementation_profile(ledger, "operator approved; implementation agent launch pending")
    append_history(
        ledger,
        "implementation_approval",
        "operator approved fixed Sol medium implementation",
        source=args.source,
        planSha256=fingerprint,
        model=IMPLEMENTATION_MODEL_REF,
        reasoningLevel=IMPLEMENTATION_REASONING,
    )
    refresh_git_fields(ledger, root)
    write_json(path, ledger)
    print("implementation approval recorded; launching fixed Sol medium implementation agent")
    return launch_implementation_agent(path, ledger, root, args)


def cmd_start_implementation(args: argparse.Namespace) -> int:
    _, _, root = load_ledger_for(args)
    with implementation_launch_lock(root):
        path, ledger, root = load_ledger_for(args)
        return start_implementation_locked(args, path, ledger, root)


def start_implementation_locked(
    args: argparse.Namespace, path: Path, ledger: dict[str, Any], root: Path
) -> int:
    if ledger.get("stage") != "EXECUTION_READY":
        die("implementation agent launch is allowed only at EXECUTION_READY")
    profile_status = str((ledger.get("implementationProfile") or {}).get("status") or "pending")
    if profile_status == "ready":
        die("implementation agent is already ready; refusing to launch a second writer")
    problem = (
        plan_readiness_request_problem(ledger, root)
        or plan_technical_review_problem(ledger, root)
        or implementation_approval_problem(ledger, root)
    )
    if problem:
        die(f"cannot start implementation agent: {problem}")
    return launch_implementation_agent(path, ledger, root, args)


def cmd_verify_implementation_profile(args: argparse.Namespace) -> int:
    _, ledger, root = load_ledger_for(args)
    problem = (
        plan_readiness_request_problem(ledger, root)
        or plan_technical_review_problem(ledger, root)
        or implementation_approval_problem(ledger, root)
        or implementation_profile_problem(ledger, root, check_runtime=True)
    )
    if problem:
        die(f"implementation profile invalid: {problem}")
    print(f"implementation profile verified: {IMPLEMENTATION_MODEL_REF} / {IMPLEMENTATION_REASONING}")
    return 0


def cmd_revoke_implementation_approval(args: argparse.Namespace) -> int:
    path, ledger, root = load_ledger_for(args)
    reset_implementation_approval(ledger, args.reason)
    reset_implementation_profile(ledger, args.reason)
    append_history(ledger, "implementation_approval_revoked", args.reason)
    refresh_git_fields(ledger, root)
    write_json(path, ledger)
    print("implementation approval and agent profile revoked")
    return 0


def cmd_note(args: argparse.Namespace) -> int:
    path, ledger, root = load_ledger_for(args)
    text = " ".join(args.text).strip()
    if not text:
        die("note text required")
    ledger.setdefault("notes", []).append(
        {"at": utc_now(), "text": text, "stage": ledger.get("stage")}
    )
    append_history(ledger, "note", text)
    refresh_git_fields(ledger, root)
    write_json(path, ledger)
    print("noted")
    return 0


def cmd_set(args: argparse.Namespace) -> int:
    """Attach or update metadata after start (issue is optional at init)."""
    path, ledger, root = load_ledger_for(args)
    changes: list[str] = []

    if args.clear_issue:
        if ledger.get("issue") is not None:
            changes.append(f"issue: {ledger.get('issue')!r} -> None")
        ledger["issue"] = None
    elif args.issue is not None:
        issue = args.issue.strip() or None
        prev = ledger.get("issue")
        if prev != issue:
            changes.append(f"issue: {prev!r} -> {issue!r}")
        ledger["issue"] = issue

    if args.plan is not None:
        plan = args.plan.strip() or None
        prev = ledger.get("plan")
        if prev != plan:
            changes.append(f"plan: {prev!r} -> {plan!r}")
            reset_plan_readiness_request(ledger, "recorded plan path changed")
            reset_plan_technical_review(ledger, "recorded plan path changed")
            reset_implementation_approval(ledger, "recorded plan path changed")
            reset_implementation_profile(ledger, "recorded plan path changed")
        ledger["plan"] = plan

    if args.doct_url is not None:
        url = args.doct_url.strip() or None
        prev = ledger.get("doctUrl")
        if prev != url:
            changes.append(f"doctUrl: {prev!r} -> {url!r}")
        ledger["doctUrl"] = url

    if args.pr_url is not None:
        url = args.pr_url.strip() or None
        prev = ledger.get("prUrl")
        if prev != url:
            changes.append(f"prUrl: {prev!r} -> {url!r}")
        ledger["prUrl"] = url

    if args.slug is not None:
        slug = args.slug.strip() or None
        prev = ledger.get("slug")
        if prev != slug:
            changes.append(f"slug: {prev!r} -> {slug!r}")
        ledger["slug"] = slug

    if args.id is not None:
        new_id = args.id.strip()
        if not new_id:
            die("--id cannot be empty")
        prev = ledger.get("id")
        if prev != new_id:
            changes.append(f"id: {prev!r} -> {new_id!r}")
        ledger["id"] = new_id
    elif args.retarget_id:
        # Rebuild id from repo + issue/slug/branch once an issue arrives later.
        new_id = default_id(root, ledger.get("issue"), ledger.get("slug"))
        prev = ledger.get("id")
        if prev != new_id:
            changes.append(f"id: {prev!r} -> {new_id!r}")
        ledger["id"] = new_id

    if not changes and not any(
        [
            args.clear_issue,
            args.issue is not None,
            args.plan is not None,
            args.doct_url is not None,
            args.pr_url is not None,
            args.slug is not None,
            args.id is not None,
            args.retarget_id,
        ]
    ):
        die("nothing to set; pass --issue, --plan, --doct-url, --pr-url, --slug, --id, and/or --retarget-id")

    if changes:
        append_history(ledger, "set", "; ".join(changes))
    else:
        append_history(ledger, "set", "no-op (values unchanged)")

    refresh_git_fields(ledger, root)
    maybe_herdr_label(ledger)
    write_json(path, ledger)
    if changes:
        for line in changes:
            print(line)
    else:
        print("unchanged")
    print(f"id: {ledger.get('id')}")
    print(f"issue: {ledger.get('issue')}")
    return 0


def cmd_record(args: argparse.Namespace) -> int:
    key = args.key
    if key not in RECOMMENDED_EVIDENCE and key not in {"completionEval", "customerImpact"}:
        known = ", ".join(sorted(set(RECOMMENDED_EVIDENCE) | {"completionEval", "customerImpact"}))
        die(f"unknown evidence key {key!r}; known: {known}")
    status = args.status
    if status not in EVIDENCE_STATUSES:
        die(f"status must be one of {', '.join(EVIDENCE_STATUSES)}")
    path, ledger, root = load_ledger_for(args)
    now = utc_now()
    if key == "planTech":
        ev = ledger.setdefault("evidence", {}).setdefault("planTech", {})
        if status == "pass":
            if args.reviewer != PLAN_REVIEW_AGENT:
                die(f"planTech=pass requires reviewer {PLAN_REVIEW_AGENT}")
            if args.model != PLAN_REVIEW_MODEL:
                die(f"planTech=pass requires model {PLAN_REVIEW_MODEL}")
            if args.reasoning_level != PLAN_REVIEW_REASONING:
                die(f"planTech=pass requires reasoning level {PLAN_REVIEW_REASONING}")
            if args.verdict != "PLAN_EXECUTION_READY":
                die("planTech=pass requires verdict PLAN_EXECUTION_READY")
            if not args.artifact:
                die("planTech=pass requires --artifact")
            artifact = Path(args.artifact).expanduser()
            if not artifact.is_absolute():
                artifact = root / artifact
            artifact = artifact.resolve()
            try:
                artifact.relative_to(root.resolve())
            except ValueError:
                die("planTech artifact must be inside the worktree")
            if not artifact.is_file():
                die("planTech artifact does not exist")
            fingerprint = plan_sha256(ledger, root)
            if fingerprint is None:
                die("cannot record planTech=pass: recorded plan is missing, outside this worktree, or unreadable")
            ev.update(
                {
                    "status": "pass",
                    "artifact": args.artifact,
                    "summary": args.summary,
                    "updatedAt": now,
                    "reviewer": args.reviewer,
                    "model": args.model,
                    "reasoningLevel": args.reasoning_level,
                    "verdict": args.verdict,
                    "planSha256": fingerprint,
                }
            )
        else:
            reset_plan_technical_review(ledger, args.summary or f"planTech={status}")
            ev = ledger["evidence"]["planTech"]
            ev["status"] = status
            ev["artifact"] = args.artifact
    elif key == "completionEval":
        slot = ledger.setdefault(
            "completionEval",
            {"status": "pending", "gaps": [], "summary": None},
        )
        slot["status"] = status
        if args.summary:
            slot["summary"] = args.summary
        if args.gap:
            gaps = slot.setdefault("gaps", [])
            for g in args.gap:
                if g not in gaps:
                    gaps.append(g)
        # Mirror into evidence for board uniformity.
        ev = ledger.setdefault("evidence", {}).setdefault(
            "completionEval",
            {"status": "pending", "artifact": None, "summary": None, "updatedAt": None},
        )
        ev.update(
            {
                "status": status,
                "artifact": args.artifact,
                "summary": args.summary or ev.get("summary"),
                "updatedAt": now,
            }
        )
    elif key == "customerImpact":
        slot = ledger.setdefault(
            "customerImpact",
            {"promised": [], "observed": [], "gaps": [], "summary": None},
        )
        if args.summary:
            slot["summary"] = args.summary
        if args.promised:
            slot["promised"] = list(args.promised)
        if args.observed:
            slot["observed"] = list(args.observed)
        if args.gap:
            slot["gaps"] = list(dict.fromkeys((slot.get("gaps") or []) + list(args.gap)))
        ev = ledger.setdefault("evidence", {}).setdefault(
            "customerImpact",
            {"status": "pending", "artifact": None, "summary": None, "updatedAt": None},
        )
        ev.update(
            {
                "status": status,
                "artifact": args.artifact,
                "summary": args.summary or slot.get("summary"),
                "updatedAt": now,
            }
        )
    else:
        ev = ledger.setdefault("evidence", {}).setdefault(
            key,
            {"status": "pending", "artifact": None, "summary": None, "updatedAt": None},
        )
        ev["status"] = status
        if args.artifact is not None:
            ev["artifact"] = args.artifact
        if args.summary is not None:
            ev["summary"] = args.summary
        ev["updatedAt"] = now
        if key == "planReadinessRequest":
            ev["planSha256"] = plan_sha256(ledger, root) if status == "pass" else None
            if status == "pass" and ev["planSha256"] is None:
                die("cannot record planReadinessRequest=pass: recorded plan is missing, outside this worktree, or unreadable")
            if status == "pass":
                reset_plan_technical_review(ledger, "fresh execution-ready review request")
                reset_implementation_approval(ledger, "fresh execution-ready review request")
                reset_implementation_profile(ledger, "fresh execution-ready review request")

    if args.pr_url:
        ledger["prUrl"] = args.pr_url
    if args.doct_url:
        ledger["doctUrl"] = args.doct_url
    if args.plan:
        if ledger.get("plan") != args.plan:
            reset_plan_readiness_request(ledger, "recorded plan path changed")
            reset_plan_technical_review(ledger, "recorded plan path changed")
            reset_implementation_approval(ledger, "recorded plan path changed")
            reset_implementation_profile(ledger, "recorded plan path changed")
        ledger["plan"] = args.plan

    append_history(ledger, "record", f"{key}={status}", key=key, status=status)
    refresh_git_fields(ledger, root)
    write_json(path, ledger)
    print(f"recorded {key}={status}")
    return 0


COMPLETENESS_REVIEW_MODEL = "xai/grok-4.5:high"


def completeness_reviewer_name(ledger: dict[str, Any]) -> str:
    identity = str(ledger.get("issue") or ledger.get("slug") or ledger.get("id") or "delivery")
    return f"completeness-{slugify(identity, max_len=36, keep_issue_keys=True)}"


def completeness_review_prompt(ledger: dict[str, Any], root: Path, *, rerun: bool, request_id: str) -> str:
    plan = str(ledger.get("plan") or "(no plan path recorded)")
    round_text = "This is a rereview after the driving agent addressed prior findings." if rerun else "This is the initial completeness review."
    return f"""You are the visible, read-only plan-completeness reviewer for this delivery run.

{round_text}
Worktree: {root}
Plan: {plan}
Delivery stage: {ledger.get('stage')}
Completeness-review request ID: {request_id}

Inspect the current live worktree, including committed, staged, unstaged, and untracked changes. Read the plan, diff, plan-progress/validation artifacts, and the driving agent's stated verification evidence. Do not edit files. Do not run tests, builds, linters, or other executable verification.

Check whether the implementation is complete according to the plan: every acceptance criterion and BDD scenario, required producer/consumer or cross-surface wiring, real post-mutation UI states, stated non-goals, and truthful verification. Do not accept a green helper/unit test as proof that the user-visible completion state works.

Start your response with `COMPLETENESS_REVIEW_RESPONSE_ID: {request_id}`, immediately followed by your verdict. Return exactly one verdict:
- VERDICT: FINDINGS_TO_RESOLVE — for an in-plan gap, with criterion/BDD reference, concrete evidence, user impact, and smallest correction.
- VERDICT: COMPLETE — only when the plan is complete by substance. Include an AC/BDD coverage table and a `Not examined:` line.
- VERDICT: BLOCKED_BY_QUESTION — only for a real plan or product decision.

The driving agent will read your visible response, make in-scope corrections, and ask you to rereview until the implementation and this review agree it is complete."""


def _fingerprint_paths(root: Path, paths: list[str], digest: Any) -> None:
    for raw in sorted(paths):
        # Delivery's own ledger is process metadata, not candidate implementation content.
        if raw == ".delivery" or raw.startswith(".delivery/"):
            continue
        candidate = root / raw
        digest.update(raw.encode("utf-8") + b"\0")
        if candidate.is_file():
            digest.update(candidate.read_bytes())
        else:
            # Keep deletions and broken paths distinct from an empty file.
            digest.update(b"<missing>")


def working_tree_fingerprint(root: Path) -> str:
    """Fingerprint worktree content independently of whether it has been committed."""
    digest = hashlib.sha256()
    tracked = run_cmd(["git", "ls-files", "-z"], cwd=root)
    if tracked.returncode != 0:
        die("cannot list tracked files for completeness review")
    untracked = run_cmd(["git", "ls-files", "--others", "--exclude-standard", "-z"], cwd=root)
    if untracked.returncode != 0:
        die("cannot list untracked files for completeness review")
    _fingerprint_paths(
        root,
        [part for part in tracked.stdout.split("\0") if part]
        + [part for part in untracked.stdout.split("\0") if part],
        digest,
    )
    return digest.hexdigest()


def completeness_review_problem(ledger: dict[str, Any], root: Path) -> str | None:
    review = ledger.get("completenessReview") or {}
    if review.get("status") == "waived" and review.get("summary"):
        return None
    if review.get("status") != "complete":
        return "visible completeness review has not been accepted"
    if review.get("verdict") != "COMPLETE":
        return "visible completeness review did not return VERDICT: COMPLETE"
    plan_fingerprint = plan_sha256(ledger, root)
    if not plan_fingerprint or review.get("planSha256") != plan_fingerprint:
        return "visible completeness review is stale for the current plan"
    if review.get("worktreeFingerprint") != working_tree_fingerprint(root):
        return "visible completeness review is stale for the current worktree"
    artifact = review.get("artifact")
    if not isinstance(artifact, str) or not (root / artifact).is_file():
        return "visible completeness review artifact is missing"
    return None


def completion_artifact_path(root: Path, ledger: dict[str, Any], requested: str | None) -> tuple[Path, str]:
    slug = slugify(str(ledger.get("slug") or ledger.get("issue") or "delivery"))
    raw = Path(requested or f"thoughts/validation/{slug}-completeness.md")
    candidate = raw if raw.is_absolute() else root / raw
    try:
        resolved = candidate.resolve()
        relative = resolved.relative_to(root.resolve())
    except ValueError:
        die("completeness review artifact must be inside the worktree")
    return resolved, relative.as_posix()


def cmd_completion_review(args: argparse.Namespace) -> int:
    """Launch, rerequest, or accept the visible adjacent Pi plan-completeness review."""
    path, ledger, root = load_ledger_for(args)
    labels = ledger.get("labels") or {}
    review = ledger.get("completenessReview") or {}
    source_pane = args.pane or os.environ.get("HERDR_PANE_ID") or labels.get("herdrPaneId")
    reviewer_name = args.agent_name or review.get("agentName") or completeness_reviewer_name(ledger)

    if args.waive:
        if not args.summary:
            die("completion-review --waive requires --summary describing the direct operator waiver")
        ledger["completenessReview"] = {"status": "waived", "summary": args.summary, "waivedAt": utc_now()}
        append_history(ledger, "completeness_review", "operator waived visible completeness review")
        refresh_git_fields(ledger, root)
        write_json(path, ledger)
        print("visible completeness review waived")
        return 0

    if args.accept:
        reviewer_pane = review.get("paneId")
        if not reviewer_pane:
            die("no visible completeness reviewer is recorded; run `delivery completion-review` first")
        plan_fingerprint = plan_sha256(ledger, root)
        if not plan_fingerprint:
            die("cannot accept completeness review: recorded plan is missing, outside this worktree, or unreadable")
        transcript = run_cmd(["herdr", "agent", "read", reviewer_name, "--source", "recent-unwrapped", "--lines", "500"], cwd=root)
        if transcript.returncode != 0:
            die(f"could not read visible completeness reviewer: {(transcript.stderr or transcript.stdout).strip()}")
        request_id = review.get("requestId")
        if not isinstance(request_id, str) or not request_id:
            die("recorded completeness review has no request ID; run `delivery completion-review --rerun`")
        response_pattern = re.compile(
            rf"COMPLETENESS_REVIEW_RESPONSE_ID:\s*{re.escape(request_id)}\s*\nVERDICT:\s*(FINDINGS_TO_RESOLVE|COMPLETE|BLOCKED_BY_QUESTION)"
        )
        verdicts = response_pattern.findall(transcript.stdout)
        verdict = verdicts[-1] if verdicts else None
        if verdict != "COMPLETE":
            die("visible reviewer has not returned a matching latest `VERDICT: COMPLETE`; address findings and run `delivery completion-review --rerun`")
        artifact_path, artifact_rel = completion_artifact_path(root, ledger, args.artifact)
        artifact_path.parent.mkdir(parents=True, exist_ok=True)
        artifact_path.write_text(
            f"# Visible completeness review\n\n- Reviewer: {reviewer_name}\n- Model: {COMPLETENESS_REVIEW_MODEL}\n- Accepted: {utc_now()}\n\n## Transcript\n\n{transcript.stdout}",
            encoding="utf-8",
        )
        ledger["completenessReview"] = {
            **review,
            "status": "complete",
            "verdict": verdict,
            "artifact": artifact_rel,
            "planSha256": plan_fingerprint,
            "worktreeFingerprint": working_tree_fingerprint(root),
            "acceptedAt": utc_now(),
        }
        ev = ledger.setdefault("evidence", {}).setdefault("completenessReview", {})
        ev.update({"status": "pass", "artifact": artifact_rel, "summary": "Visible Grok 4.5 reviewer returned COMPLETE", "updatedAt": utc_now()})
        append_history(ledger, "completeness_review", "visible Grok 4.5 review accepted", agent=reviewer_name, paneId=str(reviewer_pane), artifact=artifact_rel)
        refresh_git_fields(ledger, root)
        write_json(path, ledger)
        print(f"visible completeness review accepted -> {artifact_rel}")
        return 0

    if not source_pane:
        die("completion-review needs --pane, HERDR_PANE_ID, or a delivery spawn pane")
    request_id = uuid.uuid4().hex
    prompt = completeness_review_prompt(ledger, root, rerun=bool(args.rerun), request_id=request_id)
    start_command = [
        "herdr", "agent", "start", reviewer_name, "--kind", "pi", "--pane", "<reviewer-pane>",
        "--timeout", str(args.timeout_ms), "--", "--model", COMPLETENESS_REVIEW_MODEL,
    ]

    if args.dry_run:
        print(json.dumps({
            "sourcePane": source_pane,
            "reviewerName": reviewer_name,
            "model": COMPLETENESS_REVIEW_MODEL,
            "rerun": bool(args.rerun),
            "splitCommand": ["herdr", "pane", "split", str(source_pane), "--direction", "right", "--cwd", str(root), "--no-focus"],
            "startCommand": start_command,
            "prompt": prompt,
        }, indent=2))
        return 0

    if args.rerun:
        reviewer_pane = review.get("paneId")
        if not reviewer_pane:
            die("no visible completeness reviewer is recorded; run `delivery completion-review` first")
    else:
        split = herdr_json(["pane", "split", str(source_pane), "--direction", "right", "--cwd", str(root), "--no-focus"], cwd=root)
        split_result = split.get("result") if isinstance(split.get("result"), dict) else split
        pane = split_result.get("pane") if isinstance(split_result.get("pane"), dict) else split_result
        reviewer_pane = pane.get("pane_id")
        if not reviewer_pane:
            die(f"herdr pane split returned no pane id: {split}")
        start_command[7] = str(reviewer_pane)
        started = run_cmd(start_command, cwd=root)
        if started.returncode != 0:
            die(f"could not start visible completeness reviewer: {(started.stderr or started.stdout).strip()}")

    requested = run_cmd(["herdr", "agent", "prompt", reviewer_name, prompt], cwd=root)
    if requested.returncode != 0:
        die(f"could not prompt visible completeness reviewer: {(requested.stderr or requested.stdout).strip()}")

    ledger["completenessReview"] = {
        "status": "pending",
        "agentName": reviewer_name,
        "paneId": str(reviewer_pane),
        "model": COMPLETENESS_REVIEW_MODEL,
        "requestId": request_id,
        "lastRequestedAt": utc_now(),
        "round": int(review.get("round") or 0) + 1,
    }
    ledger.setdefault("evidence", {}).setdefault("completenessReview", {}).update({"status": "pending", "updatedAt": utc_now()})
    append_history(ledger, "completeness_review", "visible Grok 4.5 review requested", agent=reviewer_name, paneId=str(reviewer_pane), rerun=bool(args.rerun))
    refresh_git_fields(ledger, root)
    write_json(path, ledger)
    print(f"visible completeness reviewer: {reviewer_name} in {reviewer_pane}")
    print("next: read the reviewer response, fix any in-plan findings, then run `delivery completion-review --rerun`; after COMPLETE run `delivery completion-review --accept`")
    return 0


def cmd_blocker(args: argparse.Namespace) -> int:
    path, ledger, root = load_ledger_for(args)
    text = " ".join(args.text).strip()
    if args.clear:
        ledger["blockers"] = []
        if ledger.get("stage") == "BLOCKED" and args.stage:
            ledger["stage"] = args.stage
        append_history(ledger, "blocker_clear", "blockers cleared")
    elif text:
        ledger.setdefault("blockers", []).append({"at": utc_now(), "text": text})
        if args.mark_blocked:
            ledger["stage"] = "BLOCKED"
        append_history(ledger, "blocker", text)
    else:
        die("provide blocker text or --clear")
    refresh_git_fields(ledger, root)
    maybe_herdr_label(ledger)
    write_json(path, ledger)
    print("ok")
    return 0


def build_advisories(ledger: dict[str, Any]) -> list[dict[str, str]]:
    stage = str(ledger.get("stage") or "INTAKE")
    advisories: list[dict[str, str]] = []
    evidence = ledger.get("evidence") or {}

    def add(code: str, message: str, severity: str = "info") -> None:
        advisories.append({"code": code, "severity": severity, "message": message})

    add("NEXT", STAGE_NEXT_SKILL.get(stage, "No mapped next skill"), "info")

    if stage == "EXECUTION_READY":
        approval_problem = implementation_approval_problem(ledger, Path(ledger.get("worktree") or Path.cwd()))
        if approval_problem:
            add(
                "IMPLEMENTATION_APPROVAL",
                "Implementation is paused: "
                f"{approval_problem}. Present the operator summary and wait for approval.",
                "warn",
            )

    for key, stages in RECOMMENDED_EVIDENCE.items():
        if stage not in stages:
            continue
        slot = evidence.get(key) or {}
        status = slot.get("status") or "pending"
        if status in {"pass", "skip", "na"}:
            continue
        if status == "gap":
            add(
                f"GAP_{key}",
                f"Recommended evidence '{key}' is marked gap"
                + (f": {slot.get('summary')}" if slot.get("summary") else ""),
                "warn",
            )
        else:
            add(
                f"MISSING_{key}",
                f"Recommended evidence '{key}' is {status} at stage {stage}. "
                f"Record with: delivery record {key} --status pass|skip|gap|na",
                "warn",
            )

    # Completion / customer impact soft prompts near the end of the cycle.
    if stage in {"IMPL_PM_OUTCOME", "AUTOREVIEW", "VERIFY_FRESHNESS", "PR_OPEN", "MERGE_READY"}:
        ce = ledger.get("completionEval") or {}
        if (ce.get("status") or "pending") in {"pending", "gap"}:
            add(
                "COMPLETION_EVAL",
                "Consider a completion evaluation against plan AC/BDD/progress before calling the work done.",
                "warn",
            )
        ci = ledger.get("customerImpact") or {}
        if not ci.get("summary") and not (ci.get("promised") or ci.get("observed")):
            if (evidence.get("customerImpact") or {}).get("status") not in {"pass", "skip", "na"}:
                add(
                    "CUSTOMER_IMPACT",
                    "Consider recording customer/operator impact promised vs observed "
                    "(delivery record customerImpact --status pass --summary '...').",
                    "warn",
                )

    if stage in {"MERGE_READY", "PR_OPEN", "ADVERSARIAL_QA", "DONE"}:
        aq = evidence.get("adversarialQa") or {}
        if (aq.get("status") or "pending") == "pending":
            add(
                "QA_OPTIONAL",
                "If this change touches a customer-visible path, consider adversarial golden-path QA "
                "(/qa:run) or record adversarialQa --status na.",
                "info",
            )

    if ledger.get("blockers"):
        add("BLOCKERS", f"{len(ledger['blockers'])} blocker note(s) present", "warn")

    if not ledger.get("plan") and stage not in {"INTAKE", "DONE"}:
        add("PLAN_PATH", "No plan path recorded yet (delivery record plan via --plan on record/init).", "info")

    if stage in {"REFLECT", "DONE", "MERGE_READY", "PR_OPEN", "BLOCKED"} and not ledger.get(
        "lastReflectionAt"
    ):
        add(
            "REFLECT",
            "No end-of-run reflection logged yet. "
            "Recommended: delivery reflect --trigger end-of-run --friction '...' "
            "--improvement '...' --mark-done  (writes ~/.pi/DELIVERY_REFLECTIONS.md).",
            "info" if stage in {"PR_OPEN", "MERGE_READY"} else "warn",
        )

    return advisories


def cmd_check(args: argparse.Namespace) -> int:
    path, ledger, root = load_ledger_for(args)
    refresh_git_fields(ledger, root)
    advisories = build_advisories(ledger)
    ledger["advisories"] = advisories
    ledger["updatedAt"] = utc_now()
    # Persist latest advisories for board visibility; never fail on gaps.
    write_json(path, ledger)

    payload = {
        "id": ledger.get("id"),
        "stage": ledger.get("stage"),
        "path": str(path),
        "doctrine": "guidance-not-gates",
        "hardBlock": False,
        "advisories": advisories,
        "next": STAGE_NEXT_SKILL.get(str(ledger.get("stage")), None),
    }
    if args.json:
        print(json.dumps(payload, indent=2))
    else:
        print(f"stage: {ledger.get('stage')}  (guidance only; never hard-blocks)")
        print(f"next:  {payload['next']}")
        warns = [a for a in advisories if a.get("severity") == "warn"]
        infos = [a for a in advisories if a.get("severity") != "warn"]
        if warns:
            print("advisories:")
            for a in warns:
                print(f"  ! [{a['code']}] {a['message']}")
        if infos and args.verbose:
            print("info:")
            for a in infos:
                print(f"  - [{a['code']}] {a['message']}")
        elif not warns:
            print("advisories: none beyond next-step guidance")
        print("exit: 0 (gaps do not block continuation)")
    # Doctrine: always succeed.
    return 0


def iter_ledger_paths(extra_roots: list[Path] | None = None) -> list[Path]:
    found: list[Path] = []
    seen: set[Path] = set()

    def add(path: Path) -> None:
        path = path.resolve()
        if path in seen or not path.is_file():
            return
        seen.add(path)
        found.append(path)

    cwd_ledger = detect_repo_root() / LEDGER_REL
    add(cwd_ledger)

    if HERDR_WORKTREES.is_dir():
        for path in HERDR_WORKTREES.glob("*/*/.delivery/ledger.json"):
            add(path)

    for root in extra_roots or []:
        add(Path(root) / LEDGER_REL)

    return found


def summarize_ledger(path: Path) -> dict[str, Any] | None:
    try:
        ledger = load_json(path)
    except SystemExit:
        return None
    return {
        "id": ledger.get("id"),
        "stage": ledger.get("stage"),
        "issue": ledger.get("issue"),
        "plan": ledger.get("plan"),
        "branch": ledger.get("branch"),
        "worktree": ledger.get("worktree") or str(path.parent.parent),
        "prUrl": ledger.get("prUrl"),
        "updatedAt": ledger.get("updatedAt"),
        "blockers": len(ledger.get("blockers") or []),
        "path": str(path),
        "next": STAGE_NEXT_SKILL.get(str(ledger.get("stage")), None),
    }


def cmd_board(args: argparse.Namespace) -> int:
    paths = iter_ledger_paths([Path(p) for p in (args.root or [])])
    rows = []
    for path in paths:
        row = summarize_ledger(path)
        if row:
            rows.append(row)
    # Active first (not DONE), then newest updatedAt.
    rows.sort(
        key=lambda r: (
            0 if r.get("stage") != "DONE" else 1,
            -_parse_ts(r.get("updatedAt")),
            str(r.get("id") or ""),
        )
    )

    if args.json:
        print(json.dumps({"count": len(rows), "runs": rows}, indent=2))
        return 0

    if not rows:
        print("no delivery ledgers found")
        print(f"scanned: cwd, {HERDR_WORKTREES}/*/*/.delivery/ledger.json")
        return 0

    # Simple table
    print(f"{'STAGE':<18} {'ISSUE':<14} {'ID':<36} {'UPDATED':<22} PATH")
    for r in rows:
        print(
            f"{str(r.get('stage') or '-'):<18} "
            f"{str(r.get('issue') or '-'):<14} "
            f"{str(r.get('id') or '-'):<36} "
            f"{str(r.get('updatedAt') or '-'):<22} "
            f"{r.get('path')}"
        )
    return 0


def _parse_ts(value: Any) -> float:
    if not value or not isinstance(value, str):
        return 0.0
    try:
        cleaned = value.replace("Z", "+00:00")
        return datetime.fromisoformat(cleaned).timestamp()
    except ValueError:
        return 0.0


def cmd_status(args: argparse.Namespace) -> int:
    # Alias: single-run show if ledger present, else board.
    root = Path(args.cwd).resolve() if args.cwd else detect_repo_root()
    path = find_ledger_path(root, args.ledger)
    if path.exists() and not args.all:
        args.json = args.json
        return cmd_show(args)
    return cmd_board(args)


def cmd_stages(_: argparse.Namespace) -> int:
    print(f"{'STAGE':<22} {'CODE':<5} NEXT")
    for stage in STAGES:
        code = phase_code(stage)
        print(f"{stage:<22} {code:<5} {STAGE_NEXT_SKILL.get(stage, '')}")
    return 0


ISSUE_KEY_RE = re.compile(r"\b([A-Za-z][A-Za-z0-9]*-\d+)\b")


def extract_issue_key(text: str) -> str | None:
    """Best-effort Linear-style key from freeform operator text."""
    if not text:
        return None
    matches = ISSUE_KEY_RE.findall(text)
    if not matches:
        return None
    # Prefer the first KEY-123 form; normalize to uppercase.
    return matches[0].upper()


def strip_issue_keys(text: str) -> str:
    """Remove issue keys so slug/label come from the intent words."""
    cleaned = ISSUE_KEY_RE.sub(" ", text or "")
    cleaned = re.sub(
        r"\b(linear|issue|ticket)\b[:\s]*", " ", cleaned, flags=re.IGNORECASE
    )
    return re.sub(r"\s+", " ", cleaned).strip()


def slugify(text: str, *, max_len: int = 48, keep_issue_keys: bool = False) -> str:
    raw = (text or "").strip()
    if not keep_issue_keys:
        raw = strip_issue_keys(raw)
    raw = raw.lower()
    # drop common stop-ish prefixes operators type when asking
    raw = re.sub(
        r"^(please\s+)?(help\s+me\s+)?(can\s+you\s+)?(to\s+)?",
        "",
        raw,
    )
    raw = re.sub(
        r"^(fix|implement|build|add|make|create|ship|start|spawn)\s+",
        "",
        raw,
    )
    raw = raw.replace("&", " and ")
    raw = re.sub(r"[^a-z0-9]+", "-", raw)
    raw = re.sub(r"-+", "-", raw).strip("-")
    if not raw:
        raw = "delivery"
    if len(raw) > max_len:
        raw = raw[:max_len].rstrip("-")
    return raw or "delivery"


def short_label(text: str, *, max_len: int = 36) -> str:
    text = re.sub(r"\s+", " ", (text or "").strip())
    if len(text) <= max_len:
        return text or "delivery"
    cut = text[: max_len - 1].rsplit(" ", 1)[0]
    return (cut or text[: max_len - 1]).rstrip() + "…"


def run_cmd(
    args: list[str],
    *,
    cwd: Path | None = None,
    check: bool = False,
    env: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    merged = os.environ.copy()
    if env:
        merged.update(env)
    return subprocess.run(
        args,
        cwd=str(cwd) if cwd else None,
        check=check,
        capture_output=True,
        text=True,
        env=merged,
    )


def require_herdr() -> str:
    path = shutil.which("herdr")
    if not path:
        die("herdr not found on PATH; install/start Herdr before delivery spawn")
    return path


def herdr_json(args: list[str], *, cwd: Path | None = None) -> dict[str, Any]:
    herdr = require_herdr()
    proc = run_cmd([herdr, *args, "--json"], cwd=cwd)
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or "").strip()
        die(f"herdr {' '.join(args)} failed ({proc.returncode}): {detail}")
    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        die(f"herdr returned non-JSON: {exc}\n{proc.stdout[:500]}")
    if not isinstance(payload, dict):
        die("herdr JSON root must be an object")
    return payload


def unique_branch_name(repo: Path, base_slug: str, issue: str | None) -> str:
    if issue:
        # Keep TEAM-123 form; do not strip issue keys here.
        issue_slug = slugify(issue, max_len=32, keep_issue_keys=True)
        candidate = issue_slug
    else:
        candidate = base_slug
    # Prefer short delivery/ prefix only when no issue, to avoid colliding with mainline names.
    if not issue:
        candidate = f"delivery/{candidate}"

    def exists(name: str) -> bool:
        local = run_cmd(["git", "show-ref", "--verify", "--quiet", f"refs/heads/{name}"], cwd=repo)
        remote = run_cmd(
            ["git", "show-ref", "--verify", "--quiet", f"refs/remotes/origin/{name}"],
            cwd=repo,
        )
        return local.returncode == 0 or remote.returncode == 0

    if not exists(candidate):
        return candidate
    suffix = datetime.now(timezone.utc).strftime("%m%d%H%M")
    alt = f"{candidate}-{suffix}"
    if not exists(alt):
        return alt
    return f"{candidate}-{int(time.time()) % 100000}"


def default_spawn_agent_name(workspace_id: str | None) -> str:
    """Create a unique, Herdr-valid agent name for a new delivery workspace."""
    if workspace_id:
        # Workspace IDs are opaque and can contain uppercase characters, while
        # Herdr agent names permit only lowercase letters, digits, '-' and '_'.
        # Hex encoding preserves the exact workspace identity without collisions.
        token = str(workspace_id).encode("utf-8").hex()
        name = f"delivery-{token}"
        if len(name) <= 32:
            return name
    # Worktree creation normally returns a short workspace ID. Retain collision
    # safety if an older response omits it or exceeds Herdr's name-length limit.
    return f"delivery-{uuid.uuid4().hex[:23]}"


def agent_start_prompt(goal: str, *, issue: str | None, worktree: str) -> str:
    issue_line = (
        f"Linear issue is attached as {issue}."
        if issue
        else "Linear issue is optional; if one appears later run: delivery set --issue KEY --retarget-id"
    )
    return (
        "You were spawned into a fresh Herdr delivery worktree.\n\n"
        f"Worktree: {worktree}\n"
        f"Goal: {goal}\n"
        f"{issue_line}\n\n"
        "Do this now:\n"
        "1. Read `.delivery/AGENT_BRIEF.md` fully.\n"
        "2. Run `delivery show` and `delivery check -v`.\n"
        "3. Continue from the brief's **Recommended next step** using existing worker skills\n"
        "   (reviewed-html-plan / dev-plan → Sol-medium planner review → dedicated Sol-medium implementation → Terra autoreview → Grok completeness → PR).\n"
        "   During `PLAN_BROWSER_REVIEW`, integrate ordinary feedback but wait for Doct's explicit\n"
        "   `Request execution-ready review` action before PM or technical readiness review.\n"
        "4. Keep the delivery ledger current with `delivery stage` / `delivery record`.\n"
        "5. Before finishing: `delivery reflect --trigger end-of-run --friction '...' "
        "--improvement '...' --mark-done`.\n\n"
        "Doctrine: guidance, not gates. Missing delivery evidence is advisory only — "
        "never hard-block the operator solely because a recommended check is pending.\n"
    )


def cmd_spawn(args: argparse.Namespace) -> int:
    """Create a Herdr worktree named from the goal and bootstrap delivery there."""
    goal_parts = [p for p in (args.goal or []) if p and p != "--"]
    # Drop a leading bare flag fragment if REMAINDER captured options incorrectly.
    while goal_parts and goal_parts[0] in {"-", "--"}:
        goal_parts.pop(0)
    goal = " ".join(goal_parts).strip()
    if not goal:
        die('goal text required, e.g. delivery spawn "honest auto-sync status"')

    repo = Path(args.cwd).resolve() if args.cwd else detect_repo_root()
    if not (repo / ".git").exists() and not (repo / ".git").is_file():
        # allow worktree paths that point at linked git via rev-parse
        top = git_capture(repo, "rev-parse", "--show-toplevel")
        if not top:
            die(f"not a git repo: {repo}")
        repo = Path(top)

    # Freeform-first: operators paste a request; agents/flags only override.
    inferred_issue = extract_issue_key(goal)
    issue = (args.issue.strip().upper() if args.issue else None) or inferred_issue
    intent_text = strip_issue_keys(goal) or goal
    slug = slugify(args.slug) if args.slug else slugify(intent_text)
    branch = args.branch or unique_branch_name(repo, slug, issue)
    label_basis = intent_text if intent_text else goal
    label = args.label or (
        f"{issue} · {short_label(label_basis, max_len=28)}"
        if issue
        else short_label(label_basis)
    )
    base = args.base or "origin/main"
    focus = bool(args.focus)
    requested_stage = args.stage or "INTAKE"
    if requested_stage not in STAGES:
        die(f"unknown stage {requested_stage!r}; choose from: {', '.join(STAGES)}")
    stage_probe = {
        "stage": requested_stage,
        "plan": args.plan,
        "evidence": empty_evidence(),
        "implementationApproval": {"status": "pending"},
    }
    transition_problem = stage_transition_problem(stage_probe, repo, requested_stage)
    if transition_problem:
        die(
            f"cannot initialize at {requested_stage}: {transition_problem}. "
            "Create the worktree at INTAKE and advance through delivery's guarded steps."
        )

    # Ensure base exists when possible (non-fatal if offline).
    base_ok = run_cmd(["git", "rev-parse", "--verify", f"{base}^{{commit}}"], cwd=repo)
    if base_ok.returncode != 0:
        fetch = run_cmd(["git", "fetch", "--prune", "--tags"], cwd=repo)
        if fetch.returncode != 0:
            die(
                f"base ref {base!r} not found and git fetch failed: "
                f"{(fetch.stderr or fetch.stdout or '').strip()}"
            )
        base_ok = run_cmd(["git", "rev-parse", "--verify", f"{base}^{{commit}}"], cwd=repo)
        if base_ok.returncode != 0:
            die(f"base ref {base!r} still not found after fetch")

    if args.dry_run:
        preview_stage = requested_stage
        preview_ledger = {
            "issue": issue,
            "slug": slug,
            "goal": goal,
            "stage": preview_stage,
            "labels": {"baseTitle": sanitize_base_title(label)},
            "spawn": {"label": label},
        }
        payload = {
            "dryRun": True,
            "repo": str(repo),
            "goal": goal,
            "intent": intent_text,
            "issue": issue,
            "issueInferred": bool(inferred_issue) and not bool(args.issue),
            "slug": slug,
            "branch": branch,
            "label": herdr_display_label(preview_ledger),
            "baseTitle": sanitize_base_title(label),
            "phaseCode": phase_code(preview_stage),
            "base": base,
            "focus": focus,
            "agent": None if args.no_agent else (args.agent or "pi"),
        }
        print(json.dumps(payload, indent=2))
        return 0

    create_args = [
        "worktree",
        "create",
        "--cwd",
        str(repo),
        "--branch",
        branch,
        "--base",
        base,
        "--label",
        label,
    ]
    if args.path:
        create_args.extend(["--path", str(Path(args.path).expanduser())])
    create_args.append("--focus" if focus else "--no-focus")

    created = herdr_json(create_args)
    result = created.get("result") if isinstance(created.get("result"), dict) else created
    root_pane = result.get("root_pane") or {}
    workspace = result.get("workspace") or {}
    worktree = result.get("worktree") or {}
    tab = result.get("tab") or {}

    worktree_path = (
        worktree.get("path")
        or (workspace.get("worktree") or {}).get("checkout_path")
        or root_pane.get("cwd")
    )
    if not worktree_path:
        die(f"herdr create succeeded but no worktree path in response: {created}")
    worktree_path = str(worktree_path)
    pane_id = root_pane.get("pane_id")
    tab_id = tab.get("tab_id") or root_pane.get("tab_id")
    workspace_id = (
        workspace.get("workspace_id")
        or root_pane.get("workspace_id")
        or worktree.get("open_workspace_id")
    )

    # Bootstrap delivery navigator inside the new worktree (in-process).
    boot_ns = argparse.Namespace(
        cwd=worktree_path,
        ledger=None,
        json=False,
        issue=issue,
        slug=slug,
        plan=args.plan,
        doct_url=None,
        pr_url=None,
        goal=goal,
        stage=args.stage or "INTAKE",
        id=None,
        retarget_id=bool(issue),
        refresh=False,
        force=False,
    )
    # Bootstrap runs in this parent process, whose HERDR_* variables still
    # identify the caller. Suppress its best-effort label sync; spawn applies
    # the label to the explicit destination IDs after recording them.
    bootstrap_skip = os.environ.get("DELIVERY_SKIP_HERDR")
    os.environ["DELIVERY_SKIP_HERDR"] = "1"
    try:
        # bootstrap prints a long brief; capture by temporarily redirecting if quiet
        if args.quiet:
            import io
            from contextlib import redirect_stdout

            buf = io.StringIO()
            with redirect_stdout(buf):
                cmd_bootstrap(boot_ns)
        else:
            print("--- delivery bootstrap ---")
            cmd_bootstrap(boot_ns)
    finally:
        if bootstrap_skip is None:
            os.environ.pop("DELIVERY_SKIP_HERDR", None)
        else:
            os.environ["DELIVERY_SKIP_HERDR"] = bootstrap_skip

    agent_name = None
    agent_kind = None
    prompted = False
    agent_status = None
    if not args.no_agent:
        agent_kind = args.agent or "pi"
        agent_name = args.agent_name or default_spawn_agent_name(workspace_id)
        if not pane_id:
            agent_status = "skipped-no-pane"
            print("delivery spawn: no pane id from herdr; skipped agent start", file=sys.stderr)
        else:
            start = run_cmd(
                [
                    "herdr",
                    "agent",
                    "start",
                    agent_name,
                    "--kind",
                    agent_kind,
                    "--pane",
                    str(pane_id),
                    "--timeout",
                    str(args.agent_timeout_ms),
                ]
            )
            if start.returncode != 0:
                agent_status = "start-failed"
                print(
                    "delivery spawn: herdr agent start failed; worktree+bootstrap are ready.\n"
                    f"{(start.stderr or start.stdout or '').strip()}",
                    file=sys.stderr,
                )
            else:
                prompt = agent_start_prompt(goal, issue=issue, worktree=worktree_path)
                prompt_cmd = [
                    "herdr",
                    "agent",
                    "prompt",
                    agent_name,
                    prompt,
                ]
                if args.wait_agent:
                    prompt_cmd.extend(
                        [
                            "--wait",
                            "--until",
                            "idle",
                            "--until",
                            "done",
                            "--until",
                            "blocked",
                            "--timeout",
                            str(args.wait_timeout_ms),
                        ]
                    )
                pr = run_cmd(prompt_cmd)
                prompted = pr.returncode == 0
                agent_status = "prompted" if prompted else "prompt-failed"
                if pr.returncode != 0:
                    print(
                        "delivery spawn: agent started but initial prompt failed.\n"
                        f"{(pr.stderr or pr.stdout or '').strip()}\n"
                        "Paste /delivery:bootstrap manually in the pane.",
                        file=sys.stderr,
                    )

    summary = {
        "goal": goal,
        "issue": issue,
        "slug": slug,
        "branch": branch,
        "label": label,
        "base": base,
        "repo": str(repo),
        "worktree": worktree_path,
        "workspaceId": workspace_id,
        "tabId": tab_id,
        "paneId": pane_id,
        "ledger": str(Path(worktree_path) / LEDGER_REL),
        "brief": str(Path(worktree_path) / ".delivery" / "AGENT_BRIEF.md"),
        "agent": {
            "name": agent_name,
            "kind": agent_kind,
            "prompted": prompted,
            "status": agent_status,
        }
        if not args.no_agent
        else None,
        "next": "Open the Herdr workspace and let the agent follow .delivery/AGENT_BRIEF.md",
    }

    # Record spawn + apply phase-prefixed Herdr space/tab labels.
    display_label = label
    ledger_path = Path(worktree_path) / LEDGER_REL
    if ledger_path.exists():
        ledger = load_json(ledger_path)
        ledger["spawn"] = {
            "at": utc_now(),
            "branch": branch,
            "label": label,
            "workspaceId": workspace_id,
            "tabId": tab_id,
            "paneId": pane_id,
            "fromRepo": str(repo),
        }
        labels = ledger.setdefault("labels", {})
        labels["baseTitle"] = sanitize_base_title(label)
        if workspace_id:
            labels["herdrWorkspaceId"] = str(workspace_id)
        if tab_id:
            labels["herdrTabId"] = str(tab_id)
        if pane_id:
            labels["herdrPaneId"] = str(pane_id)
        append_history(ledger, "spawn", f"herdr worktree {branch}")
        # Temporarily allow herdr renames even if parent had SKIP set for tests.
        prev_skip = os.environ.get("DELIVERY_SKIP_HERDR")
        if args.dry_run:
            pass
        else:
            # Spawn always attempts label sync for the new workspace.
            os.environ.pop("DELIVERY_SKIP_HERDR", None)
            try:
                maybe_herdr_label(
                    ledger,
                    targets={
                        "workspaceId": str(workspace_id) if workspace_id else None,
                        "tabId": str(tab_id) if tab_id else None,
                        "paneId": str(pane_id) if pane_id else None,
                    },
                )
            finally:
                if prev_skip is not None:
                    os.environ["DELIVERY_SKIP_HERDR"] = prev_skip
        display_label = str((ledger.get("labels") or {}).get("herdr") or herdr_display_label(ledger))
        write_json(ledger_path, ledger)
    else:
        # Fallback rename without ledger.
        display_label = f"{phase_code(args.stage or 'INTAKE')}: {sanitize_base_title(label)}"
        if workspace_id:
            run_cmd(["herdr", "workspace", "rename", str(workspace_id), display_label])
        if tab_id:
            run_cmd(["herdr", "tab", "rename", str(tab_id), display_label])

    summary["label"] = display_label
    summary["phaseCode"] = phase_code(args.stage or "INTAKE")

    if args.json:
        print(json.dumps(summary, indent=2))
    else:
        print("delivery spawn ready")
        print(f"goal:      {goal}")
        print(f"label:     {display_label}")
        print(f"branch:    {branch}")
        print(f"worktree:  {worktree_path}")
        print(f"workspace: {workspace_id}")
        print(f"pane:      {pane_id}")
        print(f"brief:     {summary['brief']}")
        if summary.get("agent"):
            print(f"agent:     {agent_kind}:{agent_name} ({agent_status})")
        print("next:      watch the Herdr workspace; agent should follow AGENT_BRIEF.md")
    return 0


def _reflect_timestamp(now: datetime | None = None) -> str:
    now = now or datetime.now().astimezone()
    return (
        f"{str(now.year)[-2:]}-{now.month:02d}-{now.day:02d} "
        f"{now.hour:02d}:{now.minute:02d}"
    )


def _split_items(values: list[str] | None, freeform: str | None = None) -> list[str]:
    items: list[str] = []
    for value in values or []:
        text = value.strip()
        if text:
            items.append(text)
    if freeform:
        text = freeform.strip()
        if text:
            items.append(text)
    # de-dupe preserving order
    seen: set[str] = set()
    out: list[str] = []
    for item in items:
        if item in seen:
            continue
        seen.add(item)
        out.append(item)
    return out


def append_reflection(
    *,
    ledger: dict[str, Any] | None,
    friction: list[str],
    rework: list[str],
    improvements: list[str],
    notes: list[str],
    trigger: str | None,
    outcome: str | None,
) -> dict[str, Any]:
    if not any([friction, rework, improvements, notes, outcome]):
        die(
            "reflect needs at least one of --friction, --rework, --improvement, "
            "--note, --outcome, or freeform text"
        )

    ts = _reflect_timestamp()
    ledger = ledger or {}
    title_bits = [
        str(ledger.get("id") or "untracked"),
        str(ledger.get("stage") or ""),
    ]
    if trigger:
        title_bits.append(trigger)
    title = " · ".join(b for b in title_bits if b)

    md_lines = [f"## {ts} — {title}", ""]
    meta = {
        "id": ledger.get("id"),
        "issue": ledger.get("issue"),
        "slug": ledger.get("slug"),
        "stage": ledger.get("stage"),
        "plan": ledger.get("plan"),
        "prUrl": ledger.get("prUrl"),
        "worktree": ledger.get("worktree"),
        "branch": ledger.get("branch"),
        "outcome": outcome,
        "trigger": trigger,
    }
    md_lines.append("| Field | Value |")
    md_lines.append("|---|---|")
    for key, label in [
        ("id", "id"),
        ("issue", "issue"),
        ("slug", "slug"),
        ("stage", "stage"),
        ("plan", "plan"),
        ("prUrl", "pr"),
        ("worktree", "worktree"),
        ("branch", "branch"),
        ("outcome", "outcome"),
        ("trigger", "trigger"),
    ]:
        val = meta.get(key)
        if val:
            md_lines.append(f"| {label} | {val} |")
    md_lines.append("")

    def section(name: str, items: list[str]) -> None:
        if not items:
            return
        md_lines.append(f"### {name}")
        md_lines.append("")
        for item in items:
            md_lines.append(f"- {item}")
        md_lines.append("")

    section("Friction", friction)
    section("Rework challenges", rework)
    section("Improvement opportunities", improvements)
    section("Notes", notes)

    entry_md = "\n".join(md_lines).rstrip() + "\n\n"
    record = {
        "ts": utc_now(),
        "localTs": ts,
        "trigger": trigger,
        "outcome": outcome,
        "friction": friction,
        "rework": rework,
        "improvements": improvements,
        "notes": notes,
        "delivery": {
            "id": ledger.get("id"),
            "issue": ledger.get("issue"),
            "slug": ledger.get("slug"),
            "stage": ledger.get("stage"),
            "plan": ledger.get("plan"),
            "prUrl": ledger.get("prUrl"),
            "worktree": ledger.get("worktree"),
            "branch": ledger.get("branch"),
            "goal": ledger.get("goal"),
        },
    }

    PI_HOME.mkdir(parents=True, exist_ok=True)
    if not REFLECTIONS_MD.exists():
        REFLECTIONS_MD.write_text(REFLECTIONS_HEADING, encoding="utf-8")
    with REFLECTIONS_MD.open("a", encoding="utf-8") as fh:
        fh.write(entry_md)
    with REFLECTIONS_JSONL.open("a", encoding="utf-8") as fh:
        fh.write(json.dumps(record, ensure_ascii=False) + "\n")

    return {
        "markdownPath": str(REFLECTIONS_MD),
        "jsonlPath": str(REFLECTIONS_JSONL),
        "timestamp": ts,
        "record": record,
    }


def cmd_reflect(args: argparse.Namespace) -> int:
    """Append an end-of-run reflection outside the worktree (~/.pi)."""
    ledger: dict[str, Any] | None = None
    path: Path | None = None
    root = Path(args.cwd).resolve() if args.cwd else detect_repo_root()
    candidate = find_ledger_path(root, args.ledger)
    if candidate.exists():
        path = candidate
        ledger = load_json(path)
        refresh_git_fields(ledger, root)
    elif not args.allow_untracked:
        die(
            f"no ledger at {candidate}; pass --allow-untracked to log without one, "
            "or run delivery bootstrap first"
        )

    if args.list:
        if not REFLECTIONS_MD.exists():
            print(f"no reflections yet at {REFLECTIONS_MD}")
            return 0
        text = REFLECTIONS_MD.read_text(encoding="utf-8")
        # print last N heading blocks roughly
        chunks = [c for c in text.split("\n## ") if c.strip()]
        # first chunk may be title
        entries = []
        for i, chunk in enumerate(chunks):
            if i == 0 and chunk.lstrip().startswith("# DELIVERY"):
                continue
            entries.append("## " + chunk if not chunk.startswith("## ") else chunk)
        tail = entries[-args.list :]
        print("\n".join(t.rstrip() for t in tail) if tail else "(no entries)")
        print(f"\nlog: {REFLECTIONS_MD}")
        return 0

    freeform = " ".join(args.text).strip() if args.text else ""
    # strip leading -- leftovers from REMAINDER usage
    if freeform.startswith("--"):
        freeform = ""

    friction = _split_items(args.friction)
    rework = _split_items(args.rework)
    improvements = _split_items(args.improvement)
    notes = _split_items(args.note)
    if freeform:
        notes = _split_items(notes, freeform)

    result = append_reflection(
        ledger=ledger,
        friction=friction,
        rework=rework,
        improvements=improvements,
        notes=notes,
        trigger=args.trigger,
        outcome=args.outcome,
    )

    if ledger is not None and path is not None:
        ledger.setdefault("reflections", []).append(
            {
                "at": utc_now(),
                "timestamp": result["timestamp"],
                "markdownPath": result["markdownPath"],
                "jsonlPath": result["jsonlPath"],
                "trigger": args.trigger,
                "outcome": args.outcome,
            }
        )
        # Keep only recent pointers in-worktree; full text lives in ~/.pi.
        if len(ledger["reflections"]) > 20:
            ledger["reflections"] = ledger["reflections"][-20:]
        ledger["lastReflectionAt"] = utc_now()
        append_history(
            ledger,
            "reflect",
            args.trigger or args.outcome or "reflection logged",
            path=result["markdownPath"],
        )
        if args.mark_done and ledger.get("stage") != "DONE":
            prev = ledger.get("stage")
            ledger["stage"] = "DONE"
            append_history(ledger, "stage", f"{prev} -> DONE")
        elif ledger.get("stage") not in {"DONE", "BLOCKED", "REFLECT"}:
            # Soft nudge into REFLECT without forcing DONE.
            if args.stage_reflect:
                prev = ledger.get("stage")
                ledger["stage"] = "REFLECT"
                append_history(ledger, "stage", f"{prev} -> REFLECT")
        maybe_herdr_label(ledger)
        write_json(path, ledger)

    if args.json:
        print(json.dumps(result, indent=2))
    else:
        print(f"reflected -> {result['markdownPath']}")
        print(f"jsonl     -> {result['jsonlPath']}")
        print(f"timestamp: {result['timestamp']}")
        if args.mark_done:
            print("stage: DONE")
    return 0


def render_agent_brief(ledger: dict[str, Any], path: Path) -> str:
    stage = str(ledger.get("stage") or "INTAKE")
    next_step = STAGE_NEXT_SKILL.get(stage, "delivery check -v")
    advisories = build_advisories(ledger)
    warn_lines = [
        f"- [{a.get('code')}] {a.get('message')}"
        for a in advisories
        if a.get("severity") == "warn"
    ]
    if not warn_lines:
        warn_lines = ["- none beyond next-step guidance"]

    issue = ledger.get("issue") or "(none yet — attach later with delivery set --issue KEY --retarget-id)"
    plan = ledger.get("plan") or "(none yet — set with delivery set --plan path)"
    slug = ledger.get("slug") or "(none)"
    pr = ledger.get("prUrl") or "(none)"
    doct = ledger.get("doctUrl") or "(none)"
    approval = ledger.get("implementationApproval") or {}
    approval_status = approval.get("status") or "pending"
    approval_profile = " / ".join(
        part for part in (approval.get("model"), approval.get("reasoningLevel")) if part
    ) or f"{IMPLEMENTATION_MODEL_REF} / {IMPLEMENTATION_REASONING} (fixed)"
    implementation_profile = ledger.get("implementationProfile") or {}
    implementation_agent_status = implementation_profile.get("status") or "pending"

    stage_rows = "\n".join(
        f"| `{s}` | {STAGE_NEXT_SKILL.get(s, '')} |" for s in STAGES
    )

    return f"""# Delivery agent brief

Generated: {utc_now()}  
Doctrine: **guidance, not gates** for advisory evidence. Readiness authorization, independent Sol-medium plan review, the pinned implementation handoff, and completeness evidence are explicit boundaries.

## This worktree

| Field | Value |
|---|---|
| id | {ledger.get('id')} |
| stage | {stage} |
| issue | {issue} |
| slug | {slug} |
| plan | {plan} |
| pr | {pr} |
| doct | {doct} |
| worktree | {ledger.get('worktree')} |
| branch | {ledger.get('branch')} |
| ledger | {path} |
| implementation approval | {approval_status} ({approval_profile}) |
| implementation agent | {implementation_agent_status} ({IMPLEMENTATION_MODEL_REF} / {IMPLEMENTATION_REASONING}) |

## Your job

Keep this worktree moving through:

```text
plan ↔ Sol-medium planner review → dedicated Sol-medium implementation → Terra autoreview → Grok completeness → PR
```

You are the planning/driving agent until operator approval. Use existing worker skills for real work.
The `delivery` CLI is the scoreboard + navigator, not the implementer. After approval it launches a dedicated Sol-medium implementation agent; the planning agent stops.

## Do this first

1. `delivery show`
2. `delivery check -v`
3. Follow the **Recommended next step** below by invoking the named skill/command.
4. After each meaningful step: `delivery stage <STAGE>`, `delivery record ...`, `delivery check -v`.
5. If a Linear issue appears later: `delivery set --issue KEY --retarget-id`.
6. Never stop solely because recommended evidence is pending/gap.

## Browser-review readiness trigger

While the stage is `PLAN_BROWSER_REVIEW`:

- An ordinary routed Doct comment (`submitAction: "agent"` with no
  `agentRoute.requestedSkill`) is browser feedback. Integrate and acknowledge it,
  then remain in `PLAN_BROWSER_REVIEW`.
- Do **not** start PM or technical readiness review because the first feedback was
  processed, the listener is quiet, or `planBrowserReview` is marked pass.
- Start the readiness cycle only after a direct operator instruction or Doct's
  explicit **Request execution-ready review** action. The current toolbar action
  emits `agentRoute.requestedSkill: "plan-reviewer-execution-ready"`.
- Record that signal before advancing: `delivery record planReadinessRequest
  --status pass --summary "Doct execution-ready review request"`, then move to
  `PLAN_PM_REVIEW`. `delivery stage PLAN_PM_REVIEW` and `PLAN_TECH_REVIEW`
  reject a missing request record. `EXECUTION_READY` additionally requires a
  current independent planner artifact from `openai-codex/gpt-5.6-sol` at medium
  with `VERDICT: PLAN_EXECUTION_READY`. These are authorization boundaries.

## Execution-ready approval pause

When the stage is `EXECUTION_READY`, do **not** invoke `run-plan`, change product code,
or move to `IMPLEMENTING`. Keep the Doct listener alive and give the operator a concise
summary of: (1) the current plan/review status, (2) the customer-visible and technical
changes implementation will make, (3) the fixed `openai-codex/gpt-5.6-sol` medium
implementation profile, and (4) the remaining phase/review/verification/PR steps. Ask whether to proceed.

Only after a direct operator approval in chat or a deliberate Doct implementation-approval
action may you record it:

```bash
delivery approve-implementation --source chat|doct \\
  --summary "Operator saw status, changes, fixed Sol-medium profile, and remaining steps"
```

The approval command splits an adjacent Herdr pane, starts Pi with explicit Sol-medium flags,
and prompts the new implementation agent. The planning agent stops. The new agent runs
`delivery verify-implementation-profile` and then `delivery stage IMPLEMENTING`; the stage
rejects missing/stale approval, launch evidence, plan review, or a mismatched live Pi runtime.
If launch failed, retry with `delivery start-implementation`. If a material Doct comment
arrives before implementation, update the plan, run
`delivery revoke-implementation-approval --reason "material plan feedback"`, and return to
`PLAN_BROWSER_REVIEW`; a fresh explicit execution-ready request is then required.

## Recommended next step

**{next_step}**

## Current advisories

{chr(10).join(warn_lines)}

## Navigation commands

```bash
delivery show
delivery check -v
delivery stages
delivery stage <STAGE> [--note "..."]
delivery approve-implementation --source chat|doct --summary "..."
delivery start-implementation                    # retry failed dedicated-agent launch
delivery verify-implementation-profile           # run in the new pinned agent
delivery revoke-implementation-approval --reason "material plan feedback"
delivery set --issue KEY --retarget-id          # Linear optional at start
delivery set --plan path/to/plan.html
delivery record <key> --status pass|skip|gap|na --artifact <path> --summary "..."
delivery note "what happened / why waiting"
delivery board                                  # all worktrees
delivery bootstrap --refresh                    # rewrite this brief
```

## Worker skills (authoritative)

| Need | Invoke |
|---|---|
| Create/review plan | {WORKER_SKILLS['plan']} |
| Plan PM / customer impact | {WORKER_SKILLS['plan_pm']} |
| Plan tech review | {WORKER_SKILLS['plan_tech']} |
| Implement through PR | {WORKER_SKILLS['implement']} |
| Implementation PM | {WORKER_SKILLS['impl_pm']} |
| Pre-PR review | {WORKER_SKILLS['autoreview']} |
| Open/update PR | {WORKER_SKILLS['pr']} |
| Customer-visible QA | {WORKER_SKILLS['qa']} |

## Stage map

| Stage | Recommended next |
|---|---|
{stage_rows}

## Soft quality inserts (recommended, never required)

- `delivery record planReadinessRequest --status pass --summary "Doct execution-ready review request"`
- `delivery record planTech --status pass --artifact thoughts/validation/<slug>-plan-review.md --reviewer planner --model openai-codex/gpt-5.6-sol --reasoning-level medium --verdict PLAN_EXECUTION_READY`
- `delivery record completionEval --status pass|gap --summary "..."`
- `delivery record customerImpact --status pass --summary "..." --promised "..." --observed "..."`
- `delivery record adversarialQa --status pass|na --summary "..."`

## End-of-run reflection (outside the worktree)

Before finishing (DONE/BLOCKED/hand-off), log process learning to `~/.pi` (not the git worktree):

```bash
delivery stage REFLECT
delivery reflect --trigger end-of-run --outcome done \\
  --friction "..." --rework "..." --improvement "..." \\
  --mark-done
```

Files:
- `~/.pi/DELIVERY_REFLECTIONS.md` (human)
- `~/.pi/delivery-reflections.jsonl` (machine-processable)

Skip only if there is truly nothing process-shaped to capture; prefer a short honest note over silence.

## Rules of the road

- Do **not** reimplement run-plan / reviewed-html-plan / autoreview inside ad-hoc prose.
- Do **not** hard-block the operator on advisory delivery evidence. Enforce the explicit readiness, Sol-medium plan-review, pinned implementation-runtime, and completeness boundaries.
- Do **not** require a Linear issue to start; attach it when it exists.
- Treat generic browser feedback as plan iteration, not an implied execution-ready review request.
- `execution-ready` requires the current independent Sol-medium planner verdict but is still not authorization to implement. Pause for explicit operator approval.
- Approval launches a dedicated Sol-medium implementation agent. The planning agent must not implement; the new agent verifies its profile before code work.
- If material feedback arrives after readiness but before implementation, invalidate approval and launch evidence, then return to browser review.
- Prefer keeping the ledger honest over perfect process compliance.
- If truly stuck on a human decision: `delivery blocker "..." --mark-blocked` and report the decision needed.
- End every delivery run with `delivery reflect` when possible.

## Resume contract

If you are a newly spawned agent in this worktree with no prior context:

1. Read this file: `.delivery/AGENT_BRIEF.md`
2. Run `delivery show` and `delivery check -v`
3. Continue from **Recommended next step**
4. Refresh the brief after material progress: `delivery bootstrap --refresh`
5. Before exit/DONE: `delivery reflect ...` then `delivery bootstrap --refresh`
"""


def cmd_bootstrap(args: argparse.Namespace) -> int:
    """Cold-start or refresh a worktree delivery run for a new agent."""
    root = Path(args.cwd).resolve() if args.cwd else detect_repo_root()
    path = root / LEDGER_REL
    created = False

    if path.exists() and not args.force:
        ledger = load_json(path)
    else:
        stage = args.stage or "INTAKE"
        if stage not in STAGES:
            die(f"unknown stage {stage!r}")
        ledger_id = args.id or default_id(root, args.issue, args.slug)
        ledger = new_ledger(
            root=root,
            ledger_id=ledger_id,
            issue=args.issue,
            plan=args.plan,
            stage=stage,
            doct_url=args.doct_url,
            pr_url=args.pr_url,
            slug=args.slug,
        )
        created = True

    if created:
        transition_problem = stage_transition_problem(ledger, root, str(ledger.get("stage")))
        if transition_problem:
            die(
                f"cannot initialize at {ledger.get('stage')}: {transition_problem}. "
                "Create the ledger at INTAKE and advance through delivery's guarded steps."
            )

    # Apply optional metadata updates on existing ledgers (and force-create already set them).
    if not created:
        if args.issue is not None:
            ledger["issue"] = args.issue.strip() or None
        if args.slug is not None:
            ledger["slug"] = args.slug.strip() or None
        if args.plan is not None:
            ledger["plan"] = args.plan.strip() or None
        if args.doct_url is not None:
            ledger["doctUrl"] = args.doct_url.strip() or None
        if args.pr_url is not None:
            ledger["prUrl"] = args.pr_url.strip() or None
        if args.stage and args.stage != ledger.get("stage"):
            if args.stage not in STAGES:
                die(f"unknown stage {args.stage!r}")
            transition_problem = stage_transition_problem(ledger, root, args.stage)
            if transition_problem:
                if args.stage == "IMPLEMENTING":
                    die(
                        "cannot enter IMPLEMENTING: "
                        f"{transition_problem}. Present the execution-ready summary, obtain a direct "
                        "operator approval, then run `delivery approve-implementation --source chat|doct "
                        "--summary \"...\"`."
                    )
                die(
                    f"cannot enter {args.stage}: {transition_problem}. "
                    "Continue processing ordinary feedback in PLAN_BROWSER_REVIEW."
                )
            prev = ledger.get("stage")
            ledger["stage"] = args.stage
            append_history(ledger, "stage", f"{prev} -> {args.stage}")
        if args.id:
            ledger["id"] = args.id.strip()
        if args.retarget_id:
            ledger["id"] = default_id(root, ledger.get("issue"), ledger.get("slug"))

    if args.goal:
        goal = args.goal.strip()
        ledger["goal"] = goal
        # Keep a note so history shows the operator ask.
        notes = ledger.setdefault("notes", [])
        if not any(goal in (n.get("text") or "") for n in notes[-5:]):
            notes.append({"at": utc_now(), "text": f"goal: {goal}", "stage": ledger.get("stage")})

    refresh_git_fields(ledger, root)
    brief = render_agent_brief(ledger, path)
    brief_path = path.parent / "AGENT_BRIEF.md"
    path.parent.mkdir(parents=True, exist_ok=True)
    brief_path.write_text(brief + "\n", encoding="utf-8")
    ledger["agentBrief"] = str(brief_path)
    ledger["advisories"] = build_advisories(ledger)
    append_history(
        ledger,
        "bootstrap",
        "created" if created else "refreshed",
        brief=str(brief_path),
    )
    maybe_herdr_label(ledger)
    write_json(path, ledger)

    if args.json:
        print(
            json.dumps(
                {
                    "created": created,
                    "ledger": str(path),
                    "brief": str(brief_path),
                    "id": ledger.get("id"),
                    "stage": ledger.get("stage"),
                    "issue": ledger.get("issue"),
                    "plan": ledger.get("plan"),
                    "next": STAGE_NEXT_SKILL.get(str(ledger.get("stage")), None),
                    "goal": ledger.get("goal"),
                },
                indent=2,
            )
        )
    else:
        action = "created" if created else "refreshed"
        print(f"delivery bootstrap {action}")
        print(f"ledger: {path}")
        print(f"brief:  {brief_path}")
        print(f"stage:  {ledger.get('stage')}")
        print(f"next:   {STAGE_NEXT_SKILL.get(str(ledger.get('stage')), 'n/a')}")
        print("")
        print(brief)
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="delivery",
        description=(
            "Per-worktree delivery stage ledger. Guidance, not gates: "
            "checks advise and never hard-block continuation."
        ),
    )
    parser.add_argument("--cwd", help="Worktree/repo root override")
    parser.add_argument("--ledger", help="Explicit ledger file or directory")
    parser.add_argument("--json", action="store_true", help="JSON output where supported")

    sub = parser.add_subparsers(dest="command", required=True)

    def add_json_flag(p: argparse.ArgumentParser) -> None:
        p.add_argument(
            "--json",
            action="store_true",
            default=argparse.SUPPRESS,
            help="JSON output",
        )

    p_init = sub.add_parser("init", help="Create a delivery ledger in the current worktree")
    add_json_flag(p_init)
    p_init.add_argument("--id", help="Ledger id (default repo/issue-or-branch)")
    p_init.add_argument("--issue", help="Issue key, e.g. NOD-1234")
    p_init.add_argument("--slug", help="Slug used when issue is absent")
    p_init.add_argument("--plan", help="Plan path")
    p_init.add_argument("--doct-url", help="Doct plan URL")
    p_init.add_argument("--pr-url", help="PR URL")
    p_init.add_argument("--stage", default="INTAKE", help="Initial stage")
    p_init.add_argument("--force", action="store_true", help="Overwrite existing ledger")
    p_init.set_defaults(func=cmd_init)

    p_path = sub.add_parser("path", help="Print ledger path for cwd")
    p_path.add_argument("--allow-missing", action="store_true")
    p_path.set_defaults(func=cmd_path)

    p_show = sub.add_parser("show", help="Show current ledger")
    add_json_flag(p_show)
    p_show.set_defaults(func=cmd_show)

    p_stage = sub.add_parser("stage", help="Set stage (IMPLEMENTING requires current operator approval)")
    p_stage.add_argument("stage", help="Target stage")
    p_stage.add_argument("--note", help="Optional note with the transition")
    p_stage.set_defaults(func=cmd_stage)

    p_approve = sub.add_parser(
        "approve-implementation",
        help="Record explicit operator approval for the current execution-ready plan revision",
    )
    p_approve.add_argument("--source", required=True, choices=("chat", "doct"))
    p_approve.add_argument(
        "--summary",
        required=True,
        help="Record that the operator received status, change, model, and remaining-step summary",
    )
    p_approve.add_argument("--model", help=f"Must be {IMPLEMENTATION_MODEL_REF} when supplied")
    p_approve.add_argument(
        "--reasoning-level",
        help=f"Must be {IMPLEMENTATION_REASONING} when supplied",
    )
    p_approve.add_argument("--pane", help="Planning agent's Herdr pane id")
    p_approve.add_argument("--agent-name", help="Override the generated implementation agent name")
    p_approve.add_argument("--timeout-ms", type=int, default=60000, help="Implementation Pi startup timeout")
    p_approve.set_defaults(func=cmd_approve_implementation)

    p_start_impl = sub.add_parser(
        "start-implementation",
        help="Retry launch of the approved fixed Sol medium implementation agent",
    )
    p_start_impl.add_argument("--pane", help="Planning agent's Herdr pane id")
    p_start_impl.add_argument("--agent-name", help="Override the generated implementation agent name")
    p_start_impl.add_argument("--timeout-ms", type=int, default=60000, help="Implementation Pi startup timeout")
    p_start_impl.set_defaults(func=cmd_start_implementation)

    p_verify_impl = sub.add_parser(
        "verify-implementation-profile",
        help="Verify this Pi runtime is the approved fixed Sol medium implementation agent",
    )
    p_verify_impl.set_defaults(func=cmd_verify_implementation_profile)

    p_revoke_approve = sub.add_parser(
        "revoke-implementation-approval",
        help="Invalidate a pending approval after material plan feedback",
    )
    p_revoke_approve.add_argument("--reason", required=True)
    p_revoke_approve.set_defaults(func=cmd_revoke_implementation_approval)

    p_note = sub.add_parser("note", help="Append a freeform note")
    p_note.add_argument("text", nargs=argparse.REMAINDER)
    p_note.set_defaults(func=cmd_note)

    p_set = sub.add_parser(
        "set",
        help="Attach/update issue, plan, links after start (Linear optional at init)",
    )
    p_set.add_argument(
        "--issue",
        help="Linear/issue key to attach now (omit at init is fine; set later)",
    )
    p_set.add_argument(
        "--clear-issue",
        action="store_true",
        help="Remove the issue key from the ledger",
    )
    p_set.add_argument("--plan", help="Plan path")
    p_set.add_argument("--doct-url", help="Doct plan URL")
    p_set.add_argument("--pr-url", help="PR URL")
    p_set.add_argument("--slug", help="Slug label when no issue yet")
    p_set.add_argument("--id", help="Explicit ledger id override")
    p_set.add_argument(
        "--retarget-id",
        action="store_true",
        help="Rebuild id from repo + issue/slug/branch after attaching an issue",
    )
    p_set.set_defaults(func=cmd_set)

    p_rec = sub.add_parser("record", help="Record recommended evidence (never required)")
    p_rec.add_argument("key", help="Evidence key")
    p_rec.add_argument(
        "--status",
        required=True,
        choices=list(EVIDENCE_STATUSES),
        help="pass|skip|gap|na|pending",
    )
    p_rec.add_argument("--artifact", help="Artifact path")
    p_rec.add_argument("--summary", help="Short summary")
    p_rec.add_argument("--reviewer", help="Reviewer identity for structured review evidence")
    p_rec.add_argument("--model", help="Model reference for structured review evidence")
    p_rec.add_argument("--reasoning-level", help="Reasoning level for structured review evidence")
    p_rec.add_argument("--verdict", help="Verdict token for structured review evidence")
    p_rec.add_argument("--gap", action="append", default=[], help="Gap string (repeatable)")
    p_rec.add_argument("--promised", action="append", default=[], help="customerImpact promised item")
    p_rec.add_argument("--observed", action="append", default=[], help="customerImpact observed item")
    p_rec.add_argument("--plan", help="Update plan path")
    p_rec.add_argument("--pr-url", help="Update PR URL")
    p_rec.add_argument("--doct-url", help="Update Doct URL")
    p_rec.set_defaults(func=cmd_record)

    p_completion = sub.add_parser(
        "completion-review",
        help="Launch or rerequest the adjacent visible Grok 4.5 plan-completeness reviewer",
    )
    add_json_flag(p_completion)
    p_completion.add_argument("--pane", help="Driving agent's Herdr pane id (defaults to HERDR_PANE_ID or delivery spawn pane)")
    p_completion.add_argument("--agent-name", help="Override the generated completeness reviewer name")
    p_completion.add_argument("--rerun", action="store_true", help="Prompt the existing reviewer after the driving agent addresses findings")
    p_completion.add_argument("--accept", action="store_true", help="Capture the latest visible COMPLETE verdict and record it")
    p_completion.add_argument("--waive", action="store_true", help="Record a direct operator waiver instead of a clean completeness verdict")
    p_completion.add_argument("--summary", help="Required with --waive; records the direct operator waiver")
    p_completion.add_argument("--artifact", help="Artifact path for --accept (default thoughts/validation/<slug>-completeness.md)")
    p_completion.add_argument("--dry-run", action="store_true", help="Print the split/start/prompt contract without changing Herdr")
    p_completion.add_argument("--timeout-ms", type=int, default=60000, help="Reviewer Pi startup timeout (default 60000)")
    p_completion.set_defaults(func=cmd_completion_review)

    p_block = sub.add_parser("blocker", help="Add or clear blocker notes")
    p_block.add_argument("text", nargs=argparse.REMAINDER)
    p_block.add_argument("--clear", action="store_true")
    p_block.add_argument("--mark-blocked", action="store_true", help="Also set stage=BLOCKED")
    p_block.add_argument("--stage", help="Stage to restore when clearing")
    p_block.set_defaults(func=cmd_blocker)

    p_check = sub.add_parser(
        "check",
        help="Soft checklist for current stage (always exit 0; advisories only)",
    )
    add_json_flag(p_check)
    p_check.add_argument("-v", "--verbose", action="store_true")
    p_check.set_defaults(func=cmd_check)

    p_board = sub.add_parser("board", help="List known delivery ledgers")
    add_json_flag(p_board)
    p_board.add_argument(
        "--root",
        action="append",
        default=[],
        help="Extra root to scan for .delivery/ledger.json (repeatable)",
    )
    p_board.set_defaults(func=cmd_board)

    p_status = sub.add_parser("status", help="Show current ledger, or board with --all")
    add_json_flag(p_status)
    p_status.add_argument("--all", action="store_true")
    p_status.set_defaults(func=cmd_status)

    p_stages = sub.add_parser("stages", help="List stages and recommended next skills")
    p_stages.set_defaults(func=cmd_stages)

    p_reflect = sub.add_parser(
        "reflect",
        help="Log end-of-run friction/rework/improvements to ~/.pi (outside worktree)",
    )
    add_json_flag(p_reflect)
    p_reflect.add_argument(
        "text",
        nargs=argparse.REMAINDER,
        help="Optional freeform reflection text",
    )
    p_reflect.add_argument(
        "--friction",
        action="append",
        default=[],
        help="Observed process friction (repeatable)",
    )
    p_reflect.add_argument(
        "--rework",
        action="append",
        default=[],
        help="Rework challenge (repeatable)",
    )
    p_reflect.add_argument(
        "--improvement",
        action="append",
        default=[],
        help="Improvement opportunity (repeatable)",
    )
    p_reflect.add_argument(
        "--note",
        action="append",
        default=[],
        help="Additional note (repeatable)",
    )
    p_reflect.add_argument("--outcome", help="Short outcome label, e.g. pr-opened / blocked / done")
    p_reflect.add_argument("--trigger", help="Short trigger label, e.g. end-of-run")
    p_reflect.add_argument(
        "--list",
        nargs="?",
        const=5,
        type=int,
        metavar="N",
        help="Show last N reflections instead of writing (default 5)",
    )
    p_reflect.add_argument(
        "--allow-untracked",
        action="store_true",
        help="Allow reflection when no worktree ledger exists",
    )
    p_reflect.add_argument(
        "--mark-done",
        action="store_true",
        help="After logging, set ledger stage to DONE",
    )
    p_reflect.add_argument(
        "--stage-reflect",
        action="store_true",
        help="Set ledger stage to REFLECT after logging (if not already DONE/BLOCKED)",
    )
    p_reflect.set_defaults(func=cmd_reflect)

    p_spawn = sub.add_parser(
        "spawn",
        help="Create a Herdr worktree named from a goal and bootstrap delivery there",
    )
    add_json_flag(p_spawn)
    p_spawn.add_argument(
        "goal",
        nargs=argparse.REMAINDER,
        help="What you are after, used to name branch/label and seed the agent brief",
    )
    p_spawn.add_argument(
        "--cwd",
        default=argparse.SUPPRESS,
        help="Source repo root (default: current git root)",
    )
    p_spawn.add_argument("--issue", help="Optional Linear issue key to attach now")
    p_spawn.add_argument("--slug", help="Override slug derived from the goal")
    p_spawn.add_argument("--branch", help="Override git branch name")
    p_spawn.add_argument("--label", help="Override Herdr workspace/tab label")
    p_spawn.add_argument("--base", default="origin/main", help="Base ref (default origin/main)")
    p_spawn.add_argument("--path", help="Optional explicit worktree path")
    p_spawn.add_argument("--plan", help="Optional plan path to record")
    p_spawn.add_argument("--stage", default="INTAKE", help="Initial delivery stage")
    p_spawn.add_argument(
        "--agent",
        default="pi",
        help="Agent kind to start in the new pane (default: pi)",
    )
    p_spawn.add_argument(
        "--agent-name",
        help="Herdr agent name (default: unique delivery workspace token)",
    )
    p_spawn.add_argument(
        "--no-agent",
        action="store_true",
        help="Only create worktree + bootstrap; do not start an agent",
    )
    p_spawn.add_argument(
        "--agent-timeout-ms",
        type=int,
        default=60000,
        help="herdr agent start timeout (default 60000)",
    )
    p_spawn.add_argument(
        "--wait-agent",
        action="store_true",
        help="Wait for the initial agent prompt to settle (default: fire-and-return)",
    )
    p_spawn.add_argument(
        "--wait-timeout-ms",
        type=int,
        default=120000,
        help="Wait timeout when --wait-agent is set",
    )
    p_spawn.add_argument(
        "--focus",
        action="store_true",
        help="Focus the new Herdr workspace (default: no-focus)",
    )
    p_spawn.add_argument(
        "--quiet",
        action="store_true",
        help="Suppress bootstrap brief stdout (still writes AGENT_BRIEF.md)",
    )
    p_spawn.add_argument(
        "--dry-run",
        action="store_true",
        help="Print naming/plan only; do not create a worktree",
    )
    p_spawn.set_defaults(func=cmd_spawn)

    p_boot = sub.add_parser(
        "bootstrap",
        help="Cold-start or refresh a worktree for a new agent (writes AGENT_BRIEF.md)",
    )
    add_json_flag(p_boot)
    p_boot.add_argument("--issue", help="Linear/issue key if known")
    p_boot.add_argument("--slug", help="Feature slug when no issue yet")
    p_boot.add_argument("--plan", help="Plan path if known")
    p_boot.add_argument("--doct-url", help="Doct plan URL")
    p_boot.add_argument("--pr-url", help="PR URL")
    p_boot.add_argument("--goal", help="Short operator goal/ask for this worktree")
    p_boot.add_argument("--stage", help="Stage to set (default INTAKE on create)")
    p_boot.add_argument("--id", help="Explicit ledger id")
    p_boot.add_argument(
        "--retarget-id",
        action="store_true",
        help="Rebuild id from repo + issue/slug",
    )
    p_boot.add_argument(
        "--refresh",
        action="store_true",
        help="Rewrite AGENT_BRIEF.md for an existing ledger without recreating it",
    )
    p_boot.add_argument(
        "--force",
        action="store_true",
        help="Recreate ledger from scratch (destructive to prior evidence)",
    )
    p_boot.set_defaults(func=cmd_bootstrap)

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    # Parent and subcommand may both declare --json; default False when absent.
    if not hasattr(args, "json"):
        args.json = False
    return int(args.func(args))


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)
