            "xhigh": "max"
          },
          "compat": {
            "supportsReasoningEffort": true
          }
        }
      }
    },
    "opencode-zen": {
      "modelOverrides": {
        "glm-5.2": {
          "reasoning": true,
          "thinkingLevelMap": {
            "off": "none",
            "minimal": null,
